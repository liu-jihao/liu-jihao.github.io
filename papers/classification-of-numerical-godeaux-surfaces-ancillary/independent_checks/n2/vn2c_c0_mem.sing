poly E; matrix C; intvec ev;

E = B[6, 6] - (x(25)*w^8 + x(26)*w^6*y1 + x(27)*w^4*y3^2 + x(28)*w^4*y2*y3 + x(29)*w^4*y2^2 + x(30)*w^4*y1^2 + x(31)*w^2*y1*y3^2 + x(32)*w^2*y1*y2*y3 + x(33)*w^2*y1*y2^2 + x(34)*w^2*y1^3 + x(35)*y3^4 + x(36)*y2*y3^3 + x(37)*y2^2*y3^2 + x(38)*y1^2*y3^2 + x(39)*y2^3*y3 + x(40)*y1^2*y2*y3 + x(41)*y2^4 + x(42)*y1^2*y2^2 + x(43)*y1^4)*B[1, 1] - (x(19)*w^5 + x(20)*w^3*y1 + x(21)*w*y3^2 + x(22)*w*y2*y3 + x(23)*w*y2^2 + x(24)*w*y1^2)*B[1, 2] - (x(13)*w^5 + x(14)*w^3*y1 + x(15)*w*y3^2 + x(16)*w*y2*y3 + x(17)*w*y2^2 + x(18)*w*y1^2)*B[1, 3] - (x(9)*w^3*y3 + x(10)*w^3*y2 + x(11)*w*y1*y3 + x(12)*w*y1*y2)*B[1, 4] - (x(5)*w^3*y3 + x(6)*w^3*y2 + x(7)*w*y1*y3 + x(8)*w*y1*y2)*B[1, 5] - (x(1)*w^2*y3 + x(2)*w^2*y2 + x(3)*y1*y3 + x(4)*y1*y2)*B[1, 6];
if (E != 0) {
  C = coef(E, w*y1*y2*y3);
  for (t = 1; t <= ncols(C); t++) {
    neq++; EQ[neq] = C[2, t]; ev = leadexp(C[1, t]); ORD[neq] = ev[nv];
    if (ev[nv] + 2*(ev[nv-1] + ev[nv-2] + ev[nv-3]) != 16) { badslot++; }
    if (((ev[nv] + ev[nv-2] + ev[nv-3]) mod 2) != 1) { badslot++; }
  }
}
