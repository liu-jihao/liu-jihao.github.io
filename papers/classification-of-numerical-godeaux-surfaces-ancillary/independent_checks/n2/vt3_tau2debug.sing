// debug of the tau2 check (generated from vn2b_c1.sing)
// vn2b_c1.sing -- independent verification of case n2, c = 1 (generated by vgen2.py)
ring RS = 0, (g10,g9,g8,g7,g6,g5,g4,g3,g2,g1,b12,b11,b10,b9,b8,b7,b6,b5,b4,b3,b2,b1,y3,y2,y1,w), dp;

proc cofac(matrix M, int i, int j)
{
  int n = nrows(M);
  matrix S[n-1][n-1];
  int r, s, rr, ss;
  rr = 0;
  for (r = 1; r <= n; r++) {
    if (r != i) {
      rr++; ss = 0;
      for (s = 1; s <= n; s++) {
        if (s != j) { ss++; S[rr, ss] = M[r, s]; }
      }
    }
  }
  int sg = 1;
  if (((i + j) mod 2) == 1) { sg = -1; }
  return(sg * det(S));
}
proc iszero(matrix M)
{
  return(size(ideal(M)) == 0);
}


poly y0 = w^2;
poly Q = y2*y3 - y1^2;
poly G = g1*y3^3 + g2*y1^2*y3 + g3*y2*y3^2 + g4*y1^2*y2 + g5*y2^2*y3 + g6*y2^3 + g7*y0*y1*y3 + g8*y0*y1*y2 + g9*y0^2*y3 + g10*y0^2*y2;
poly q1 = 0;
poly q2 = b1*y0*y2 + b2*y0*y3 + b3*y1*y2 + b4*y1*y3;
poly q3 = b5*y0^2 + b6*y0*y1 + b7*y1^2 + b8*y2^2 + b9*y2*y3 + b10*y3^2;
poly q4 = b11*y0^2 + b12*y3^2;
int cc = 1;
matrix A[6][6] =
  y0*G, w*q1, w*q2, w*q3, w*q4, Q,
  w*q1, y2,   0,    y1,   0,    w,
  w*q2, 0,    y3,   cc*y0, y1,  0,
  w*q3, y1,   cc*y0, y3,  0,    0,
  w*q4, 0,    y1,   0,    y2,   0,
  Q,    w,    0,    0,    0,    0;


// torus tau2 acts on the normal form (exact, parameter t)
ring RT = (0, t), (g10,g9,g8,g7,g6,g5,g4,g3,g2,g1,b12,b11,b10,b9,b8,b7,b6,b5,b4,b3,b2,b1,y3,y2,y1,w), dp;
matrix A = imap(RS, A);
ideal ph = maxideal(1); ph[25] = t*y1; ph[24] = t^2*y2;
map PHI2 = RT, ph;
matrix Aph = PHI2(A);
matrix PP[6][6]; PP[1,1] = 1/t^3; PP[2,2] = 1/t; PP[3,3] = 1; PP[4,4] = 1; PP[5,5] = 1/t; PP[6,6] = t;
ideal sc = maxideal(1);

sc[1] = g10/t^4;
sc[2] = g9/t^6;
sc[3] = g8/t^3;
sc[4] = g7/t^5;
sc[5] = t^0*g6;
sc[6] = g5/t^2;
sc[7] = g4/t^2;
sc[8] = g3/t^4;
sc[9] = g2/t^4;
sc[10] = g1/t^6;
sc[11] = b12/t^4;
sc[12] = b11/t^4;
sc[13] = b10/t^3;
sc[14] = b9/t^1;
sc[15] = t^1*b8;
sc[16] = b7/t^1;
sc[17] = b6/t^2;
sc[18] = b5/t^3;
sc[19] = b4/t^2;
sc[20] = t^0*b3;
sc[21] = b2/t^3;
sc[22] = b1/t^1;
map SC = RT, sc;
matrix Asc = SC(A);
matrix DD = PP*Aph*PP - Asc;
print(DD);
"CHECK tau2: " + string(iszero(DD));
quit;
