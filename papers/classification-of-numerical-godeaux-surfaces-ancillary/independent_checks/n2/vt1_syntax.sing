// syntax test only (no mathematics)
ring r = 0, (x(1..3), g2, g1, y3, w), dp;
int i = 3; int j = 4;
print((i+j) mod 2);
print((i+j) % 2);
matrix M[2][2] = x(1), w, w, g1;
matrix N = M - transpose(M);
print(size(ideal(N)));
intvec ORD = 0:5; ORD[7] = 3; print(ORD);
ideal EQ; EQ[3] = x(2); print(EQ); print(ncols(EQ));
poly f = 0; ideal vh = variables(f); print(vh); print(ncols(vh)); print(size(vh));
poly e = x(1)*w^2*y3 + g1*w*y3^2;
matrix C = coef(e, w*y3);
intvec ev = leadexp(C[1,1]); print(ev);
print(nvars(r));
ring s = 0, (g2, g1, y3, w), dp;
matrix A[2][2] = g1, w, w, y3;
setring r;
matrix A = imap(s, A); print(A);
list L = 1, x(2); print(L[2]);
string nm = varstr(5); print(nm);
quit;
