// v6_param.sing -- reductions with symbolic parameters, exact over Q(r, a, b, e, s, c1, c2, D):
//   column reductions for N2 (torus, swap) and N3 (shear + scaling), N1(D) -> N1(1) (two versions),
//   the scaling s (c -> s^2 c); all applied to the GENERAL matrix of case_common.md 1.
< "vlib.sing";
ring RR = (0, r, a, b, e, s, cc1, cc2, D), (w, y1, y2, y3, lam, g(1..10), f(1..20), m(1..4)), dp;
poly y0 = w^2;
poly G = g(1)*y3^3 + g(2)*y1^2*y3 + g(3)*y2*y3^2 + g(4)*y1^2*y2 + g(5)*y2^2*y3 + g(6)*y2^3
       + g(7)*y0*y1*y3 + g(8)*y0*y1*y2 + g(9)*y0^2*y3 + g(10)*y0^2*y2;
poly q1 = f(1)*y0*y2 + f(2)*y0*y3 + f(3)*y1*y2 + f(4)*y1*y3;
poly q2 = f(5)*y0*y2 + f(6)*y0*y3 + f(7)*y1*y2 + f(8)*y1*y3;
poly q3 = f(9)*y0^2 + f(10)*y0*y1 + f(11)*y1^2 + f(12)*y2^2 + f(13)*y2*y3 + f(14)*y3^2;
poly q4 = f(15)*y0^2 + f(16)*y0*y1 + f(17)*y1^2 + f(18)*y2^2 + f(19)*y2*y3 + f(20)*y3^2;
intvec cdeg = 0, 3, 3, 3, 3, 4;
intvec dl = 1, -1, -1, 1, 1, -1;

proc fullA(matrix D1, matrix D2, poly Q2, poly cc1x, poly cc2x, matrix Mp)
{
  matrix A[6][6]; int j; int k;
  matrix I2 = vid(2); matrix Off[2][2];
  for (j = 1; j <= 2; j++) { for (k = 1; k <= 2; k++) { Off[j, k] = y1*I2[j, k] + y0*Mp[j, k]; } }
  matrix ab = vblk(D1, Off, transpose(Off), D2);
  for (j = 1; j <= 4; j++) { for (k = 1; k <= 4; k++) { A[j+1, k+1] = ab[j, k]; } }
  A[1, 1] = y0*G;
  A[1, 2] = w*q1; A[1, 3] = w*q2; A[1, 4] = w*q3; A[1, 5] = w*q4;
  A[2, 1] = w*q1; A[3, 1] = w*q2; A[4, 1] = w*q3; A[5, 1] = w*q4;
  A[1, 6] = Q2 - y1^2; A[6, 1] = Q2 - y1^2;
  A[2, 6] = cc1x*w; A[6, 2] = cc1x*w; A[3, 6] = cc2x*w; A[6, 3] = cc2x*w;
  return(A);
}
proc sigok(matrix A)
{
  int j; int k; poly sf;
  for (j = 1; j <= 6; j++) { for (k = 1; k <= 6; k++) {
    sf = subst(subst(subst(A[j, k], w, -w), y2, -y2), y3, -y3);
    if (sf != -dl[j]*dl[k]*A[j, k]) { return(0); } } }
  return(1);
}
proc wtok(matrix A)
{
  int j; int k; poly sf; int d;
  for (j = 1; j <= 6; j++) { for (k = 1; k <= 6; k++) {
    sf = subst(subst(subst(subst(A[j, k], w, lam*w), y1, lam^2*y1), y2, lam^2*y2), y3, lam^2*y3);
    d = 8 - cdeg[j] - cdeg[k];
    if (sf != lam^d * A[j, k]) { return(0); } } }
  return(1);
}
proc shapeok2(matrix B, matrix D1t, matrix D2t, poly Q2t, poly t1, poly t2)
{
  int ok = 1; int j; int k;
  if (!viszero(vsubm(B, transpose(B)))) { "  not symmetric"; ok = 0; }
  if (B[1, 6] != Q2t - y1^2) { "  A_05 wrong"; ok = 0; }
  if (B[2, 6] != t1*w) { "  A_15 wrong"; ok = 0; }
  if (B[3, 6] != t2*w) { "  A_25 wrong"; ok = 0; }
  for (j = 4; j <= 6; j++) { if (B[j, 6] != 0) { "  A_j5 != 0"; ok = 0; } }
  ideal Gw2 = std(ideal(w^2)); ideal Gw = std(ideal(w));
  if (reduce(B[1, 1], Gw2) != 0) { "  A_00 not in (y0)"; ok = 0; }
  for (k = 2; k <= 5; k++) { if (reduce(B[1, k], Gw) != 0) { "  A_0k not in (w)"; ok = 0; } }
  matrix I2 = vid(2);
  matrix nt = vblk(D1t, vsc(y1, I2), vsc(y1, I2), D2t);
  poly rest;
  for (j = 1; j <= 4; j++) { for (k = 1; k <= 4; k++) {
    if (subst(B[j+1, k+1], w, 0) != nt[j, k]) { "  net part wrong"; ok = 0; }
    rest = B[j+1, k+1] - nt[j, k];
    if (rest != 0) {
      rest = rest / w^2;
      if (rest*w^2 != B[j+1, k+1] - nt[j, k]) { "  y0-part not divisible"; ok = 0; }
      if (diff(rest, w) != 0 || diff(rest, y1) != 0 || diff(rest, y2) != 0 || diff(rest, y3) != 0) { "  y0-part not constant"; ok = 0; }
      if ((j <= 2 && k <= 2) || (j >= 3 && k >= 3)) { "  y0-part in a diagonal block"; ok = 0; }
    }
  } }
  if (!sigok(B)) { "  not sigma-equivariant"; ok = 0; }
  if (!wtok(B)) { "  weights wrong"; ok = 0; }
  return(ok);
}
proc transf(matrix A, ideal img, matrix P)
{
  map ph = basering, img;
  matrix Ap = ph(A);
  return(transpose(P) * Ap * P);
}
proc dmat6(poly g0, matrix gI, matrix gII, poly g5)
{
  matrix P[6][6]; int j; int k;
  P[1, 1] = g0; P[6, 6] = g5;
  for (j = 1; j <= 2; j++) { for (k = 1; k <= 2; k++) { P[j+1, k+1] = gI[j, k]; P[j+3, k+3] = gII[j, k]; } }
  return(P);
}

matrix Mg[2][2] = m(1), m(2), m(3), m(4);
matrix N2a[2][2] = y2, 0, 0, y3;    matrix N2b[2][2] = y3, 0, 0, y2;    poly N2q = y2*y3;
matrix N3a[2][2] = y3, y2, y2, 0;   matrix N3b[2][2] = 0, y2, y2, -y3;  poly N3q = y2^2;
matrix N11a[2][2] = y3, y2, y2, y3; matrix N11b[2][2] = -y3, y2, y2, -y3; poly N11q = y2^2 - y3^2;
matrix N1Da[2][2] = D*y3, y2, y2, y3; matrix N1Db[2][2] = -y3, y2, y2, -D*y3; poly N1Dq = y2^2 - D*y3^2;
matrix N1ra[2][2] = r^4*y3, y2, y2, y3; matrix N1rb[2][2] = -y3, y2, y2, -r^4*y3; poly N1rq = y2^2 - r^4*y3^2;
ideal idm = maxideal(1);

"==== N2, column (c1, c2) with c1 c2 != 0 -> N2, column (1, 1) (torus, a = 1/c1, b = 1/c2) ====";
matrix A = fullA(N2a, N2b, N2q, cc1, cc2, Mg);
ideal im = idm; im[2] = y1*cc1*cc2; im[3] = y2*cc1^2; im[4] = y3*cc2^2;     // y1/(ab), y2/a^2, y3/b^2
matrix gI[2][2] = 1/cc1, 0, 0, 1/cc2;  matrix gII[2][2] = 1/cc2, 0, 0, 1/cc1;
matrix B = transf(A, im, dmat6(1/(cc1*cc2)^2, gI, gII, 1));
"general shape with net N2 and column (1, 1):"; shapeok2(B, N2a, N2b, N2q, 1, 1);

"==== N2, column (0, 1) -> N2, column (1, 0) (swap with y2 <-> y3) ====";
A = fullA(N2a, N2b, N2q, 0, 1, Mg);
im = idm; im[3] = y3; im[4] = y2;
matrix sw[2][2] = 0, 1, 1, 0;
B = transf(A, im, dmat6(1, sw, sw, 1));
"general shape with net N2 and column (1, 0):"; shapeok2(B, N2a, N2b, N2q, 1, 0);

"==== N3, column (c1, c2) with c2 != 0 -> N3, column (0, 1) (shear e = 2 c1/c2, g0 = c2, g5 = 1/c2) ====";
A = fullA(N3a, N3b, N3q, cc1, cc2, Mg);
poly ee = 2*cc1/cc2;
im = idm; im[4] = y3 + ee*y2;
gI = 1, 0, -ee/2, 1;  gII = 1, ee/2, 0, 1;
B = transf(A, im, dmat6(cc2, gI, gII, 1/cc2));
"general shape with net N3 and column (0, 1):"; shapeok2(B, N3a, N3b, N3q, 0, 1);

"==== N1(D) -> N1(1), D = r^4 (version 1: w -> r w, y3 -> y3/r^2, g_I = diag(1/r, r), g_II = diag(r, 1/r), g0 = g5 = 1) ====";
A = fullA(N1ra, N1rb, N1rq, 1, 0, Mg);
im = idm; im[1] = r*w; im[4] = y3/r^2;
gI = 1/r, 0, 0, r;  gII = r, 0, 0, 1/r;
B = transf(A, im, dmat6(1, gI, gII, 1));
"general shape with net N1(1) and column (1, 0):"; shapeok2(B, N11a, N11b, N11q, 1, 0);
matrix Mc[2][2] = 0, 0, m(3), 0;
A = fullA(N1ra, N1rb, N1rq, 1, 0, Mc);
B = transf(A, im, dmat6(1, gI, gII, 1));
matrix Mex[2][2] = 0, 0, r^4*m(3), 0;
matrix Ex = fullA(N11a, N11b, N11q, 1, 0, Mex);
int j; int k; int ok = 1;
for (j = 2; j <= 6; j++) { for (k = 2; k <= 6; k++) { if (B[j, k] != Ex[j, k]) { ok = 0; } } }
"M' = c E_23 goes to (D c) E_23 (rows/columns v1..v5 equal):"; ok;

"==== N1(D) -> N1(D/u^2), u = r^2 (PLAN's torus: w -> w/r, y3 -> y3/r^2, P = diag(1/u, u^-1/2, u^1/2, u^1/2, u^-1/2, u)) ====";
A = fullA(N1Da, N1Db, N1Dq, 1, 0, Mc);
im = idm; im[1] = w/r; im[4] = y3/r^2;
gI = 1/r, 0, 0, r;  gII = r, 0, 0, 1/r;
B = transf(A, im, dmat6(1/r^2, gI, gII, r^2));
matrix N1ua[2][2] = D/r^4*y3, y2, y2, y3; matrix N1ub[2][2] = -y3, y2, y2, -D/r^4*y3; poly N1uq = y2^2 - D/r^4*y3^2;
"general shape with net N1(D/u^2), column (1, 0):"; shapeok2(B, N1ua, N1ub, N1uq, 1, 0);
Ex = fullA(N1ua, N1ub, N1uq, 1, 0, Mc);
ok = 1;
for (j = 2; j <= 6; j++) { for (k = 2; k <= 6; k++) { if (B[j, k] != Ex[j, k]) { ok = 0; } } }
"c unchanged (rows/columns v1..v5 equal those of N1(D/u^2) with the same c):"; ok;

"==== scaling s: w -> s w, P = diag(s, 1, 1, 1, 1, 1/s): c -> s^2 c, net and Q unchanged ====";
matrix I2 = vid(2);
list nets = list(list(N1Da, N1Db, N1Dq, "N1(D)"), list(N2a, N2b, N2q, "N2"), list(N3a, N3b, N3q, "N3"));
int l;
for (l = 1; l <= 3; l++) {
  A = fullA(nets[l][1], nets[l][2], nets[l][3], 1, 0, Mc);
  im = idm; im[1] = s*w;
  B = transf(A, im, dmat6(s, I2, I2, 1/s));
  matrix Ms[2][2] = 0, 0, s^2*m(3), 0;
  Ex = fullA(nets[l][1], nets[l][2], nets[l][3], 1, 0, Ms);
  ok = 1;
  for (j = 2; j <= 6; j++) { for (k = 2; k <= 6; k++) { if (B[j, k] != Ex[j, k]) { ok = 0; } } }
  "  " + nets[l][4] + ": rows/columns v1..v5 equal those with c replaced by s^2 c:"; ok;
  "  " + nets[l][4] + ": general shape:"; shapeok2(B, nets[l][1], nets[l][2], nets[l][3], 1, 0);
  kill Ms;
}
quit;
