// v5_full.sing -- checks on the full 6x6 matrix of case_common.md 1 with the general ansatz
// (all 10 anti-invariant cubics in G, all 4+4+6+6 q-coefficients, arbitrary constant M'):
//   T5: my own equivalences of pairs (net, column), applied to the GENERAL matrix, with a shape test;
//   T6: the order-2 moves and the reduction of M' to c E_23;
//   T7: the group U, its effect on q and G, the 8x8 matrices and determinants;
//   T8: N3 with c = 0.
< "vlib.sing";

ring RF = (0, i), (w, y1, y2, y3, lam, g(1..10), f(1..20), m(1..4), k3, k4, be, p0, p1, r2, r3, s2, s3, t2, t3, D), dp;
minpoly = i^2 + 1;
poly y0 = w^2;
poly G = g(1)*y3^3 + g(2)*y1^2*y3 + g(3)*y2*y3^2 + g(4)*y1^2*y2 + g(5)*y2^2*y3 + g(6)*y2^3
       + g(7)*y0*y1*y3 + g(8)*y0*y1*y2 + g(9)*y0^2*y3 + g(10)*y0^2*y2;
poly q1 = f(1)*y0*y2 + f(2)*y0*y3 + f(3)*y1*y2 + f(4)*y1*y3;
poly q2 = f(5)*y0*y2 + f(6)*y0*y3 + f(7)*y1*y2 + f(8)*y1*y3;
poly q3 = f(9)*y0^2 + f(10)*y0*y1 + f(11)*y1^2 + f(12)*y2^2 + f(13)*y2*y3 + f(14)*y3^2;
poly q4 = f(15)*y0^2 + f(16)*y0*y1 + f(17)*y1^2 + f(18)*y2^2 + f(19)*y2*y3 + f(20)*y3^2;
intvec cdeg = 0, 3, 3, 3, 3, 4;
intvec dl = 1, -1, -1, 1, 1, -1;

proc fullA(matrix D1, matrix D2, poly Q2, poly cc1, poly cc2, matrix Mp)
{
  matrix A[6][6];
  int j; int k;
  matrix I2 = vid(2);
  matrix Off[2][2];
  for (j = 1; j <= 2; j++) { for (k = 1; k <= 2; k++) { Off[j, k] = y1*I2[j, k] + y0*Mp[j, k]; } }
  matrix ab = vblk(D1, Off, transpose(Off), D2);
  for (j = 1; j <= 4; j++) { for (k = 1; k <= 4; k++) { A[j+1, k+1] = ab[j, k]; } }
  A[1, 1] = y0*G;
  A[1, 2] = w*q1; A[1, 3] = w*q2; A[1, 4] = w*q3; A[1, 5] = w*q4;
  A[2, 1] = w*q1; A[3, 1] = w*q2; A[4, 1] = w*q3; A[5, 1] = w*q4;
  A[1, 6] = Q2 - y1^2; A[6, 1] = Q2 - y1^2;
  A[2, 6] = cc1*w; A[6, 2] = cc1*w; A[3, 6] = cc2*w; A[6, 3] = cc2*w;
  return(A);
}

proc sigok(matrix A)
{
  int j; int k; poly sf;
  for (j = 1; j <= 6; j++) { for (k = 1; k <= 6; k++) {
    sf = subst(subst(subst(A[j, k], w, -w), y2, -y2), y3, -y3);
    if (sf != -dl[j]*dl[k]*A[j, k]) { return(0); }
  } }
  return(1);
}

proc wtok(matrix A)
{
  // entry (j,k) weighted homogeneous of weight 8 - c_j - c_k (w:1, y:2, coefficients: 0)
  int j; int k; poly sf; int d;
  for (j = 1; j <= 6; j++) { for (k = 1; k <= 6; k++) {
    sf = subst(subst(subst(subst(A[j, k], w, lam*w), y1, lam^2*y1), y2, lam^2*y2), y3, lam^2*y3);
    d = 8 - cdeg[j] - cdeg[k];
    if (sf != lam^d * A[j, k]) { return(0); }
  } }
  return(1);
}

proc shapeok(matrix B, matrix D1t, matrix D2t, poly Q2t)
{
  // the shape of case_common.md 1 with net (D1t, D2t), column at v1, A_05 = Q2t - y1^2;
  // M' arbitrary constant in the off-diagonal block; G, q arbitrary
  int ok = 1; int j; int k;
  if (!viszero(vsubm(B, transpose(B)))) { "  not symmetric"; ok = 0; }
  if (B[1, 6] != Q2t - y1^2) { "  A_05 wrong"; ok = 0; }
  if (B[2, 6] != w) { "  A_15 != w"; ok = 0; }
  for (j = 3; j <= 6; j++) { if (B[j, 6] != 0) { "  A_j5 != 0 for j = " + string(j-1); ok = 0; } }
  ideal Gw2 = std(ideal(w^2)); ideal Gw = std(ideal(w));
  if (reduce(B[1, 1], Gw2) != 0) { "  A_00 not in (y0)"; ok = 0; }
  for (k = 2; k <= 5; k++) { if (reduce(B[1, k], Gw) != 0) { "  A_0k not in (w)"; ok = 0; } }
  matrix I2 = vid(2);
  matrix nt = vblk(D1t, vsc(y1, I2), vsc(y1, I2), D2t);
  poly rest;
  for (j = 1; j <= 4; j++) { for (k = 1; k <= 4; k++) {
    if (subst(B[j+1, k+1], w, 0) != nt[j, k]) { "  net part wrong at " + string(j) + "," + string(k); ok = 0; }
    rest = B[j+1, k+1] - nt[j, k];
    if (rest != 0) {
      rest = rest / w^2;
      if (rest*w^2 != B[j+1, k+1] - nt[j, k]) { "  y0-part not divisible"; ok = 0; }
      if (diff(rest, w) != 0 || diff(rest, y1) != 0 || diff(rest, y2) != 0 || diff(rest, y3) != 0) { "  y0-part not constant"; ok = 0; }
      if ((j <= 2 && k <= 2) || (j >= 3 && k >= 3)) { "  y0-part in a diagonal block"; ok = 0; }
    }
  } }
  if (!sigok(B)) { "  not sigma-equivariant"; ok = 0; }
  if (!wtok(B)) { "  weights wrong"; ok = 0; }
  return(ok);
}

matrix Mg[2][2] = m(1), m(2), m(3), m(4);      // M' = [[m13, m14],[m23, m24]]
matrix Z2[2][2];
matrix D1[2][2]; matrix D2[2][2];

// nets
matrix N2a[2][2] = y2, 0, 0, y3;    matrix N2b[2][2] = y3, 0, 0, y2;    poly N2q = y2*y3;
matrix N3a[2][2] = y3, y2, y2, 0;   matrix N3b[2][2] = 0, y2, y2, -y3;  poly N3q = y2^2;
matrix N10a[2][2] = 0, y2, y2, y3;  matrix N10b[2][2] = -y3, y2, y2, 0; poly N10q = y2^2;
matrix N11a[2][2] = y3, y2, y2, y3; matrix N11b[2][2] = -y3, y2, y2, -y3; poly N11q = y2^2 - y3^2;
matrix N1Da[2][2] = D*y3, y2, y2, y3; matrix N1Db[2][2] = -y3, y2, y2, -D*y3; poly N1Dq = y2^2 - D*y3^2;

"==== the general matrices are sigma-equivariant and of the right weights ====";
matrix A2g = fullA(N2a, N2b, N2q, 1, 0, Mg);
matrix A3g = fullA(N3a, N3b, N3q, 1, 0, Mg);
matrix A1g = fullA(N1Da, N1Db, N1Dq, 1, 0, Mg);
"N2:"; sigok(A2g); wtok(A2g); "N3:"; sigok(A3g); wtok(A3g); "N1(D):"; sigok(A1g); wtok(A1g);
"shape test on the untransformed general matrices (N2, N3, N1(D)):"; shapeok(A2g, N2a, N2b, N2q); shapeok(A3g, N3a, N3b, N3q); shapeok(A1g, N1Da, N1Db, N1Dq);

"==== T5 (a), my version: (N2, column (1,1)) -> (N1(1), column (1,0)), over Q(i) ====";
// phi: w -> -w/8, y1 -> (i/2) y1, y2 -> (y2 + y3)/2, y3 -> (y3 - y2)/2 ; g_I = [[1,1],[1,-1]], g_II = -i [[1,1],[1,-1]], g0 = 1, g5 = -4
matrix A2c = fullA(N2a, N2b, N2q, 1, 1, Mg);
ideal ima = maxideal(1);
ima[1] = -w/8; ima[2] = (i/2)*y1; ima[3] = (y2 + y3)/2; ima[4] = (y3 - y2)/2;
map pha = basering, ima;
matrix A2cp = pha(A2c);
matrix Pa[6][6];
Pa[1, 1] = 1; Pa[2, 2] = 1; Pa[2, 3] = 1; Pa[3, 2] = 1; Pa[3, 3] = -1;
Pa[4, 4] = -i; Pa[4, 5] = -i; Pa[5, 4] = -i; Pa[5, 5] = i; Pa[6, 6] = -4;
matrix Ba = transpose(Pa) * A2cp * Pa;
"result has the general shape with net N1(1), Q = y2^2 - y3^2 - y1^2, column at v1:"; shapeok(Ba, N11a, N11b, N11q);
"P is sigma-equivariant (block diagonal constants) and invertible, det P ="; det(Pa);

"==== T5 (b): swap (v1 v2)(v3 v4): (N3, column (0,1)) -> (N1(0), column (1,0)) ====";
matrix A3c = fullA(N3a, N3b, N3q, 0, 1, Mg);
matrix Pb[6][6];
Pb[1, 1] = 1; Pb[2, 3] = 1; Pb[3, 2] = 1; Pb[4, 5] = 1; Pb[5, 4] = 1; Pb[6, 6] = 1;
matrix Bb = transpose(Pb) * A3c * Pb;
"result has the general shape with net N1(0), column at v1:"; shapeok(Bb, N10a, N10b, N10q);
"  (the entry m23 y0 of M' moves to position (v1, v4); T6 re-normalizes M')";

"==== T6 (i): v5 -> v5 + k3 w v3 + k4 w v4 ====";
proc t6i(matrix A, string nm)
{
  matrix P = vid(6); P[6, 4] = k3*w; P[6, 5] = k4*w;
  matrix B = transpose(P) * A * P;
  matrix Exp = A;
  Exp[2, 4] = A[2, 4] + k3*y0; Exp[4, 2] = Exp[2, 4];
  Exp[2, 5] = A[2, 5] + k4*y0; Exp[5, 2] = Exp[2, 5];
  Exp[1, 4] = A[1, 4] + w*k3*A[1, 6]; Exp[4, 1] = Exp[1, 4];
  Exp[1, 5] = A[1, 5] + w*k4*A[1, 6]; Exp[5, 1] = Exp[1, 5];
  "  " + nm + ": P^t A P = A with a13 += k3 y0, a14 += k4 y0, q3 += k3 Q, q4 += k4 Q (nothing else):"; viszero(vsubm(B, Exp));
  "  " + nm + ": P sigma-equivariant (sigma(P_jk) = delta_j delta_k P_jk):";
  int j; int k; int okp = 1;
  for (j = 1; j <= 6; j++) { for (k = 1; k <= 6; k++) { if (subst(P[j, k], w, -w) != dl[j]*dl[k]*P[j, k]) { okp = 0; } } }
  okp;
}
t6i(A2g, "N2"); t6i(A3g, "N3"); t6i(A1g, "N1(D)");

"==== T6 (ii): y1 -> y1 + be y0, then v1 -> v1 + w u v0, u = 2 be y1 + be^2 y0 ====";
proc t6ii(matrix A, matrix Da, matrix Db, poly Q2, string nm)
{
  ideal im = maxideal(1); im[2] = y1 + be*w^2;
  map ph = basering, im;
  matrix Ap = ph(A);
  matrix P = vid(6); P[2, 1] = w*(2*be*y1 + be^2*w^2);
  matrix B = transpose(P) * Ap * P;
  matrix Mb[2][2] = m(1) + be, m(2), m(3), m(4) + be;
  matrix Ex = fullA(Da, Db, Q2, 1, 0, Mb);
  int j; int k; int ok = 1;
  for (j = 2; j <= 6; j++) { for (k = 2; k <= 6; k++) { if (B[j, k] != Ex[j, k]) { ok = 0; } } }
  "  " + nm + ": rows/columns v1..v5 equal those of the normal form with M' + be I:"; ok;
  "  " + nm + ": A_05 = Q:"; B[1, 6] == Q2 - y1^2;
  "  " + nm + ": general shape preserved (sigma, weights, A_00 in (y0), A_0k in (w)):"; shapeok(B, Da, Db, Q2);
  okp = 1;
  for (j = 1; j <= 6; j++) { for (k = 1; k <= 6; k++) { if (subst(P[j, k], w, -w) != dl[j]*dl[k]*P[j, k]) { okp = 0; } } }
  "  P sigma-equivariant:"; okp;
}
int okp;
t6ii(A2g, N2a, N2b, N2q, "N2"); t6ii(A3g, N3a, N3b, N3q, "N3"); t6ii(A1g, N1Da, N1Db, N1Dq, "N1(D)");

"==== T6 (iii): (ii) with be = -m24, then (i) with k3 = m24 - m13, k4 = -m14 gives M' = m23 E_23 ====";
proc t6iii(matrix A, matrix Da, matrix Db, poly Q2, string nm)
{
  ideal im = maxideal(1); im[2] = y1 - m(4)*w^2;
  map ph = basering, im;
  matrix Ap = ph(A);
  matrix P = vid(6); P[2, 1] = w*(2*(-m(4))*y1 + m(4)^2*w^2);
  matrix B = transpose(P) * Ap * P;
  matrix P2 = vid(6); P2[6, 4] = (m(4) - m(1))*w; P2[6, 5] = -m(2)*w;
  matrix C = transpose(P2) * B * P2;
  matrix Mc[2][2] = 0, 0, m(3), 0;
  matrix Ex = fullA(Da, Db, Q2, 1, 0, Mc);
  int j; int k; int ok = 1;
  for (j = 2; j <= 6; j++) { for (k = 2; k <= 6; k++) { if (C[j, k] != Ex[j, k]) { ok = 0; } } }
  "  " + nm + ": rows/columns v1..v5 are those of the normal form with M' = m23 E_23:"; ok;
  "  " + nm + ": general shape:"; shapeok(C, Da, Db, Q2);
}
t6iii(A2g, N2a, N2b, N2q, "N2"); t6iii(A3g, N3a, N3b, N3q, "N3"); t6iii(A1g, N1Da, N1Db, N1Dq, "N1(D)");

"==== T7: the group U ====";
proc t7(matrix A, string nm, list killed)
{
  // killed: list of (q-index k in 1..4, monomial) pairs, 8 of them
  poly u2 = p0*y0 + p1*y1; poly u3 = r2*y2 + r3*y3; poly u4 = s2*y2 + s3*y3; poly u5 = t2*y2 + t3*y3;
  matrix P = vid(6); P[3, 1] = w*u2; P[4, 1] = w*u3; P[5, 1] = w*u4; P[6, 1] = y0*u5;
  matrix B = transpose(P) * A * P;
  int j; int k; int ok = 1;
  for (j = 2; j <= 6; j++) { for (k = 2; k <= 6; k++) { if (B[j, k] != A[j, k]) { ok = 0; } } }
  "  " + nm + ": rows/columns v1..v5 unchanged:"; ok;
  "  " + nm + ": A_05 unchanged:"; B[1, 6] == A[1, 6];
  poly dq; poly expq;
  int okq = 1;
  for (k = 2; k <= 5; k++) {
    dq = (B[1, k] - A[1, k]) / w;
    if (dq*w != B[1, k] - A[1, k]) { okq = 0; }
    expq = u2*A[3, k] + u3*A[4, k] + u4*A[5, k];
    if (k == 2) { expq = expq + y0*u5; }
    if (dq != expq) { okq = 0; }
  }
  "  " + nm + ": delta q_k = sum_{j=2..4} u_j a_jk + delta_{k1} y0 u5:"; okq;
  poly dG = (B[1, 1] - A[1, 1]) / y0;
  "  " + nm + ": delta(y0 G) divisible by y0:"; dG*y0 == B[1, 1] - A[1, 1];
  poly qq1 = A[1, 2]/w; poly qq2 = A[1, 3]/w; poly qq3 = A[1, 4]/w; poly qq4 = A[1, 5]/w;
  poly expG = 2*(u2*qq2 + u3*qq3 + u4*qq4) + u2^2*A[3, 3] + u3^2*A[4, 4] + u4^2*A[5, 5]
            + 2*(u2*u3*A[3, 4] + u2*u4*A[3, 5] + u3*u4*A[4, 5]) + 2*u5*A[1, 6];
  "  " + nm + ": delta G = 2 sum u_j q_j + sum_{j,l} u_j u_l a_jl + 2 u5 Q:"; dG == expG;
  poly noCross = 2*(u2*qq2 + u3*qq3 + u4*qq4) + u2^2*A[3, 3] + u3^2*A[4, 4] + u4^2*A[5, 5] + 2*u5*A[1, 6];
  "  " + nm + ": the formula without cross terms would be correct:"; dG == noCross;
  // the 8x8 matrix
  matrix Mk[8][8];
  list unk = list(p0, p1, r2, r3, s2, s3, t2, t3);
  poly dqk; matrix cf; int l; poly cc;
  for (l = 1; l <= 8; l++) {
    k = killed[l][1];
    dqk = (B[1, k+1] - A[1, k+1]) / w;
    // coefficient of the monomial killed[l][2] in dqk, as a polynomial in the unknowns
    cc = 0;
    cf = coef(dqk, w*y1*y2*y3);
    for (j = 1; j <= ncols(cf); j++) { if (cf[1, j] == killed[l][2]) { cc = cf[2, j]; } }
    for (j = 1; j <= 8; j++) { Mk[l, j] = diff(cc, unk[j]); }
    // linearity and constancy check
    poly rr = cc; for (j = 1; j <= 8; j++) { rr = rr - Mk[l, j]*unk[j]; }
    if (rr != 0) { "  nonlinear term!"; }
    kill rr;
  }
  "  " + nm + ": 8x8 matrix (rows = killed monomials, columns p0 p1 r2 r3 s2 s3 t2 t3):"; print(Mk);
  int cst = 1;
  for (l = 1; l <= 8; l++) { for (j = 1; j <= 8; j++) { if (diff(Mk[l, j], D) != 0 || diff(Mk[l, j], m(3)) != 0) { cst = 0; } } }
  "  entries free of D and of c = m23:"; cst;
  "  determinant:"; det(Mk);
}
// for T7 the normal form has M' = c E_23 with c = m(3) symbolic
matrix Mc[2][2] = 0, 0, m(3), 0;
matrix A1n = fullA(N1Da, N1Db, N1Dq, 1, 0, Mc);
matrix A2n = fullA(N2a, N2b, N2q, 1, 0, Mc);
matrix A3n = fullA(N3a, N3b, N3q, 1, 0, Mc);
list K1 = list(list(1, y0*y2), list(1, y0*y3), list(3, y2^2), list(3, y2*y3), list(3, y3^2), list(4, y0*y1), list(4, y1^2), list(4, y2^2));
list K2 = list(list(1, y0*y2), list(1, y0*y3), list(1, y1*y2), list(1, y1*y3), list(4, y0*y1), list(4, y1^2), list(4, y2^2), list(4, y2*y3));
list K3 = list(list(1, y0*y2), list(1, y0*y3), list(1, y1*y2), list(1, y1*y3), list(2, y1*y2), list(2, y1*y3), list(4, y0*y1), list(4, y1^2));
t7(A1n, "N1(D)", K1); t7(A2n, "N2", K2); t7(A3n, "N3", K3);

"==== T8: N3 with c = 0 ====";
matrix A30 = fullA(N3a, N3b, N3q, 1, 0, Z2);
intvec iso = 3, 4, 6;          // v2, v3, v5
intvec cmp = 1, 2, 5;          // v0, v1, v4
matrix Pr = submat(A30, iso, iso);
"principal submatrix on (v2, v3, v5) is zero:"; viszero(Pr);
matrix X = submat(A30, iso, cmp);
"X ="; print(X);
poly dX = det(X);
poly dA = det(A30);
"number of terms of det A:"; size(dA);
"det A + (det X)^2 == 0:"; dA + dX^2 == 0;
"det X mod w = Q^2:"; subst(dX, w, 0) == (y2^2 - y1^2)^2;
"det X - Q^2 - y0 (y1 q3 - y2 q2) == 0:"; dX - (y2^2 - y1^2)^2 - y0*(y1*q3 - y2*q2) == 0;
quit;
