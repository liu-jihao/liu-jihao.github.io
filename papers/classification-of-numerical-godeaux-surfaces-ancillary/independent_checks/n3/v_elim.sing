// v_elim.sing -- adversarial verification of case n3: build (v_build.sing) + staged constant-pivot elimination.
int T0 = rtimer;
string CHARSTR = "0";
< "v_build.sing";
// ---------------- staged constant-pivot elimination (my priority) ----------------
intvec gwo = 2,2,2,2,2,2,4,4,6,6;
intvec bwo = 3,3,5,3,1,1,1,1,5,1,1,1;
intvec uwo = 0:nvars(R);
intvec prio = 0:nvars(R);
for (v=1;v<=4;v++){ prio[v] = 100000000; }
for (n=1;n<=NL;n++){ prio[OFF+n] = n; uwo[OFF+n] = Lw[n]; }
for (t=1;t<=12;t++){ prio[14+t] = 10000 + 100*bwo[t] + t;      uwo[14+t] = bwo[t]; }
for (t=1;t<=10;t++){ prio[4+t]  = 10000 + 100*gwo[t] + 50 + t; uwo[4+t]  = gwo[t]; }
intvec SV; ideal SE; ns = 0;
intvec SVstage;
poly ff, lin, u, ex; number cc;
int nact, nrem, nconst;
for (m=0; m<=15; m++) {
  while (1) {
    bi = 0; bv = 0; bp = 1000000000; bs = 1000000000;
    for (i=1; i<=ncols(EQ); i++) {
      if (EW[i] <= m) {
        ff = EQ[i];
        if (ff != 0) {
          lin = jet(ff,1) - jet(ff,0);
          sz = size(ff);
          for (t=1; t<=size(lin); t++) {
            vv = univariate(lin[t]);
            if (vv > 0) {
              if ((prio[vv] < bp) || ((prio[vv] == bp) && (sz < bs))) {
                if (deg(diff(ff, var(vv))) == 0) { bi = i; bv = vv; bp = prio[vv]; bs = sz; }
              }
            }
          }
        }
      }
    }
    if (bi == 0) { break; }
    ff = EQ[bi]; u = var(bv);
    cc = leadcoef(diff(ff, u));
    ex = u - ff/cc;
    EQ = subst(EQ, u, ex);
    if (ns > 0) { SE = subst(SE, u, ex); }
    ns++; SV[ns] = bv; SE[ns] = ex; SVstage[ns] = m;
    if (bv <= OFF) {
      print("step " + string(ns) + " stage " + string(m) + ": A-unknown " + varstr(bv) + " [w-order " + string(uwo[bv]) + "] from eq #" + string(bi) + " (w-order " + string(EW[bi]) + ", pair " + string(PI[EPp[bi]]) + string(PJ[EPp[bi]]) + "), terms " + string(bs));
    }
  }
  nact = 0; nrem = 0; nconst = 0;
  for (i=1;i<=ncols(EQ);i++){ if (EQ[i] != 0) { nrem++; if (EW[i] <= m) { nact++; } if (deg(EQ[i]) == 0) { nconst++; } } }
  print("end of stage " + string(m) + ": pivots so far " + string(ns) + "; active nonzero eqs left " + string(nact) + "; all nonzero eqs left " + string(nrem) + "; nonzero constants " + string(nconst));
}
print("total pivots: " + string(ns));
// leftover equations
nrem = 0;
for (i=1;i<=ncols(EQ);i++){ if (EQ[i] != 0) { nrem++; if (nrem <= 20) { print("LEFTOVER eq #" + string(i) + " (w-order " + string(EW[i]) + "): " + string(EQ[i])); } } }
print("leftover equations: " + string(nrem));
// free unknowns
intvec iselim = 0:nvars(R);
for (k=1;k<=ns;k++){ iselim[SV[k]] = 1; }
nfA = 0; nfL = 0; string freeA = "";
for (v=5;v<=OFF;v++){ if (iselim[v] == 0) { nfA++; freeA = freeA + varstr(v) + " "; } }
for (v=OFF+1;v<=nvars(R);v++){ if (iselim[v] == 0) { nfL++; } }
print("free A-unknowns (" + string(nfA) + "): " + freeA);
print("free lambda unknowns: " + string(nfL));
intvec flp = 0:15; intvec flk = 0:6;
for (n=1;n<=NL;n++){ if (iselim[OFF+n] == 0) { flp[Lp[n]] = flp[Lp[n]] + 1; flk[Lk[n]+1] = flk[Lk[n]+1] + 1; } }
print("free lambda by pair (11,12,13,14,15,22,23,24,25,33,34,35,44,45,55): " + string(flp));
print("free lambda by k = 0..5: " + string(flk));
// graph check: eliminated A-unknowns do not depend on free lambdas
ideal kl = maxideal(1);
for (n=1;n<=NL;n++){ kl[OFF+n] = 0; }
map killL = R, kl;
bad = 0;
poly tmpp;
for (k=1;k<=ns;k++){ if (SV[k] <= OFF) {
   tmpp = SE[k];
   if (killL(tmpp) != tmpp) { bad++; }
   print("  " + varstr(SV[k]) + " = " + string(SE[k]));
}}
print("graph check (eliminated A-unknowns free of lambda): violations " + string(bad));
// exact sufficiency: substitute the parametrization into ALL original coefficient equations
ideal img = maxideal(1);
for (k=1;k<=ns;k++){ img[SV[k]] = SE[k]; }
map phi = R, img;
ideal chk = phi(EQ0);
print("original equations not vanishing after substitution: " + string(size(chk)));
// and the E_ij themselves
bad = 0;
for (p=1;p<=15;p++){ i=PI[p]; j=PJ[p];
  E = B[i+1,j+1]; for (k=0;k<=5;k++){ E = E - LM[p,k+1]*B[1,k+1]; }
  if (phi(E) != 0) { bad++; }
}
print("E_ij not identically zero after substitution: " + string(bad));
int maxterms = 0; for (k=1;k<=ns;k++){ if (size(SE[k]) > maxterms) { maxterms = size(SE[k]); } }
print("largest final expression: " + string(maxterms) + " terms");
// ---------------- write the graph for the later scripts ----------------
write(":w v_graph.sing", "intvec SVr = " + string(SV) + ";");
write(":a v_graph.sing", "ideal SEr;");
for (k=1;k<=ns;k++){ write(":a v_graph.sing", "SEr[" + string(k) + "] = " + string(SE[k]) + ";"); }
write(":w v_graphA.sing", "// eliminated A-unknowns as polynomials in the free A-unknowns (verifier's elimination)");
for (k=1;k<=ns;k++){ if (SV[k] <= OFF) { write(":a v_graphA.sing", varstr(SV[k]) + " = " + string(SE[k]) + ";"); } }
write(":w v_free.txt", "free A: " + freeA);
print("CPU/real time so far (s): " + string(rtimer - T0));
print("memory (KB) " + string(memory(2) div 1024));
// ---------------- exact point: det A, syzygy rank ----------------
// random rational point of the solution scheme: free unknowns random in [-20,20]\{0}
system("random", 777001);
ideal pt = maxideal(1);
for (v=5;v<=nvars(R);v++){ if (iselim[v] == 0) { t = 0; while (t == 0) { t = random(-20,20); } pt[v] = t; } }
for (k=1;k<=ns;k++){ pt[SV[k]] = 0; }
map toPt0 = R, pt;
for (k=1;k<=ns;k++){ tmpp = SE[k]; pt[SV[k]] = toPt0(tmpp); }
map toPt = R, pt;
ideal chkpt = toPt(EQ0);
print("point 1: original equations nonzero at the point: " + string(size(chkpt)));
matrix Ap = toPt(A);
print("point 1: det A != 0 : " + string(det(Ap) != 0));
// syzygy map per pair: c^{(ij)}_m -> sum_m c_m A_{m,.}, rank over Q.
// At the numeric point the unknowns are no longer needed as unknowns, so the variables
// g(1..6) serve as markers of the 6 components and L(1..nc) as markers of the c-parameters.
int rk, rktot, nc, col; rktot = 0;
poly SS;
for (p=1;p<=15;p++){ i=PI[p]; j=PJ[p];
  SS = 0; nc = 0;
  for (k=1;k<=5;k++){ d = cd[i+1]+cd[j+1]-(8-cd[k+1]); s = -dl[i+1]*dl[j+1]*dl[k+1];
   if (d >= 0) { for (a=0;a<=d;a++){ if (((d-a) mod 2) == 0) { h = (d-a) div 2;
     for (bb=0;bb<=h;bb++){ for (e=0;e<=h-bb;e++){ f = h-bb-e;
       if ( ((((a+e+f) mod 2) == 0) && (s == 1)) || ((((a+e+f) mod 2) == 1) && (s == -1)) ) {
          nc++;
          for (col=1;col<=6;col++){ SS = SS + var(OFF+nc)*w^a*y1^bb*y2^e*y3^f*Ap[k+1,col]*var(4+col); }
       }
     }}
   }}}
  }
  matrix CC = coef(SS, w*y1*y2*y3*g(1)*g(2)*g(3)*g(4)*g(5)*g(6));
  matrix JL[ncols(CC)][nc];
  for (r=1;r<=ncols(CC);r++){ for (col=1;col<=nc;col++){ JL[r,col] = diff(CC[2,r], var(OFF+col)); } }
  rk = rank(JL);
  kill JL; kill CC;
  rktot = rktot + rk;
  if (rk != nc) { print("pair " + string(i) + string(j) + ": syzygy map not injective, rank " + string(rk) + " of " + string(nc)); }
}
print("point 1: total rank of the trivial-syzygy map: " + string(rktot) + " (directions " + string(nsyz) + ")");
print("total real time (s): " + string(rtimer - T0));
print("memory (KB) " + string(memory(2) div 1024));
quit;
