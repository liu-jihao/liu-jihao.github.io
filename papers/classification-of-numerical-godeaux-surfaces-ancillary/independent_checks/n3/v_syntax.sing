// tiny syntax test for the verification scripts (no computation)
int N = 5;
execute("ring R = 0,(w,y1,y2,y3,g(1..3),L(1.." + string(N) + ")),dp;");
poly t = 3*L(4);
print(univariate(t));
print(univariate(L(4)*L(5)));
print(univariate(poly(7)));
print(rvar(L(4)));
print(rvar("L(4)"));
poly f = w^2*y1*L(1) + 2*w*y2*g(1)*L(2) - 3*w*y2 + y3;
matrix C = coef(f, w*y1*y2*y3);
print(C);
print(ncols(C));
poly e = 2*L(1) + g(1)*g(2) - 5 + L(3)*g(1);
print(jet(e,1) - jet(e,0));
print(diff(e, L(1)));
print(deg(diff(e, L(1))));
print(deg(poly(0)));
ideal I = e, L(1)*L(2) + 1, g(1);
print(subst(I, L(1), g(3)+1));
print(leadcoef(t));
print(t/leadcoef(t));
intvec ev = leadexp(w^2*y3);
print(ev);
print(nvars(R));
print(varstr(R, 6));
int s = (-1)^3;
print(s);
quit;
