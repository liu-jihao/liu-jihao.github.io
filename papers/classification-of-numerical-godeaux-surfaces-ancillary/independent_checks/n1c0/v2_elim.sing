// v2_elim.sing: global elimination with pivots ONLY on lambda-coefficients whose partial derivative is a nonzero
// rational constant (own priority: equations scanned from last to first, highest ring index first).
// Every unknown is tracked: TR[i] = image of var(4+i) under all substitutions.
system("--ticks-per-sec", 1000);
int T0 = rtimer;
< "vring.sing";
execute(read("v_eqs.txt"));
int i; int k; int m; int ix; int best; int npiv = 0; int pass = 0; int found; int np;
ideal E = simplify(EQ, 1); E = simplify(E, 4); E = simplify(E, 2);
"equations (distinct up to scalar): " + string(ncols(E));
ideal TR; for (i = 5; i <= 398; i++) { TR[i-4] = var(i); }
intvec allowed = 0:nvars(basering);
for (i = 28; i <= 398; i++) { allowed[i] = 1; }
intvec elim = 0:nvars(basering);
poly f; poly dfd; poly bestd; ideal V; poly s;
found = 1;
while (found)
{
  found = 0; pass++; np = 0;
  for (k = ncols(E); k >= 1; k--)
  {
    f = E[k];
    if (f != 0)
    {
      V = variables(f); best = 0;
      for (m = 1; m <= ncols(V); m++)
      {
        ix = univariate(V[m]);
        if (allowed[ix] == 1)
        {
          dfd = diff(f, V[m]);
          if (dfd != 0) { if (deg(dfd) == 0) { if (ix > best) { best = ix; bestd = dfd; } } }
        }
      }
      if (best > 0)
      {
        s = var(best) - (1/leadcoef(bestd))*f;
        E = subst(E, var(best), s);
        TR = subst(TR, var(best), s);
        allowed[best] = 0; elim[best] = 1; npiv++; np++; found = 1;
      }
    }
  }
  E = simplify(E, 2);
  "pass " + string(pass) + ": pivots " + string(np) + ", nonzero equations left " + string(size(E));
}
"lambda eliminated: " + string(npiv);
intvec byk = 0:6;   // by k, from v_unknowns.txt ordering: L(1..32) k=5, (33..76) k=4, (77..120) k=3, (121..166) k=2, (167..212) k=1, (213..371) k=0
for (i = 28; i <= 398; i++) { if (elim[i] == 1) {
  if (i-27 <= 32) { byk[6] = byk[6] + 1; } else { if (i-27 <= 76) { byk[5] = byk[5] + 1; } else { if (i-27 <= 120) { byk[4] = byk[4] + 1; } else {
  if (i-27 <= 166) { byk[3] = byk[3] + 1; } else { if (i-27 <= 212) { byk[2] = byk[2] + 1; } else { byk[1] = byk[1] + 1; } } } } } } }
"eliminated lambda by k = 0..5: " + string(byk);
ideal E1 = simplify(E, 2);
"leftover equations: " + string(size(E1));
// check that no eliminated variable occurs anywhere
int occ = 0; ideal VE = variables(E1 + TR);
for (k = 1; k <= ncols(VE); k++) { if (elim[univariate(VE[k])] == 1) { occ++; } }
"eliminated variables still occurring in leftover or tracked images: " + string(occ);
ideal VL = variables(E1);
string sv = "";
for (k = 1; k <= ncols(VL); k++) { if (univariate(VL[k]) <= 27) { sv = sv + string(VL[k]) + " "; } }
"A-unknowns occurring in the leftover: " + sv;
int nlam = 0; for (k = 1; k <= ncols(VL); k++) { if (univariate(VL[k]) >= 28) { nlam++; } }
"lambda-coefficients occurring in the leftover: " + string(nlam);
// degrees in the lambda's
int maxdl = 0; int nfree = 0;
for (k = 1; k <= ncols(E1); k++) {
  poly fl = E1[k];
  for (i = 28; i <= 398; i++) { fl = subst(fl, var(i), 0); }
  if (fl == E1[k]) { nfree++; "lambda-free leftover: " + string(E1[k]) + "   factors: " + string(factorize(E1[k])[1]); }
  kill fl;
}
"lambda-free leftover equations: " + string(nfree);
"--- all leftover equations, factorized ---";
for (k = 1; k <= ncols(E1); k++) { list FF = factorize(E1[k]); "LEFT " + string(k) + ": " + string(FF[1]) + "  mult " + string(FF[2]); kill FF; }
write(":w v_state1.txt", "ideal E1 = " + string(E1) + ";");
write(":a v_state1.txt", "ideal TR1 = " + string(TR) + ";");
write(":a v_state1.txt", "intvec ELIM1 = " + string(elim) + ";");
"total time (ms): " + string(rtimer - T0) + ", memory(2) = " + string(memory(2));
quit;
