// v11_misc.sing: (1) unipotent normalization of the q's for N1(D), c = 0 with ALL 20 q-coefficients and general G:
// P = I + sum_j w*u_j*E_{j0} (j = v2, v3, v4) + y0*u5*E_{50}; check that alpha, Q, column 5 are unchanged, that the
// 8 killed coefficients are affine-linear in the 8 parameters with constant Jacobian determinant;
// (2) information on branch (ii): det A factorized on the parametrization; gcd of B_00..B_05;
// (3) information on branch (iii): gcd of B_00..B_05 at the three rational points of v8.
system("--ticks-per-sec", 1000);
int T0 = rtimer;
ring R1 = 0, (w, y1, y2, y3, D, e(1..20), g(1..10), p0, p1, r2, r3, s2, s3, t2, t3), dp;
poly y0 = w^2;
poly G = g(1)*y3^3 + g(2)*y1^2*y3 + g(3)*y2*y3^2 + g(4)*y1^2*y2 + g(5)*y2^2*y3 + g(6)*y2^3 + g(7)*y0*y1*y3 + g(8)*y0*y1*y2 + g(9)*y0^2*y3 + g(10)*y0^2*y2;
poly q1 = e(1)*y0*y2 + e(2)*y0*y3 + e(3)*y1*y2 + e(4)*y1*y3;
poly q2 = e(5)*y0*y2 + e(6)*y0*y3 + e(7)*y1*y2 + e(8)*y1*y3;
poly q3 = e(9)*y0^2 + e(10)*y0*y1 + e(11)*y1^2 + e(12)*y2^2 + e(13)*y2*y3 + e(14)*y3^2;
poly q4 = e(15)*y0^2 + e(16)*y0*y1 + e(17)*y1^2 + e(18)*y2^2 + e(19)*y2*y3 + e(20)*y3^2;
poly Q = y2^2 - D*y3^2 - y1^2;
matrix A[6][6];
A[1,1] = y0*G; A[1,2] = w*q1; A[1,3] = w*q2; A[1,4] = w*q3; A[1,5] = w*q4; A[1,6] = Q;
A[2,2] = D*y3; A[2,3] = y2; A[2,4] = y1; A[2,5] = 0; A[2,6] = w;
A[3,3] = y3; A[3,4] = 0; A[3,5] = y1; A[3,6] = 0;
A[4,4] = -y3; A[4,5] = y2; A[4,6] = 0;
A[5,5] = -D*y3; A[5,6] = 0; A[6,6] = 0;
int i; int j; for (i = 1; i <= 6; i++) { for (j = i+1; j <= 6; j++) { A[j,i] = A[i,j]; } }
poly u2 = p0*y0 + p1*y1; poly u3 = r2*y2 + r3*y3; poly u4 = s2*y2 + s3*y3; poly u5 = t2*y2 + t3*y3;
matrix P[6][6]; for (i = 1; i <= 6; i++) { P[i,i] = 1; }
P[3,1] = w*u2; P[4,1] = w*u3; P[5,1] = w*u4; P[6,1] = y0*u5;
matrix A2 = transpose(P)*A*P;
int ch = 0; for (i = 2; i <= 6; i++) { for (j = 2; j <= 6; j++) { if (A2[i,j] != A[i,j]) { ch++; } } }
"entries in rows/columns v1..v5 changed: " + string(ch) + "; A_05 unchanged: " + string(A2[1,6] == Q);
"A_00 still divisible by y0: " + string(subst(A2[1,1], w, 0) == 0);
// killed coefficients after the change
proc cf(poly f, poly m) { matrix C = coef(f, w*y1*y2*y3); int k; for (k = 1; k <= ncols(C); k++) { if (C[1,k] == m) { return(C[2,k]); } } return(0); }
ideal KL = cf(A2[1,2], w*y0*y2), cf(A2[1,2], w*y0*y3), cf(A2[1,4], w*y2^2), cf(A2[1,4], w*y2*y3), cf(A2[1,4], w*y3^2), cf(A2[1,5], w*y0*y1), cf(A2[1,5], w*y1^2), cf(A2[1,5], w*y2^2);
"killed coefficients after the change: " + string(KL);
ideal UU = p0, p1, r2, r3, s2, s3, t2, t3;
matrix JK[8][8]; for (i = 1; i <= 8; i++) { for (j = 1; j <= 8; j++) { JK[i,j] = diff(KL[i], UU[j]); } }
print(JK);
"det of the 8x8 Jacobian: " + string(det(JK));
int nonlin = 0; for (i = 1; i <= 8; i++) { for (j = 1; j <= 8; j++) { if (deg(JK[i,j]) > 0) { nonlin++; } } }
"Jacobian entries depending on anything (must be 0 for affine-linear with constant part): " + string(nonlin);
kill R1;
// ---- (2), (3) ----
< "vbuild.sing";
poly detA = 0; for (k = 1; k <= 6; k++) { detA = detA + A[1,k]*B0[1,k]; }
execute(read("v_param_ii.txt"));
execute(read("v_param_iii.txt"));
ideal VA2 = TRii; for (j = 24; j <= 394; j++) { VA2[j] = var(4+j); }
map ph2 = R, w, y1, y2, y3, VA2, t;
poly dA2 = reduce(ph2(detA), std(t*b(8)-1));
list FA = factorize(dA2);
"branch (ii): factors of det A on the parametrization: " + string(FA[1]) + "  mult " + string(FA[2]);
ideal IB0 = ideal(B0);
ideal B02 = reduce(ph2(IB0), std(t*b(8)-1));
poly gg = B02[1]; for (k = 2; k <= 6; k++) { gg = gcd(gg, B02[k]); }
"branch (ii): gcd(B_00..B_05) = " + string(gg);
proc evalpt(intvec pv, intvec el, ideal TRX)
{
  int i2; ideal vals;
  for (i2 = 1; i2 <= 394; i2++) { if (el[4+i2] == 0) { vals[i2] = pv[i2]; } else { vals[i2] = 0; } }
  number b8v = leadcoef(vals[9]);
  map ev = basering, w, y1, y2, y3, vals, 1/b8v;
  ideal res = ev(TRX);
  return(res);
}
list PTS = list(intvec(-4,-8,6,-5,4,2,-4,-9,5,-6,-3,6,-3,2,-4,1,-4,2,4,3,-3,9,4,-7,-3,-4,-1,-4,9,5,-5,1,2,6,-4,5,-5,8,-3,1,-7,-8,-5,-2,-8,3,-1,-2,8,-5,7,5,3,6,-9,5,7,-4,-6,-2,-9,-8,-3,-7,-6,-8,3,-5,-7,4,-6,-3,-9,6,4,2,4,-3,-1,-1,7,-3,5,-4,1,-8,-8,8,2,2,-3,2,5,4,-7,-2,2,4,4,-3,6,-8,3,6,-2,-9,4,-3,-7,8,2,3,7,9,-4,3,4,8,2,1,2,6,-2,9,-2,7,8,-2,-2,-2,6,9,7,3,8,5,-9,1,8,5,6,6,-6,6,1,-3,-8,-5,-2,7,9,5,3,-8,3,-2,2,-8,-9,4,4,-9,1,6,-4,-5,-5,2,6,-7,8,-9,2,1,-8,5,7,-5,-9,-6,-5,-5,-6,4,-3,-9,-7,6,-3,-5,-4,7,6,-9,7,-5,5,8,-1,3,5,6,-3,-9,-1,-8,-4,-1,7,2,-3,-6,-4,6,8,-9,3,3,3,9,-2,-2,9,3,3,-7,3,9,4,9,8,4,-9,-9,-2,-2,1,-1,-5,-5,6,5,1,-4,3,9,-9,-2,9,-2,-3,1,-5,6,-5,-4,-9,-6,-2,-2,7,2,-8,9,-8,2,-8,-5,4,8,1,-9,4,1,2,-1,2,-5,-8,2,-7,-9,-3,1,-3,-3,-2,-8,2,6,9,2,5,-9,-5,8,-2,9,-8,1,3,3,-9,-4,-3,4,9,6,1,5,7,-5,8,1,9,6,-8,-4,3,8,9,-5,7,-3,8,5,3,8,-1,-9,-3,4,-3,3,2,-3,1,7,-7,3,-5,-6,8,2,6,1,-8,-2,3,7,-1,-5,-3,6,3,-5,2,-4,4,-1,-7,-6,6,-1,-6,-4,-5,8,-9,-5,1,6,-7,-6,-1,6,4,-9,-6,5,1,5,-8,9,7,3,-2,-5,3,-4,3,8,6,7), intvec(-3,8,-1,-1,-3,3,9,7,-6,-2,-9,6,8,-9,-3,9,-3,5,3,-6,9,-4,-6,5,-5,-6,-4,5,-2,7,3,2,6,-4,-1,2,-1,-9,-5,6,-1,3,8,-4,-8,8,1,-5,-6,3,-3,6,5,7,1,7,-3,1,8,4,8,-6,3,-9,8,-8,-3,-9,-7,-7,-1,-6,7,2,-7,6,3,-6,5,-3,-7,-9,-6,6,-1,6,1,7,2,-7,-1,-1,3,6,-1,3,-6,2,-9,5,-9,9,-6,7,3,-3,-1,-7,-9,-9,7,5,-3,8,9,2,4,6,4,2,-8,6,6,8,1,-7,1,9,-2,4,-4,6,6,4,-1,5,9,-1,8,3,9,-5,-7,-8,-6,-9,-9,5,-4,-5,-6,4,9,-3,-9,-2,4,-1,-1,6,9,-4,-3,-5,-7,-5,9,9,-9,-6,6,6,-6,-2,-9,-3,-9,8,4,-9,-2,7,8,-4,2,-6,8,6,-9,6,-2,-9,3,-4,-7,-3,2,-6,-7,-5,1,-1,1,-1,-6,3,5,-3,2,2,2,3,-3,-8,-9,4,3,4,3,6,-6,-3,7,9,-3,-3,8,2,6,4,2,-1,-3,-7,-5,1,2,3,-8,9,7,-3,8,-6,-9,-8,-9,6,3,-6,-2,-6,8,-5,-8,9,-3,7,4,-5,-6,1,-1,4,9,1,-2,-6,-2,-5,-9,-3,-5,-7,6,5,-1,-6,-3,-3,-4,6,5,7,2,-2,-6,-6,7,9,-6,-2,-5,2,3,8,-3,-3,-8,-3,4,-4,-2,3,4,-9,-4,8,-8,-2,6,-6,5,-5,3,-5,7,-2,3,2,-4,-6,-2,-8,-6,5,-5,-2,6,8,-3,8,3,-4,9,8,-6,8,7,-2,-6,-9,5,-6,-8,7,-6,2,7,-1,-7,1,8,-6,1,-6,-5,-4,9,-5,-1,-5,-1,-1,-2,-9,-9,-9,-7,-8,9,4,6,-2,-5,-4,4,-7,7,4,1,-9,-9,8,-1,-5,-9,5,5,4,-2,2,-8,-7), intvec(8,-6,-2,2,-7,-8,-7,5,2,-5,-5,-3,-9,-4,5,-1,8,-5,4,9,4,-3,-8,7,6,6,-6,7,-1,4,-6,4,4,2,-8,-3,-9,3,-3,-9,7,-2,-2,2,-1,6,2,-8,-9,1,-5,7,5,-2,9,2,2,6,7,-6,9,-7,6,7,2,3,2,-5,1,1,-3,-2,-8,-2,7,-8,6,2,1,-1,3,6,-6,-7,1,-6,9,-9,7,-2,-3,5,4,5,2,-8,-7,-7,4,-7,-7,-2,7,-1,5,3,-6,-4,-9,-4,-8,2,-1,-2,-4,3,9,-9,-9,-3,-3,5,7,-8,-8,4,-3,-9,-6,5,3,-7,-7,6,5,-4,3,-4,2,-7,6,8,4,5,3,-5,-7,-9,3,6,4,-4,-2,-1,-6,-8,7,7,-2,-3,6,-1,-8,-4,-2,-7,6,-4,9,-5,7,-7,2,-4,-9,-5,4,9,-6,-3,-4,-4,-2,9,-5,8,-9,5,4,-9,4,-5,-9,4,6,6,-2,-8,-1,1,-5,-1,-2,-1,-8,-1,4,-5,-9,2,6,4,-7,-6,-9,-5,-5,4,4,-2,-7,9,-4,9,-2,-8,6,-6,1,-6,9,3,9,-1,-5,-9,5,9,9,9,-4,-3,-1,-8,7,8,5,7,3,4,6,4,9,-9,-9,9,-2,3,-5,-9,-6,-3,4,-9,-1,9,9,-9,2,6,-6,1,-4,2,-9,5,5,-4,8,9,-4,7,-3,6,-8,7,3,6,8,-3,-1,-3,-1,9,4,6,7,-6,-9,-8,-3,6,-6,2,3,7,2,5,-4,-7,5,-4,-4,5,-2,-8,6,-9,1,-4,4,-4,4,1,-8,5,8,8,-9,3,-1,-5,8,6,4,5,-2,7,-4,2,-7,3,7,-9,6,-7,5,-9,2,-2,-4,-9,-7,3,9,-7,8,-7,-1,-5,3,-6,4,-3,-7,-9,-2,4,-7,3,-3,-9,7,6,-4,-6,-8,7,-6,-7,1,5,-4,6,-8,4,3,8,6,4,8,-7,-6,-4));
int pt; ideal VAL; poly g3;
for (pt = 1; pt <= 3; pt++)
{
  VAL = evalpt(PTS[pt], ELiii, TRiii);
  ideal VALA = VAL; for (j = 24; j <= 394; j++) { VALA[j] = var(4+j); }
  map evA = R, w, y1, y2, y3, VALA, t;
  ideal B03 = evA(IB0);
  g3 = B03[1]; for (k = 2; k <= 6; k++) { g3 = gcd(g3, B03[k]); }
  poly dAp = evA(detA); list FAp = factorize(dAp);
  "branch (iii) point " + string(pt) + ": gcd(B_00..B_05) = " + string(g3) + "; det A at the point: irreducible over Q " + string(size(FAp[1]) == 2) + " (factor list " + string(size(FAp[1])) + " entries incl. the constant)";
  kill dAp; kill FAp;
  kill VALA; kill evA; kill B03;
}
"total time (ms): " + string(rtimer - T0) + ", memory(2) = " + string(memory(2));
quit;
