// v7_branch_iii.sing: branch (iii) b3 = -b8, b8 invertible of case n1c0 (verification). Generated by vgen_branch.py.
system("--ticks-per-sec", 1000);
int T0 = rtimer;
< "vring.sing";
execute(read("v_state2.txt"));
int i; int k; int m; int ix; int best; int npiv = 0; int pass = 0; int found; int np; int ndiv; int nunit = 0;
ideal E = E2; ideal TR = TR2; intvec elim = ELIM2;
ideal Gt = std(t*b(8) - 1);
proc isunit(poly d, int loc)
{
  if (d == 0) { return(0); }
  if (loc == 0) { if (deg(d) == 0) { return(1); } return(0); }
  if (size(d) != 1) { return(0); }
  intvec e = leadexp(d); int ii;
  for (ii = 1; ii <= size(e); ii++) { if (e[ii] != 0) { if (ii != 13) { if (ii != 399) { return(0); } } } }
  return(1);
}

int LOC = 1;
E = subst(E, b(3), -b(8)); TR = subst(TR, b(3), -b(8));
elim[8] = 1;
E = simplify(E, 2);
intvec allowed = 0:nvars(basering);
for (i = 6; i <= 398; i++) { if (elim[i] == 0) { allowed[i] = 1; } }
allowed[13] = 0;
poly f; poly dfd; poly bestd; ideal V; poly s; intvec ee; poly dinv;
found = 1;
while (found)
{
  found = 0; pass++; np = 0; ndiv = 0;
  for (k = ncols(E); k >= 1; k--)
  {
    f = E[k];
    if (f != 0)
    {
      V = variables(f); best = 0;
      for (m = 1; m <= ncols(V); m++)
      {
        ix = univariate(V[m]);
        if (ix > 0) { if (allowed[ix] == 1)
        {
          dfd = diff(f, V[m]);
          if (isunit(dfd, LOC)) { if (ix > best) { best = ix; bestd = dfd; } }
        } }
      }
      if (best > 0)
      {
        ee = leadexp(bestd);
        dinv = (1/leadcoef(bestd)) * t^(ee[13]) * b(8)^(ee[399]);
        if (LOC == 0) { dinv = 1/leadcoef(bestd); }
        s = -(f - bestd*var(best))*dinv;
        if (LOC) { s = reduce(s, Gt); }
        E = subst(E, var(best), s); TR = subst(TR, var(best), s);
        if (LOC) { E = reduce(E, Gt); TR = reduce(TR, Gt); }
        allowed[best] = 0; elim[best] = 1; npiv++; np++; found = 1;
        if (deg(bestd) > 0) { nunit++; "  unit pivot " + string(var(best)) + ", coefficient " + string(bestd); }
      }
    }
  }
  if (LOC)
  {
    for (k = 1; k <= ncols(E); k++)
    {
      if (E[k] != 0) { while (subst(E[k], b(8), 0) == 0) { E[k] = E[k] / b(8); ndiv++; } }
      if (E[k] != 0) { while (subst(E[k], t, 0) == 0) { E[k] = E[k] / t; ndiv++; } }
    }
  }
  E = simplify(E, 2);
  "pass " + string(pass) + ": pivots " + string(np) + ", divisions by b8 or t " + string(ndiv) + ", nonzero equations left " + string(size(E));
  if (ndiv > 0) { found = 1; }
}
int nel = 0; int nelA = 0; string sfree = ""; int nfl = 0;
for (i = 5; i <= 398; i++) { if (elim[i] == 1) { nel++; if (i <= 27) { nelA++; } } else { if (i <= 27) { sfree = sfree + string(var(i)) + " "; } else { nfl++; } } }
"pivots with a non-constant (unit) coefficient: " + string(nunit);
"eliminated or fixed by the branch condition: " + string(nel) + " (A-unknowns " + string(nelA) + ", lambda " + string(nel - nelA) + ")";
"free A-unknowns: " + sfree + " (" + string(23 - nelA) + "); free lambda: " + string(nfl);
ideal EB = simplify(E, 2);
"leftover equations: " + string(size(EB));
for (k = 1; k <= ncols(EB); k++) { if (EB[k] != 0) { list FF = factorize(EB[k]); "  LEFT " + string(k) + ": " + string(FF[1]) + "  mult " + string(FF[2]); kill FF; } }
"images of the 23 A-unknowns:";
for (i = 1; i <= 23; i++) { "  " + string(var(i+4)) + " -> " + string(TR[i]); }
int lamA = 0; ideal VA;
for (i = 1; i <= 23; i++) { if (TR[i] != 0) { VA = variables(TR[i]); for (k = 1; k <= ncols(VA); k++) { if (univariate(VA[k]) >= 28) { lamA++; } } } }
"graph check: lambda variables occurring in the images of the A-unknowns: " + string(lamA);
int occ = 0; ideal VE;
for (i = 1; i <= ncols(TR); i++) { if (TR[i] != 0) { VE = variables(TR[i]); for (k = 1; k <= ncols(VE); k++) { ix = univariate(VE[k]); if (ix > 0) { if (ix <= 398) { if (elim[ix] == 1) { occ++; } } } } } }
"eliminated variables occurring in tracked images: " + string(occ);

"--- F2 point (1:0:...:0): b7, b10 and the pure w-power coefficients of the lambda_{ij,0} ---";
int f2z = 1;
"  b7 -> " + string(TR[8]); if (TR[8] != 0) { f2z = 0; }
"  b10 -> " + string(TR[11]); if (TR[11] != 0) { f2z = 0; }
"  lam_11_0[w^6] = L(213) -> " + string(TR[236]); if (TR[236] != 0) { f2z = 0; }
"  lam_12_0[w^6] = L(223) -> " + string(TR[246]); if (TR[246] != 0) { f2z = 0; }
"  lam_22_0[w^6] = L(263) -> " + string(TR[286]); if (TR[286] != 0) { f2z = 0; }
"  lam_33_0[w^6] = L(303) -> " + string(TR[326]); if (TR[326] != 0) { f2z = 0; }
"  lam_34_0[w^6] = L(313) -> " + string(TR[336]); if (TR[336] != 0) { f2z = 0; }
"  lam_35_0[w^7] = L(323) -> " + string(TR[346]); if (TR[346] != 0) { f2z = 0; }
"  lam_44_0[w^6] = L(333) -> " + string(TR[356]); if (TR[356] != 0) { f2z = 0; }
"  lam_45_0[w^7] = L(343) -> " + string(TR[366]); if (TR[366] != 0) { f2z = 0; }
"  lam_55_0[w^8] = L(353) -> " + string(TR[376]); if (TR[376] != 0) { f2z = 0; }
"all F2 conditions identically 0 after substitution: " + string(f2z);

"--- F3 points (0:0:+-sqrt(D):1|0): remainders of lambda_{ij,0}(0,0,y2,y3) modulo y2^2 - D*y3^2 ---";
int f3z = 1; poly rr;
rr = reduce(D^1*(TR[262])+D^0*(TR[264]), Gt); "  lambda_13,0 r1 -> " + string(rr); if (rr != 0) { f3z = 0; }
rr = reduce(D^1*(TR[263])+D^0*(TR[265]), Gt); "  lambda_13,0 r0 -> " + string(rr); if (rr != 0) { f3z = 0; }
rr = reduce(D^1*(TR[272])+D^0*(TR[274]), Gt); "  lambda_14,0 r1 -> " + string(rr); if (rr != 0) { f3z = 0; }
rr = reduce(D^1*(TR[273])+D^0*(TR[275]), Gt); "  lambda_14,0 r0 -> " + string(rr); if (rr != 0) { f3z = 0; }
rr = reduce(D^1*(TR[302])+D^0*(TR[304]), Gt); "  lambda_23,0 r1 -> " + string(rr); if (rr != 0) { f3z = 0; }
rr = reduce(D^1*(TR[303])+D^0*(TR[305]), Gt); "  lambda_23,0 r0 -> " + string(rr); if (rr != 0) { f3z = 0; }
rr = reduce(D^1*(TR[312])+D^0*(TR[314]), Gt); "  lambda_24,0 r1 -> " + string(rr); if (rr != 0) { f3z = 0; }
rr = reduce(D^1*(TR[313])+D^0*(TR[315]), Gt); "  lambda_24,0 r0 -> " + string(rr); if (rr != 0) { f3z = 0; }
rr = reduce(D^1*(TR[391])+D^0*(TR[393]), Gt); "  lambda_55,0 r1 -> " + string(rr); if (rr != 0) { f3z = 0; }
rr = reduce(D^2*(TR[390])+D^1*(TR[392])+D^0*(TR[394]), Gt); "  lambda_55,0 r0 -> " + string(rr); if (rr != 0) { f3z = 0; }
"all F3 remainders identically 0 after substitution: " + string(f3z);

write(":w v_param_iii.txt", "ideal TRiii = " + string(TR) + ";");
write(":a v_param_iii.txt", "intvec ELiii = " + string(elim) + ";");
write(":a v_param_iii.txt", "ideal EBiii = " + string(EB) + ";");

"total time (ms): " + string(rtimer - T0) + ", memory(2) = " + string(memory(2));
quit;
