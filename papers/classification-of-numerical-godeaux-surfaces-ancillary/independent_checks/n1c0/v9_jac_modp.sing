// v9_jac_modp.sing: Jacobian of all 752 distinct equations w.r.t. the 394 unknowns, at two points of (iii) and one
// point of (ii) (values from the exact parametrizations, reduced mod 32003); rank mod p and the rank of the projection
// of the kernel to the 23 A-coordinates. Evidence only: rank mod p <= rank over Q.
system("--ticks-per-sec", 1000);
int T0 = rtimer;
< "vring.sing";
execute(read("v_eqs.txt"));
execute(read("v_param_iii.txt"));
execute(read("v_param_ii.txt"));
ideal EQd = simplify(EQ, 1); EQd = simplify(EQd, 4); EQd = simplify(EQd, 2);
"distinct equations: " + string(ncols(EQd));
matrix JJ = jacob(EQd);   // columns = ring variables (399)
proc evalpt(intvec pv, intvec el, ideal TRX)
{
  int i2; ideal vals;
  for (i2 = 1; i2 <= 394; i2++) { if (el[4+i2] == 0) { vals[i2] = pv[i2]; } else { vals[i2] = 0; } }
  number b8v = leadcoef(vals[9]);
  map ev = basering, w, y1, y2, y3, vals, 1/b8v;
  ideal res = ev(TRX);
  return(res);
}
list PTS = list(intvec(-4,-8,6,-5,4,2,-4,-9,5,-6,-3,6,-3,2,-4,1,-4,2,4,3,-3,9,4,-7,-3,-4,-1,-4,9,5,-5,1,2,6,-4,5,-5,8,-3,1,-7,-8,-5,-2,-8,3,-1,-2,8,-5,7,5,3,6,-9,5,7,-4,-6,-2,-9,-8,-3,-7,-6,-8,3,-5,-7,4,-6,-3,-9,6,4,2,4,-3,-1,-1,7,-3,5,-4,1,-8,-8,8,2,2,-3,2,5,4,-7,-2,2,4,4,-3,6,-8,3,6,-2,-9,4,-3,-7,8,2,3,7,9,-4,3,4,8,2,1,2,6,-2,9,-2,7,8,-2,-2,-2,6,9,7,3,8,5,-9,1,8,5,6,6,-6,6,1,-3,-8,-5,-2,7,9,5,3,-8,3,-2,2,-8,-9,4,4,-9,1,6,-4,-5,-5,2,6,-7,8,-9,2,1,-8,5,7,-5,-9,-6,-5,-5,-6,4,-3,-9,-7,6,-3,-5,-4,7,6,-9,7,-5,5,8,-1,3,5,6,-3,-9,-1,-8,-4,-1,7,2,-3,-6,-4,6,8,-9,3,3,3,9,-2,-2,9,3,3,-7,3,9,4,9,8,4,-9,-9,-2,-2,1,-1,-5,-5,6,5,1,-4,3,9,-9,-2,9,-2,-3,1,-5,6,-5,-4,-9,-6,-2,-2,7,2,-8,9,-8,2,-8,-5,4,8,1,-9,4,1,2,-1,2,-5,-8,2,-7,-9,-3,1,-3,-3,-2,-8,2,6,9,2,5,-9,-5,8,-2,9,-8,1,3,3,-9,-4,-3,4,9,6,1,5,7,-5,8,1,9,6,-8,-4,3,8,9,-5,7,-3,8,5,3,8,-1,-9,-3,4,-3,3,2,-3,1,7,-7,3,-5,-6,8,2,6,1,-8,-2,3,7,-1,-5,-3,6,3,-5,2,-4,4,-1,-7,-6,6,-1,-6,-4,-5,8,-9,-5,1,6,-7,-6,-1,6,4,-9,-6,5,1,5,-8,9,7,3,-2,-5,3,-4,3,8,6,7), intvec(-3,8,-1,-1,-3,3,9,7,-6,-2,-9,6,8,-9,-3,9,-3,5,3,-6,9,-4,-6,5,-5,-6,-4,5,-2,7,3,2,6,-4,-1,2,-1,-9,-5,6,-1,3,8,-4,-8,8,1,-5,-6,3,-3,6,5,7,1,7,-3,1,8,4,8,-6,3,-9,8,-8,-3,-9,-7,-7,-1,-6,7,2,-7,6,3,-6,5,-3,-7,-9,-6,6,-1,6,1,7,2,-7,-1,-1,3,6,-1,3,-6,2,-9,5,-9,9,-6,7,3,-3,-1,-7,-9,-9,7,5,-3,8,9,2,4,6,4,2,-8,6,6,8,1,-7,1,9,-2,4,-4,6,6,4,-1,5,9,-1,8,3,9,-5,-7,-8,-6,-9,-9,5,-4,-5,-6,4,9,-3,-9,-2,4,-1,-1,6,9,-4,-3,-5,-7,-5,9,9,-9,-6,6,6,-6,-2,-9,-3,-9,8,4,-9,-2,7,8,-4,2,-6,8,6,-9,6,-2,-9,3,-4,-7,-3,2,-6,-7,-5,1,-1,1,-1,-6,3,5,-3,2,2,2,3,-3,-8,-9,4,3,4,3,6,-6,-3,7,9,-3,-3,8,2,6,4,2,-1,-3,-7,-5,1,2,3,-8,9,7,-3,8,-6,-9,-8,-9,6,3,-6,-2,-6,8,-5,-8,9,-3,7,4,-5,-6,1,-1,4,9,1,-2,-6,-2,-5,-9,-3,-5,-7,6,5,-1,-6,-3,-3,-4,6,5,7,2,-2,-6,-6,7,9,-6,-2,-5,2,3,8,-3,-3,-8,-3,4,-4,-2,3,4,-9,-4,8,-8,-2,6,-6,5,-5,3,-5,7,-2,3,2,-4,-6,-2,-8,-6,5,-5,-2,6,8,-3,8,3,-4,9,8,-6,8,7,-2,-6,-9,5,-6,-8,7,-6,2,7,-1,-7,1,8,-6,1,-6,-5,-4,9,-5,-1,-5,-1,-1,-2,-9,-9,-9,-7,-8,9,4,6,-2,-5,-4,4,-7,7,4,1,-9,-9,8,-1,-5,-9,5,5,4,-2,2,-8,-7), intvec(8,-6,-2,2,-7,-8,-7,5,2,-5,-5,-3,-9,-4,5,-1,8,-5,4,9,4,-3,-8,7,6,6,-6,7,-1,4,-6,4,4,2,-8,-3,-9,3,-3,-9,7,-2,-2,2,-1,6,2,-8,-9,1,-5,7,5,-2,9,2,2,6,7,-6,9,-7,6,7,2,3,2,-5,1,1,-3,-2,-8,-2,7,-8,6,2,1,-1,3,6,-6,-7,1,-6,9,-9,7,-2,-3,5,4,5,2,-8,-7,-7,4,-7,-7,-2,7,-1,5,3,-6,-4,-9,-4,-8,2,-1,-2,-4,3,9,-9,-9,-3,-3,5,7,-8,-8,4,-3,-9,-6,5,3,-7,-7,6,5,-4,3,-4,2,-7,6,8,4,5,3,-5,-7,-9,3,6,4,-4,-2,-1,-6,-8,7,7,-2,-3,6,-1,-8,-4,-2,-7,6,-4,9,-5,7,-7,2,-4,-9,-5,4,9,-6,-3,-4,-4,-2,9,-5,8,-9,5,4,-9,4,-5,-9,4,6,6,-2,-8,-1,1,-5,-1,-2,-1,-8,-1,4,-5,-9,2,6,4,-7,-6,-9,-5,-5,4,4,-2,-7,9,-4,9,-2,-8,6,-6,1,-6,9,3,9,-1,-5,-9,5,9,9,9,-4,-3,-1,-8,7,8,5,7,3,4,6,4,9,-9,-9,9,-2,3,-5,-9,-6,-3,4,-9,-1,9,9,-9,2,6,-6,1,-4,2,-9,5,5,-4,8,9,-4,7,-3,6,-8,7,3,6,8,-3,-1,-3,-1,9,4,6,7,-6,-9,-8,-3,6,-6,2,3,7,2,5,-4,-7,5,-4,-4,5,-2,-8,6,-9,1,-4,4,-4,4,1,-8,5,8,8,-9,3,-1,-5,8,6,4,5,-2,7,-4,2,-7,3,7,-9,6,-7,5,-9,2,-2,-4,-9,-7,3,9,-7,8,-7,-1,-5,3,-6,4,-3,-7,-9,-2,4,-7,3,-3,-9,7,6,-4,-6,-8,7,-6,-7,1,5,-4,6,-8,4,3,8,6,4,8,-7,-6,-4));
list VALS = list(evalpt(PTS[1], ELiii, TRiii), evalpt(PTS[2], ELiii, TRiii), evalpt(PTS[3], ELii, TRii));
list LAB = list("(iii) point 1", "(iii) point 2", "(ii) point 3");
// keep only the columns of the 394 unknowns
matrix JU[ncols(EQd)][394];
int a; int bcol;
for (a = 1; a <= ncols(EQd); a++) { for (bcol = 1; bcol <= 394; bcol++) { JU[a,bcol] = JJ[a, bcol+4]; } }
ring Rp = 32003, (w, y1, y2, y3, D, b(1..12), g(1..10), L(1..371), t), dp;
matrix JU = imap(R, JU);
list VALS = imap(R, VALS);
int pt; int i3; int rk; int rkA;
for (pt = 1; pt <= 3; pt++)
{
  ideal vv = VALS[pt];
  map ev = Rp, 0, 0, 0, 0, vv, 0;
  matrix Jp = ev(JU);
  rk = rank(Jp);
  // rank of the projection of the kernel to the 23 A-coordinates = 23 - rk + rank(lambda-columns)
  matrix JL[nrows(Jp)][371];
  for (a = 1; a <= nrows(Jp); a++) { for (i3 = 1; i3 <= 371; i3++) { JL[a, i3] = Jp[a, i3 + 23]; } }
  rkA = rank(JL);
  LAB[pt] + ": rank mod 32003 = " + string(rk) + ", nullity = " + string(394 - rk) + ", rank of the lambda-columns = " + string(rkA) + ", rank of the kernel projection to the A-coordinates = " + string(23 - rk + rkA);
  kill vv; kill ev; kill Jp; kill JL;
}
"total time (ms): " + string(rtimer - T0) + ", memory(2) = " + string(memory(2));
quit;
