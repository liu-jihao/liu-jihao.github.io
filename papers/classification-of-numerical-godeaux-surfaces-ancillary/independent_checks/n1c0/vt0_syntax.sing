// syntax self-test (no mathematics): variables, univariate, coef, det, subst, write/read/execute, block order
ring R = 0, (w, y1, y2, y3, D, b(1..3), L(1..3), t), dp;
poly f = 3*L(2) + b(1)*L(1) - D*b(2)^2;
ideal V = variables(f);
V;
int i;
for (i = 1; i <= ncols(V); i++) { print(string(V[i]) + " -> index " + string(univariate(V[i])) + ", diff = " + string(diff(f, V[i])) + ", deg(diff) = " + string(deg(diff(f, V[i])))); }
poly s = var(10) - (1/leadcoef(diff(f, var(10))))*f;
s;
subst(f, var(10), s);
poly e = (w^2*y1 + 2*w*y2*b(1) + y3^2*L(3))*(w + y1);
matrix C = coef(e, w*y1*y2*y3);
print(C);
leadexp(C[1,1]);
matrix M[3][3] = w, y1, 0, y1, y2, w, 0, w, y3;
det(M);
write(":w vt0_tmp.txt", "ideal TT = " + string(ideal(f, s)) + ";");
execute(read("vt0_tmp.txt"));
TT;
list F = factorize((b(1)-b(2))*(b(1)+b(2))*D);
F;
ideal I = t*b(1) - 1, b(2) + b(1), L(1)*b(1) - D;
ring S = 0, (L(1..3), t, b(1..3), D), (dp(3), dp(5));
ideal I = imap(R, I);
option(redSB);
std(I);
dim(std(I));
size(f);
int tk = rtimer;
memory(2);
quit;
