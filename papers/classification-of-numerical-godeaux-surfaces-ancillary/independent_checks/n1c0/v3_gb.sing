// v3_gb.sing: Groebner-basis checks on the leftover ideal I1 of v2 (lambda-only elimination).
// For a polynomial h in the A-unknowns only (unchanged by the substitutions), h in I  <=>  h in I1.
system("--ticks-per-sec", 1000);
int T0 = rtimer;
< "vring.sing";
execute(read("v_state1.txt"));
int i; int k;
// occurrence check (redo of the auxiliary check of v2)
int occ = 0; ideal VE = variables(E1);
for (k = 1; k <= ncols(VE); k++) { if (univariate(VE[k]) > 0) { if (ELIM1[univariate(VE[k])] == 1) { occ++; } } }
for (i = 1; i <= ncols(TR1); i++) { if (TR1[i] != 0) { ideal VT = variables(TR1[i]); for (k = 1; k <= ncols(VT); k++) { if (univariate(VT[k]) > 0) { if (ELIM1[univariate(VT[k])] == 1) { occ++; } } } kill VT; } }
"eliminated variables occurring in E1 or in the tracked images: " + string(occ);
// ring of the remaining unknowns (no w, y, t)
string vl = "";
for (i = 5; i <= 398; i++) { if (ELIM1[i] == 0) { if (size(vl) > 0) { vl = vl + ","; } vl = vl + string(var(i)); } }
execute("ring S = 0, (" + vl + "), dp;");
"remaining unknowns: " + string(nvars(S));
option(redSB);
ideal E1 = imap(R, E1);
int T1 = rtimer;
ideal G1 = std(E1);
"std(I1): " + string(rtimer - T1) + " ms, size " + string(size(G1)) + ", Krull dimension of Q[S]/I1 = " + string(dim(G1));
list H = list((b(3)-b(8))*(b(3)+b(8)), b(1), b(7), b(10), g(4), g(6), g(8), g(10), b(4)^2, b(4), b(3), b(8), b(3)-b(8), b(3)+b(8), b(7)*b(4), D*b(4));
list HN = list("(b3-b8)(b3+b8)", "b1", "b7", "b10", "g4", "g6", "g8", "g10", "b4^2", "b4", "b3", "b8", "b3-b8", "b3+b8", "b7*b4", "D*b4");
for (k = 1; k <= size(H); k++) { "  " + HN[k] + " in I: " + string(reduce(H[k], G1) == 0); }
// the A-unknown part of the leading ideal and the generators of G1 without lambda
int nl = 0; string s0 = "";
for (k = 1; k <= ncols(G1); k++) {
  poly fl = G1[k]; for (i = 24; i <= nvars(S); i++) { fl = subst(fl, var(i), 0); }
  if (fl == G1[k]) { nl++; s0 = s0 + string(G1[k]) + " ; "; }
  kill fl;
}
"generators of G1 free of lambda (" + string(nl) + "): " + s0;
write(":w v_G1.txt", "ideal G1 = " + string(G1) + ";");
"total time (ms): " + string(rtimer - T0) + ", memory(2) = " + string(memory(2));
quit;
