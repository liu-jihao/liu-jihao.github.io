// V1_general.sing -- generated by gen_v.py (variant general). Independent verification of case n1c1.
system("--ticks-per-sec", 1000);
int T0 = rtimer;
int i, j, k, r, c, rr, cc, p, t, s, e, u, bad, bad2, ne, nd, dup, crossdup, nL, nsub, best, nzero, incons, nleft, nlam, nAc, nfA, nfX;
intvec cd = 0,3,3,3,3,4; intvec dl = 1,-1,-1,1,1,-1;
int NX = 371; int NA = 38; int iD = 410; int iw = 414;
ring S = 0, (qq(1), qq(2), qq(3), qq(4), qq(5), qq(6), qq(7), qq(8), qq(9), qq(10), qq(11), qq(12), qq(13), qq(14), qq(15), qq(16), qq(17), qq(18), qq(19), qq(20), gg(1), gg(2), gg(3), gg(4), gg(5), gg(6), gg(7), gg(8), gg(9), gg(10), hh(1), hh(2), hh(3), hh(4), hh(5), hh(6), ll(1), ll(2), D, y3, y2, y1, w, tt), dp;
poly y0 = w^2;
poly Q = y2^2 - D*y3^2 - y1^2;
poly G = gg(1)*w^4*y2 + gg(2)*w^4*y3 + gg(3)*w^2*y1*y2 + gg(4)*w^2*y1*y3 + gg(5)*y1^2*y2 + gg(6)*y1^2*y3 + gg(7)*y2^3 + gg(8)*y2^2*y3 + gg(9)*y2*y3^2 + gg(10)*y3^3;
poly q1 = qq(17)*y1*y3 + qq(18)*y1*y2 + qq(19)*w^2*y3 + qq(20)*w^2*y2;
poly q2 = qq(13)*y1*y3 + qq(14)*y1*y2 + qq(15)*w^2*y3 + qq(16)*w^2*y2;
poly q3 = qq(7)*y3^2 + qq(8)*y2*y3 + qq(9)*y2^2 + qq(10)*y1^2 + qq(11)*w^2*y1 + qq(12)*w^4;
poly q4 = qq(1)*y3^2 + qq(2)*y2*y3 + qq(3)*y2^2 + qq(4)*y1^2 + qq(5)*w^2*y1 + qq(6)*w^4;
poly h = hh(1)*y1^3*y2 + hh(2)*y1^3*y3 + hh(3)*y1*y2^3 + hh(4)*y1*y2^2*y3 + hh(5)*y1*y2*y3^2 + hh(6)*y1*y3^3;
poly L = ll(1)*w^2 + ll(2)*y1;
matrix A[6][6] = y0*G + h, w*q1, w*q2, w*q3, w*q4, Q + y0*L, w*q1, D*y3, y2, y1, 0, w, w*q2, y2, y3, y0, y1, 0, w*q3, y1, y0, -y3, y2, 0, w*q4, 0, y1, y2, -D*y3, 0, Q + y0*L, w, 0, 0, 0, 0;
map sgS = S, qq(1), qq(2), qq(3), qq(4), qq(5), qq(6), qq(7), qq(8), qq(9), qq(10), qq(11), qq(12), qq(13), qq(14), qq(15), qq(16), qq(17), qq(18), qq(19), qq(20), gg(1), gg(2), gg(3), gg(4), gg(5), gg(6), gg(7), gg(8), gg(9), gg(10), hh(1), hh(2), hh(3), hh(4), hh(5), hh(6), ll(1), ll(2), D, -y3, -y2, y1, -w, tt;
map hmS = S, qq(1), qq(2), qq(3), qq(4), qq(5), qq(6), qq(7), qq(8), qq(9), qq(10), qq(11), qq(12), qq(13), qq(14), qq(15), qq(16), qq(17), qq(18), qq(19), qq(20), gg(1), gg(2), gg(3), gg(4), gg(5), gg(6), gg(7), gg(8), gg(9), gg(10), hh(1), hh(2), hh(3), hh(4), hh(5), hh(6), ll(1), ll(2), D, tt^2*y3, tt^2*y2, tt^2*y1, tt*w, tt;
poly a;
bad = 0;
for (j=1; j<=6; j++) { for (k=1; k<=6; k++) { a = A[j,k];
  if (A[j,k] != A[k,j]) { bad++; "not symmetric", j-1, k-1; }
  if (sgS(a) != -dl[j]*dl[k]*a) { bad++; "sigma-sign fails at", j-1, k-1; }
  if (hmS(a) != tt^(8-cd[j]-cd[k])*a) { bad++; "weight fails at", j-1, k-1; } } }
"CHECK entries of A: symmetric, sigma-sign -d_j d_k, weight 8-c_j-c_k; failures =", bad;
// special net alpha (rows/cols v1..v4 at w = 0) and Q
matrix al[4][4]; for (j=1;j<=4;j++) { for (k=1;k<=4;k++) { al[j,k] = subst(A[j+1,k+1], w, 0); } }
"CHECK det(alpha) - Q^2 == 0:", det(al) - Q^2 == 0;
ideal IQ = std(ideal(Q)); bad = 0;
matrix aal[4][4]; matrix mm3[3][3];
for (j=1;j<=4;j++) { for (k=1;k<=4;k++) { rr = 0; for (r=1;r<=4;r++) { if (r != k) { rr++; cc = 0; for (c=1;c<=4;c++) { if (c != j) { cc++; mm3[rr,cc] = al[r,c]; } } } } aal[j,k] = (-1)^(j+k)*det(mm3); if (reduce(aal[j,k], IQ) != 0) { bad++; } } }
"CHECK Q divides every entry of adj(alpha): failures =", bad;
matrix I4[4][4]; for (j=1;j<=4;j++) { I4[j,j] = 1; }
"CHECK alpha*adj(alpha) == det(alpha)*I:", al*aal == det(al)*I4;
// adjugate of A by cofactors: B[i,j] = (-1)^(i+j) det(A without row j and column i)
matrix B[6][6]; matrix m5[5][5];
for (i=1;i<=6;i++) { for (j=1;j<=6;j++) { rr = 0; for (r=1;r<=6;r++) { if (r != j) { rr++; cc = 0; for (c=1;c<=6;c++) { if (c != i) { cc++; m5[rr,cc] = A[r,c]; } } } } B[i,j] = (-1)^(i+j)*det(m5); } }
poly dA = det(A);
matrix I6[6][6]; for (j=1;j<=6;j++) { I6[j,j] = 1; }
"CHECK A*B == det(A)*I:", A*B == dA*I6;
"CHECK B symmetric:", B == transpose(B);
"det A sigma-invariant:", sgS(dA) == dA, " weight 16:", hmS(dA) == tt^16*dA;
"leading terms: B05 + Q^3 == 0 mod w:", subst(B[1,6] + Q^3, w, 0) == 0;
for (k=2;k<=5;k++) { "B0k mod w == 0 for k =", k-1, ":", subst(B[1,k], w, 0) == 0; }
"time (ms) after adjugate:", rtimer - T0;
