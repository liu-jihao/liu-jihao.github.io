bad = 0;
for (p=1;p<=15;p++) { for (k=0;k<=5;k++) { i = PPI[p]; j = PPJ[p];
  ff = LAM[p,k+1]; if (ff != 0) { if (sgR(ff) != dl[i+1]*dl[j+1]*dl[k+1]*ff) { bad++; } if (hmR(ff) != tt^(cd[i+1]+cd[j+1]-cd[k+1])*ff) { bad++; } } } }
"CHECK lambda polys: sign d_i d_j d_k and weight c_i+c_j-c_k; failures =", bad;
// rank-condition polynomials E_ij = B_ij - sum_k lambda_{ij,k} B_0k and their coefficients
list EF; ideal EQ; intvec EO; intvec EP; matrix C; poly E; ne = 0; bad = 0;
for (p=1;p<=15;p++) { i = PPI[p]; j = PPJ[p]; E = B[i+1,j+1];
  for (k=0;k<=5;k++) { E = E - LAM[p,k+1]*B[1,k+1]; }
  EF[p] = E;
  if (hmR(E) != tt^(8+cd[i+1]+cd[j+1])*E) { bad++; "E weight fails", p; }
  if (sgR(E) != -dl[i+1]*dl[j+1]*E) { bad++; "E sign fails", p; }
  if (E != 0) { C = coef(E, w*y1*y2*y3);
    for (t=1;t<=ncols(C);t++) { if (C[2,t] != 0) { ne++; EQ[ne] = C[2,t]; EO[ne] = leadexp(C[1,t])[iw]; EP[ne] = p; } } } }
"CHECK E_ij homogeneous of weight 8+c_i+c_j with sign -d_i d_j; failures =", bad;
"nonzero coefficient equations:", ne;
intvec cnt = 0:20; for (t=1;t<=ne;t++) { cnt[EO[t]+1] = cnt[EO[t]+1] + 1; }
"nonzero equations by w-order 0..19:", cnt;
// dedup up to scalars (global)
ideal EN; for (t=1;t<=ne;t++) { EN[t] = EQ[t]/leadcoef(EQ[t]); }
ideal ED; intvec EDO; intvec EDP; nd = 0; crossdup = 0;
for (t=1;t<=ne;t++) { dup = 0; for (u=1;u<=nd;u++) { if (size(ED[u]) == size(EN[t])) { if (ED[u] == EN[t]) { dup = u; break; } } }
  if (dup == 0) { nd++; ED[nd] = EN[t]; EDO[nd] = EO[t]; EDP[nd] = EP[t]; } else { if (EDO[dup] != EO[t]) { crossdup++; } } }
"distinct equations up to scalar (global):", nd, " duplicates across different w-orders:", crossdup;
cnt = 0:20; for (t=1;t<=nd;t++) { cnt[EDO[t]+1] = cnt[EDO[t]+1] + 1; }
"distinct equations by w-order 0..19:", cnt;
// order structure: max total w-order of unknowns in each term <= w-order of the equation is checked in Python
write(":w V1_general_eqs_ideal.txt", string(ED));
write(":w V1_general_eqs_orders.txt", string(EDO));
"time (ms) after equations:", rtimer - T0;
proc cand(poly f, int nx0, int na0)
{
  poly lin = jet(f,1) - jet(f,0);
  int s, idx, cls; poly m, dd;
  int bcls = 0; poly bm = 0; number bc = 0;
  for (s=1; s<=size(lin); s++)
  {
    m = leadmonom(lin[s]); idx = rvar(m); cls = 0;
    if ((idx >= 1) && (idx <= nx0)) { cls = 1; }
    if ((idx > nx0) && (idx <= nx0+na0)) { cls = 2; }
    if (cls > 0)
    {
      if ((bcls == 0) || (cls < bcls))
      {
        dd = diff(f, m);
        if (deg(dd) == 0) { bcls = cls; bm = m; bc = leadcoef(dd); if (cls == 1) { break; } }
      }
    }
  }
  return(list(bcls, bm, bc));
}
proc applymap(poly f, ideal MM)
{
  def R0 = basering; map phi = R0, MM; return(phi(f));
}
// global constant-pivot elimination; priority: lambda before A-coefficient (D never), then fewest terms, then first found
ideal Lc = ED; nL = nd;
intvec ccls = 0:nL; list cvar; list ccoef; intvec csz = 0:nL; list cres;
for (e=1;e<=nL;e++) { cres = cand(Lc[e], NX, NA); ccls[e] = cres[1]; cvar[e] = cres[2]; ccoef[e] = cres[3]; csz[e] = size(Lc[e]); }
list SUBV; list SUBE; list SUBC; intvec SUBF; intvec SUBK; intvec SUBO; intvec SUBS; nsub = 0; poly uu, ex; number cf; nzero = 0; incons = 0;
while (1) { best = 0;
  for (e=1;e<=nL;e++) { if (ccls[e] > 0) { if (best == 0) { best = e; } else { if ((ccls[e] < ccls[best]) || ((ccls[e] == ccls[best]) && (csz[e] < csz[best]))) { best = e; } } } }
  if (best == 0) { break; }
  uu = cvar[best]; cf = ccoef[best];
  if (deg(diff(Lc[best], uu)) != 0) { "ERROR: non-constant pivot"; quit; }
  ex = uu - Lc[best]/cf;
  if (diff(ex, uu) != 0) { "ERROR: expression contains pivot variable"; quit; }
  nsub++; SUBV[nsub] = uu; SUBE[nsub] = ex; SUBC[nsub] = cf; SUBF[nsub] = best; SUBK[nsub] = ccls[best]; SUBO[nsub] = EDO[best]; SUBS[nsub] = csz[best];
  Lc[best] = 0; ccls[best] = 0;
  for (e=1;e<=nL;e++) { if (Lc[e] != 0) { if (diff(Lc[e], uu) != 0) { Lc[e] = subst(Lc[e], uu, ex);
        if (Lc[e] == 0) { ccls[e] = 0; nzero++; } else { if (deg(Lc[e]) == 0) { incons++; "INCONSISTENT equation", e; }
          cres = cand(Lc[e], NX, NA); ccls[e] = cres[1]; cvar[e] = cres[2]; ccoef[e] = cres[3]; csz[e] = size(Lc[e]); } } } } }
"elimination done: substitutions =", nsub, " equations reduced to zero =", nzero, " inconsistent =", incons;
nleft = 0; for (e=1;e<=nL;e++) { if (Lc[e] != 0) { nleft++; } }
"LEFTOVER equations:", nleft;
if (nleft > 0) { for (e=1;e<=nL;e++) { if (Lc[e] != 0) { "left eq", e, "w-order", EDO[e], ":", Lc[e]; "  factors:", factorize(Lc[e]); } } }
"time (ms) after elimination:", rtimer - T0;
// pivot statistics
nlam = 0; nAc = 0; for (k=1;k<=nsub;k++) { if (SUBK[k] == 1) { nlam++; } else { nAc++; } }
"eliminated lambda:", nlam, " eliminated A-coefficients:", nAc;
string pivs = ""; for (k=1;k<=nsub;k++) { pivs = pivs + string(SUBC[k]) + " "; }
"pivot constants:", pivs;
string elimA = ""; for (k=1;k<=nsub;k++) { if (SUBK[k] == 2) { elimA = elimA + string(SUBV[k]) + "[step " + string(k) + ", eq w-order " + string(SUBO[k]) + ", pivot " + string(SUBC[k]) + "] "; } }
"eliminated A-coefficients (with step):", elimA;
link lk3 = ":w V1_general_subs.txt"; for (k=1;k<=nsub;k++) { write(lk3, string(k) + " | " + string(SUBV[k]) + " | class " + string(SUBK[k]) + " | pivot " + string(SUBC[k]) + " | eq " + string(SUBF[k]) + " (w-order " + string(SUBO[k]) + ", terms " + string(SUBS[k]) + ") | " + string(SUBE[k])); } close(lk3);
// free unknowns
intvec iselim = 0:nvars(R); for (k=1;k<=nsub;k++) { iselim[rvar(SUBV[k])] = 1; }
string freeA = ""; string freeX = ""; nfA = 0; nfX = 0;
for (k=1;k<=NX;k++) { if (iselim[k] == 0) { nfX++; freeX = freeX + string(var(k)) + " "; } }
for (k=NX+1;k<=NX+NA+1;k++) { if (iselim[k] == 0) { nfA++; freeA = freeA + string(var(k)) + " "; } }
"FREE A-coefficients (f, D included):", nfA, ":", freeA;
"FREE lambda-coefficients:", nfX;
link lk1 = ":w V1_general_free.txt"; write(lk1, "freeA: " + freeA); write(lk1, "freeX: " + freeX); close(lk1);
// back-substitution
ideal MM = maxideal(1);
for (k=nsub;k>=1;k--) { MM[rvar(SUBV[k])] = applymap(SUBE[k], MM); }
"time (ms) after back-substitution:", rtimer - T0;
// sanity: final expressions contain only free variables
ideal ZE = maxideal(1); for (k=1;k<=nsub;k++) { ZE[rvar(SUBV[k])] = 0; } map zel = R, ZE;
bad = 0; for (k=1;k<=nsub;k++) { ff = MM[rvar(SUBV[k])]; if (zel(ff) != ff) { bad++; } }
"CHECK final expressions involve only free unknowns: failures =", bad;
// graph check: eliminated A-coefficients free of lambda
bad = 0; link lk2 = ":w V1_general_graph.txt";
for (k=NX+1;k<=NX+NA;k++) { if (iselim[k] == 1) { ff = MM[k]; if (zx(ff) != ff) { bad++; } write(lk2, string(var(k)) + " = " + string(ff) + ";"); } }
close(lk2);
"GRAPH CHECK (eliminated A-coefficients free of lambda): failures =", bad;
write(":w V1_general_param_ideal.txt", string(MM));
// verification (ii): the parametrization kills all coefficient equations and all 15 full E_ij
map PHI = R, MM;
bad = 0; for (t=1;t<=ne;t++) { ff = EQ[t]; if (PHI(ff) != 0) { bad++; } }
"VERIFY (ii-a) all nonzero coefficient equations vanish on the parametrization: failures =", bad;
"time (ms) after (ii-a):", rtimer - T0;
// verification (iii): each pivot equation is the image of its original equation under the earlier substitutions
bad = 0; bad2 = 0;
for (k=1;k<=nsub;k++) { ff = ED[SUBF[k]]; for (u=1;u<k;u++) { ff = subst(ff, SUBV[u], SUBE[u]); }
  if (ff != SUBC[k]*(SUBV[k] - SUBE[k])) { bad++; }
  for (u=1;u<=k;u++) { if (diff(SUBE[k], SUBV[u]) != 0) { bad2++; } } }
"VERIFY (iii) pivot k = image of original equation under substitutions 1..k-1, equal to c_k*(u_k - e_k): failures =", bad;
"VERIFY (iii) e_k free of u_1..u_k: failures =", bad2;
"time (ms) after (iii):", rtimer - T0;
bad = 0; for (p=1;p<=15;p++) { ff = EF[p]; if (PHI(ff) != 0) { bad++; "E fails", p; } }
"VERIFY (ii-b) the 15 polynomials E_ij vanish identically on the parametrization: failures =", bad;
"time (ms) total:", rtimer - T0;
"memory (bytes) memory(1), memory(2):", memory(1), memory(2);
quit;
