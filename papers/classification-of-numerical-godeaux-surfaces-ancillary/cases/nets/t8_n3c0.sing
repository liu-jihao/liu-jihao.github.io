// T8 (case nets): N3 with c = 0.  Full matrix A with general G (g(1..10)) and all 20 q-coefficients (f(1..20)).
// Claim: the principal 3x3 submatrix on (v2, v3, v5) is 0, and det A = -(det X)^2, X = A[rows v2,v3,v5; cols v0,v1,v4].
< "nets_common.sing";
int tt = timer;
ring R = 0, (w,y1,y2,y3, g(1..10), f(1..20)), dp;
poly y0 = w^2;
poly G = g(1)*y3^3 + g(2)*y1^2*y3 + g(3)*y2*y3^2 + g(4)*y1^2*y2 + g(5)*y2^2*y3 + g(6)*y2^3
       + g(7)*y0*y1*y3 + g(8)*y0*y1*y2 + g(9)*y0^2*y3 + g(10)*y0^2*y2;
poly q1 = f(1)*y0*y2 + f(2)*y0*y3 + f(3)*y1*y2 + f(4)*y1*y3;
poly q2 = f(5)*y0*y2 + f(6)*y0*y3 + f(7)*y1*y2 + f(8)*y1*y3;
poly q3 = f(9)*y0^2 + f(10)*y0*y1 + f(11)*y1^2 + f(12)*y2^2 + f(13)*y2*y3 + f(14)*y3^2;
poly q4 = f(15)*y0^2 + f(16)*y0*y1 + f(17)*y1^2 + f(18)*y2^2 + f(19)*y2*y3 + f(20)*y3^2;
poly Q = y2^2 - y1^2;
matrix A[6][6] =
  y0*G, w*q1, w*q2, w*q3, w*q4, Q,
  w*q1, y3,   y2,   y1,   0,    w,
  w*q2, y2,   0,    0,    y1,   0,
  w*q3, y1,   0,    0,    y2,   0,
  w*q4, 0,    y1,   y2,   -y3,  0,
  Q,    w,    0,    0,    0,    0;
"A (N3, c = 0) ="; print(A);
"symmetric :", iszero(A - transpose(A));
// rows/cols v0..v5 = indices 1..6: v2 -> 3, v3 -> 4, v5 -> 6; v0 -> 1, v1 -> 2, v4 -> 5
intvec I = 3, 4, 6;
intvec J = 1, 2, 5;
matrix Z[3][3];
matrix X[3][3];
int u, v;
for (u = 1; u <= 3; u++) { for (v = 1; v <= 3; v++) { Z[u,v] = A[I[u], I[v]]; X[u,v] = A[I[u], J[v]]; } }
"principal 3x3 submatrix on (v2, v3, v5) is zero :", iszero(Z);
"X = A[rows v2,v3,v5; cols v0,v1,v4] ="; print(X);
poly dX = det(X);
"det X =", dX;
"det X - (Q^2 + y0*(y1*q3 - y2*q2)) == 0 :", dX - (Q^2 + y0*(y1*q3 - y2*q2)) == 0;
int t0 = timer;
poly dA = det(A);
"det A computed in (s):", timer - t0, "  number of terms:", size(dA);
"det A + (det X)^2 == 0 :", dA + dX^2 == 0;
"det X mod w = Q^2 (so det X != 0 and det A = -(det X)^2 is a nonzero square times -1, never irreducible) :", subst(dX, w, 0) - Q^2 == 0;
"[block argument: after the permutation (v2,v3,v5 | v0,v1,v4) of rows and columns, A = [[0, X],[X^t, W]], and det = (-1)^3 det(X) det(X^t)]";
"total time (s):", timer - tt;
"peak memory (KB, Singular memory(2)):", memory(2) div 1024;
quit;
