ideal E = LEFT; intvec EO = LEFTO;
E[ncols(LEFT)+1] = b(3)+b(8); EO[ncols(LEFT)+1] = 99;
intvec SV = SV0; ideal SE = SE0; intvec SST = SST0; int nel = size(SV0); TRK = TRK0;
"equations now:", size(E);
intvec ORDX = ORD;
ORDX[389] = 999;   // b8 is the localizing element: never used as a pivot
// ---- s6_branch_iii constant-pivot elimination, priority lambda_index, division by b(8) (assumed invertible)
intvec SC; for (k=1;k<=394;k++) { SC[k] = k; }
int nE = ncols(E); intvec CV = 0:nE; intvec CS = 0:nE; intvec cvs;
int vb; int eb; int bs; poly piv; poly cc; poly ex; int pass = 0; int progress = 1; int ndiv;
for (u=1;u<=nE;u++) { if (E[u] != 0) { cvs = cand(E[u], SC, ORDX, 99); CV[u] = cvs[1]; CS[u] = cvs[2]; } }
while (progress) {
  pass++; progress = 0;
  while (1) {
    vb = 0; eb = 0; bs = 0;
    for (u=1;u<=nE;u++) { if (CV[u] > 0) { if (vb == 0 || CS[u] < bs) { vb = CV[u]; eb = u; bs = CS[u]; } } }
    if (vb == 0) { break; }
    piv = E[eb]; cc = diff(piv, var(vb));
    ex = var(vb) - piv/cc;
    E[eb] = 0; CV[eb] = 0;
    nel++; SV[nel] = vb; SE[nel] = ex; SST[nel] = 400 + pass;
    for (u=1;u<=nE;u++) {
      if (E[u] != 0) { if (diff(E[u], var(vb)) != 0) {
        E[u] = subst(E[u], var(vb), ex);
        if (E[u] != 0) { cvs = cand(E[u], SC, ORDX, 99); CV[u] = cvs[1]; CS[u] = cvs[2]; } else { CV[u] = 0; }
      } }
    }
    TRK = subst(TRK, var(vb), ex);
    if (nel mod 50 == 0) { "  eliminated", nel, "; equations left", size(E), "; ms:", rtimer-T0; }
  }
  ndiv = 0;
  for (u=1;u<=nE;u++) { if (E[u] != 0) { while (subst(E[u], b(8), 0) == 0) { E[u] = E[u] / b(8); ndiv++; progress = 1; } } }
  for (u=1;u<=nE;u++) { if (E[u] != 0) { cvs = cand(E[u], SC, ORDX, 99); CV[u] = cvs[1]; CS[u] = cvs[2]; } }
  "  pass", pass, ": eliminated so far", nel, "; equations left", size(E), "; divisions by b(8) in this pass:", ndiv;
  if (pass >= 12) { progress = 0; }
}
