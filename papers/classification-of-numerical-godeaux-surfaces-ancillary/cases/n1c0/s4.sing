pol = cofac(A,6,5) - ((l(297)*w*y1^3 + l(298)*w*y1*y2^2 + l(299)*w*y1*y2*y3 + l(300)*w*y1*y3^2 + l(301)*w^3*y1^2 + l(302)*w^3*y2^2 + l(303)*w^3*y2*y3 + l(304)*w^3*y3^2 + l(305)*w^5*y1 + l(306)*w^7)*B0[1,1] + (l(307)*y1^2 + l(308)*y2^2 + l(309)*y2*y3 + l(310)*y3^2 + l(311)*w^2*y1 + l(312)*w^4)*B0[1,2] + (l(313)*y1^2 + l(314)*y2^2 + l(315)*y2*y3 + l(316)*y3^2 + l(317)*w^2*y1 + l(318)*w^4)*B0[1,3] + (l(319)*y1*y2 + l(320)*y1*y3 + l(321)*w^2*y2 + l(322)*w^2*y3)*B0[1,4] + (l(323)*y1*y2 + l(324)*y1*y3 + l(325)*w^2*y2 + l(326)*w^2*y3)*B0[1,5] + (l(327)*w*y2 + l(328)*w*y3)*B0[1,6]);
if (pol != 0) { C = coef(pol, w*y1*y2*y3); for (u=1;u<=ncols(C);u++){ if (C[2,u] != 0) { nq++; EQ[nq] = C[2,u]; EQO[nq] = leadexp(C[1,u])[395]; EQT[nq] = "E_45[" + string(C[1,u]) + "]"; } } }
pol = cofac(A,6,6) - ((l(329)*y1^4 + l(330)*y1^2*y2^2 + l(331)*y1^2*y2*y3 + l(332)*y1^2*y3^2 + l(333)*y2^4 + l(334)*y2^3*y3 + l(335)*y2^2*y3^2 + l(336)*y2*y3^3 + l(337)*y3^4 + l(338)*w^2*y1^3 + l(339)*w^2*y1*y2^2 + l(340)*w^2*y1*y2*y3 + l(341)*w^2*y1*y3^2 + l(342)*w^4*y1^2 + l(343)*w^4*y2^2 + l(344)*w^4*y2*y3 + l(345)*w^4*y3^2 + l(346)*w^6*y1 + l(347)*w^8)*B0[1,1] + (l(348)*w*y1^2 + l(349)*w*y2^2 + l(350)*w*y2*y3 + l(351)*w*y3^2 + l(352)*w^3*y1 + l(353)*w^5)*B0[1,2] + (l(354)*w*y1^2 + l(355)*w*y2^2 + l(356)*w*y2*y3 + l(357)*w*y3^2 + l(358)*w^3*y1 + l(359)*w^5)*B0[1,3] + (l(360)*w*y1*y2 + l(361)*w*y1*y3 + l(362)*w^3*y2 + l(363)*w^3*y3)*B0[1,4] + (l(364)*w*y1*y2 + l(365)*w*y1*y3 + l(366)*w^3*y2 + l(367)*w^3*y3)*B0[1,5] + (l(368)*y1*y2 + l(369)*y1*y3 + l(370)*w^2*y2 + l(371)*w^2*y3)*B0[1,6]);
if (pol != 0) { C = coef(pol, w*y1*y2*y3); for (u=1;u<=ncols(C);u++){ if (C[2,u] != 0) { nq++; EQ[nq] = C[2,u]; EQO[nq] = leadexp(C[1,u])[395]; EQT[nq] = "E_55[" + string(C[1,u]) + "]"; } } }
"nonzero coefficient equations (before removing duplicates):", nq, " ms:", rtimer-T0;
// remove duplicates up to a scalar, order by order (an order-m equation is a sum of products of
// coefficients whose w-orders add up to at most m, so equations of different orders are never proportional
// unless zero; we nevertheless dedup within each order only and report)
intvec nraw = 0:16; intvec nded = 0:16; ideal Im; ideal Imd; int m; int nd;
ideal EQD; intvec EQDO; list EQDT; nd = 0;
for (m=0; m<=15; m++) {
  Im = 0; int cnt = 0; list tg = list();
  for (u=1;u<=nq;u++){ if (EQO[u]==m) { cnt++; Im[cnt] = EQ[u]; tg[cnt] = EQT[u]; } }
  nraw[m+1] = cnt;
  if (cnt > 0) {
    // keep the first of each class of proportional equations
    intvec keep = 1:cnt;
    for (u=1;u<=cnt;u++) { if (keep[u]) { for (j=u+1;j<=cnt;j++) { if (keep[j]) { if (leadmonom(Im[j]) == leadmonom(Im[u])) { if (Im[j]*leadcoef(Im[u]) - Im[u]*leadcoef(Im[j]) == 0) { keep[j] = 0; } } } } } }
    for (u=1;u<=cnt;u++) { if (keep[u]) { nd++; EQD[nd] = Im[u]; EQDO[nd] = m; EQDT[nd] = tg[u]; nded[m+1] = nded[m+1] + 1; } }
    kill keep;
  }
  kill cnt; kill tg;
}
"nonzero coefficient equations per w-order 0..15:", nraw;
"distinct up to scalar per w-order 0..15:     ", nded;
"total distinct:", nd, " ms:", rtimer-T0;
// filtration check: every order-m equation has weighted degree <= m for the order weights of the unknowns
intvec OW = ORD, 0,0,0,0,0;
int bad = 0; for (u=1;u<=nd;u++) { if (deg(EQD[u], OW) > EQDO[u]) { bad++; } }
"equations violating the order filtration (should be 0):", bad;
proc cand(poly f, intvec SC, intvec ORD, int mmax)
{
  // best-scored unknown u (index <= 394, order <= mmax) with d f/d u a nonzero rational constant
  poly lin = jet(f, 1); int kk; int vi; int n = 0; intvec cv; poly tt;
  for (kk = 1; kk <= size(lin); kk++) {
    tt = lin[kk];
    if (deg(tt) == 1) { vi = rvar(leadmonom(tt)); if (vi >= 1) { if (vi <= 394) { if (ORD[vi] <= mmax) { n++; cv[n] = vi; } } } }
  }
  intvec res = 0, 0;
  if (n == 0) { return(res); }
  intvec tested = 0:n; int bi; int bs; int s;
  for (s = 1; s <= n; s++) {
    bi = 0; bs = 0;
    for (kk = 1; kk <= n; kk++) { if (tested[kk] == 0) { if (bi == 0 || SC[cv[kk]] < bs) { bi = kk; bs = SC[cv[kk]]; } } }
    tested[bi] = 1;
    if (deg(diff(f, var(cv[bi]))) == 0) { res = cv[bi], bs; return(res); }
  }
  return(res);
}
list TN = "lambda", "g", "b", "D";
ideal TRK = g(1), g(2), g(3), g(4), g(5), g(6), g(7), g(8), g(9), g(10), b(1), b(2), b(3), b(4), b(5), b(6), b(7), b(8), b(9), b(10), b(11), b(12), D, l(10), l(30), l(122), l(214), l(234), l(254), l(286), l(306), l(347), l(43), l(44), l(45), l(46), l(63), l(64), l(65), l(66), l(135), l(136), l(137), l(138), l(155), l(156), l(157), l(158), l(333), l(334), l(335), l(336), l(337);
list TRKN = "g1", "g2", "g3", "g4", "g5", "g6", "g7", "g8", "g9", "g10", "b1", "b2", "b3", "b4", "b5", "b6", "b7", "b8", "b9", "b10", "b11", "b12", "D", "lambda_11,0[w^6]", "lambda_12,0[w^6]", "lambda_22,0[w^6]", "lambda_33,0[w^6]", "lambda_34,0[w^6]", "lambda_35,0[w^7]", "lambda_44,0[w^6]", "lambda_45,0[w^7]", "lambda_55,0[w^8]", "lambda_13,0[y2^3]", "lambda_13,0[y2^2*y3]", "lambda_13,0[y2*y3^2]", "lambda_13,0[y3^3]", "lambda_14,0[y2^3]", "lambda_14,0[y2^2*y3]", "lambda_14,0[y2*y3^2]", "lambda_14,0[y3^3]", "lambda_23,0[y2^3]", "lambda_23,0[y2^2*y3]", "lambda_23,0[y2*y3^2]", "lambda_23,0[y3^3]", "lambda_24,0[y2^3]", "lambda_24,0[y2^2*y3]", "lambda_24,0[y2*y3^2]", "lambda_24,0[y3^3]", "lambda_55,0[y2^4]", "lambda_55,0[y2^3*y3]", "lambda_55,0[y2^2*y3^2]", "lambda_55,0[y2*y3^3]", "lambda_55,0[y3^4]";
execute(read("state_s1.txt"));
"state state_s1.txt loaded: remaining", ncols(LEFT), "; substitutions", size(SV0);
ideal E = LEFT; intvec EO = LEFTO;
E[ncols(LEFT)+1] = b(3); EO[ncols(LEFT)+1] = 99;
E[ncols(LEFT)+2] = b(8); EO[ncols(LEFT)+2] = 99;
intvec SV = SV0; ideal SE = SE0; intvec SST = SST0; int nel = size(SV0); TRK = TRK0;
"equations now:", size(E);
intvec ORDX = ORD;
// ---- s4_branch_i constant-pivot elimination, priority lambda_index
intvec SC; for (k=1;k<=394;k++) { SC[k] = k; }
int nE = ncols(E); intvec CV = 0:nE; intvec CS = 0:nE; intvec cvs;
int vb; int eb; int bs; poly piv; poly cc; poly ex; int pass = 0; int progress = 1; int ndiv;
for (u=1;u<=nE;u++) { if (E[u] != 0) { cvs = cand(E[u], SC, ORDX, 99); CV[u] = cvs[1]; CS[u] = cvs[2]; } }
while (progress) {
  pass++; progress = 0;
  while (1) {
    vb = 0; eb = 0; bs = 0;
    for (u=1;u<=nE;u++) { if (CV[u] > 0) { if (vb == 0 || CS[u] < bs) { vb = CV[u]; eb = u; bs = CS[u]; } } }
    if (vb == 0) { break; }
    piv = E[eb]; cc = diff(piv, var(vb));
    ex = var(vb) - piv/cc;
    E[eb] = 0; CV[eb] = 0;
    nel++; SV[nel] = vb; SE[nel] = ex; SST[nel] = 200 + pass;
    for (u=1;u<=nE;u++) {
      if (E[u] != 0) { if (diff(E[u], var(vb)) != 0) {
        E[u] = subst(E[u], var(vb), ex);
        if (E[u] != 0) { cvs = cand(E[u], SC, ORDX, 99); CV[u] = cvs[1]; CS[u] = cvs[2]; } else { CV[u] = 0; }
      } }
    }
    TRK = subst(TRK, var(vb), ex);
    if (nel mod 50 == 0) { "  eliminated", nel, "; equations left", size(E), "; ms:", rtimer-T0; }
  }
}
"s4_branch_i elimination finished: eliminated", nel, "; remaining equations", size(E), "; ms:", rtimer-T0;
// ---- result
intvec ISEL = 0:394; for (k=1;k<=nel;k++) { ISEL[SV[k]] = 1; }
intvec nelt = 0:4; intvec nfree = 0:4; string sfreeA = ""; string selA = "";
for (k=1;k<=394;k++) { if (ISEL[k]) { nelt[TYP[k]] = nelt[TYP[k]] + 1; if (TYP[k] > 1) { selA = selA + string(var(k)) + " "; } } else { nfree[TYP[k]] = nfree[TYP[k]] + 1; if (TYP[k] > 1) { sfreeA = sfreeA + string(var(k)) + " "; } } }
"eliminated unknowns by type (lambda, g, b, D):", nelt;
"eliminated A-unknowns:", selA;
"free unknowns by type (lambda, g, b, D):", nfree;
"free A-unknowns:", sfreeA;
string sfreeL = ""; for (k=1;k<=371;k++) { if (ISEL[k]==0) { sfreeL = sfreeL + string(var(k)) + " "; } } "free lambda-coefficients:", sfreeL;
int nleft = size(E); "remaining equations:", nleft;
int nz0 = 0; int nlin = 0; poly e0; poly tmpE; ideal lz = maxideal(1); for (k=1;k<=371;k++) { lz[k] = 0; }
map zl = R, lz;
for (u=1;u<=ncols(E);u++) { if (E[u] != 0) {
  if (deg(E[u], intvec(1:371)) > 1) { nlin++; }
  tmpE = E[u]; e0 = zl(tmpE);
  if (e0 != 0) { nz0++; }
} }
"remaining equations of degree > 1 in the lambda's:", nlin, "; with nonzero lambda-free part:", nz0;
int pr = 0;
for (u=1;u<=ncols(E);u++) { if (E[u] != 0) { pr++;
  "LEFT", pr, " (orig. order", EO[u], ", size", size(E[u]), "):";
  if (size(E[u]) <= 80) { factorize(E[u]); } else { "  too long to factorize; leading terms:", lead(E[u]); }
} }
// ---- tracked values (expressions in the free unknowns, modulo the remaining equations)
"tracked list consistent:", ncols(TRK) == size(TRKN);
for (k=1;k<=ncols(TRK);k++) { if (size(TRK[k]) <= 60) { TRKN[k], "=", TRK[k]; } else { TRKN[k], "= (", size(TRK[k]), "terms ) lead", lead(TRK[k]); } }
ideal J; int nj = 0; for (u=1;u<=ncols(E);u++) { if (E[u] != 0) { nj++; J[nj] = E[u]; } }
// ---- F2 point (1:0:...:0): conditions b7 = b10 = 0 and pure w-power coefficient of every lambda_{ij,0} = 0
ideal TV = TRK[17], TRK[20], TRK[24..32]; list TVN = TRKN[17], TRKN[20], TRKN[24..32];
for (k=1;k<=ncols(TV);k++) { TVN[k], "=", TV[k]; }
"all F2 conditions identically 0 after substitution:", size(TV) == 0;
if (size(TV) > 0) {
  if (nj > 0) { int T1 = rtimer; ideal SJ = std(J); "std of remaining equations: ms", rtimer-T1, "; 1 in it:", reduce(poly(1), SJ) == 0;
    ideal NTV = reduce(TV, SJ); "normal forms of the F2 conditions modulo the branch ideal:"; NTV;
    "all F2 conditions in the branch ideal:", size(NTV) == 0; }
}
"total ms:", rtimer-T0, "; memory (KB) in use / allocated:", memory(1) div 1024, memory(2) div 1024;
quit;
