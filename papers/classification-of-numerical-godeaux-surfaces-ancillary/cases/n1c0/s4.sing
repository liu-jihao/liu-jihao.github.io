poly q3 = b(7)*y0^2 + b(8)*y0*y1 + b(9)*y1^2;
poly q4 = b(10)*y0^2 + b(11)*y2*y3 + b(12)*y3^2;
poly Q = y2^2 - D*y3^2 - y1^2;
matrix A[6][6] =
  y0*G, w*q1, w*q2, w*q3, w*q4, Q,
