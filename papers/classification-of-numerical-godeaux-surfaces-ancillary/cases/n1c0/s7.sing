poly y0 = w^2;
poly G = g(1)*y3^3 + g(2)*y1^2*y3 + g(3)*y2*y3^2 + g(4)*y1^2*y2 + g(5)*y2^2*y3 + g(6)*y2^3 + g(7)*y0*y1*y3 + g(8)*y0*y1*y2 + g(9)*y0^2*y3 + g(10)*y0^2*y2;
poly q1 = b(1)*y1*y2 + b(2)*y1*y3;
poly q2 = b(3)*y0*y2 + b(4)*y0*y3 + b(5)*y1*y2 + b(6)*y1*y3;
poly q3 = b(7)*y0^2 + b(8)*y0*y1 + b(9)*y1^2;
poly q4 = b(10)*y0^2 + b(11)*y2*y3 + b(12)*y3^2;
poly Q = y2^2 - D*y3^2 - y1^2;
matrix A[6][6] =
  y0*G, w*q1, w*q2, w*q3, w*q4, Q,
  w*q1, D*y3, y2,   y1,   0,    w,
  w*q2, y2,   y3,   0,    y1,   0,
  w*q3, y1,   0,    -y3,  y2,   0,
  w*q4, 0,    y1,   y2,   -D*y3, 0,
  Q,    w,    0,    0,    0,    0;
"A symmetric:", A == transpose(A);
proc cofac(matrix M, int rr, int cc) { matrix S5[5][5]; int a, bb, p, q; a = 0; for (p=1; p<=6; p++) { if (p != rr) { a++; bb = 0; for (q=1; q<=6; q++) { if (q != cc) { bb++; S5[a,bb] = M[p,q]; } } } } return((-1)^(rr+cc) * det(S5)); }
