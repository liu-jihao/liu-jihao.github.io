// n2, c = 1: mod-32003 tangent check at random points of the solution scheme (state n2c1_stage_state.ssi); generated by gen_n2_modp.py
system("--ticks-per-sec", 1000); int T0 = rtimer; LIB "matrix.lib";
ring R = 0, (l(1..371), g(1..10), b(1..12), w, y1, y2, y3), dp;
< "n2_defs.sing";
link LE = "ssi:r n2c1_eqs.ssi"; def S = read(LE); close(LE); list EQS = S[1]; kill S;
link LS = "ssi:r n2c1_stage_state.ssi"; def ST = read(LS); close(LS); ideal IMG = ST[1]; intvec ELIMAT = ST[2]; ideal LEFT = ST[4]; kill ST;
"equations:", size(EQS), "; leftover equations in the state:", size(simplify(LEFT,2));
ring RP = 32003, (l(1..371), g(1..10), b(1..12), w, y1, y2, y3), dp;
list EQS = fetch(R, EQS); ideal IMG = fetch(R, IMG); int u; int v;
ideal EI; for (u = 1; u <= size(EQS); u++) { EI[u] = EQS[u]; }
matrix J = jacob(EI); "Jacobian:", nrows(J), "x", ncols(J), "; ms:", rtimer-T0;
int nfree = 0; int nfA = 0; for (v = 1; v <= 393; v++) { if (ELIMAT[v] == 0) { nfree++; if (TYP[v] == 0) { nfA++; } } }
"free unknowns:", nfree, "; free A-coefficients:", nfA;
