// n2: normalization of the q's (PLAN A6, nets T7 for N2), exact symbolic check.
// Full A with general G (10 coefficients) and all 20 q-coefficients, c symbolic; change of generators
// v_j -> v_j - w*u_j (j=2,3,4), v5 -> v5 - y0*u5, i.e. A' = M^T A M with M = I + sum_j w*u_j*E_{j0} + y0*u5*E_{50}.
system("--ticks-per-sec", 1000); int T0 = rtimer;
ring R = (0,c), (p0,p1,r2,r3,s2,s3,t2,t3, g(1..10), e(1..20), w, y1, y2, y3), dp;
poly y0 = w^2;
poly G = g(1)*y3^3 + g(2)*y1^2*y3 + g(3)*y2*y3^2 + g(4)*y1^2*y2 + g(5)*y2^2*y3 + g(6)*y2^3 + g(7)*y0*y1*y3 + g(8)*y0*y1*y2 + g(9)*y0^2*y3 + g(10)*y0^2*y2;
poly q1 = e(1)*y0*y2 + e(2)*y0*y3 + e(3)*y1*y2 + e(4)*y1*y3;
poly q2 = e(5)*y0*y2 + e(6)*y0*y3 + e(7)*y1*y2 + e(8)*y1*y3;
poly q3 = e(9)*y0^2 + e(10)*y0*y1 + e(11)*y1^2 + e(12)*y2^2 + e(13)*y2*y3 + e(14)*y3^2;
poly q4 = e(15)*y0^2 + e(16)*y0*y1 + e(17)*y1^2 + e(18)*y2^2 + e(19)*y2*y3 + e(20)*y3^2;
poly Q = y2*y3 - y1^2;
matrix A[6][6] =
  y0*G, w*q1, w*q2, w*q3, w*q4, Q,
  w*q1, y2,   0,    y1,   0,    w,
  w*q2, 0,    y3,   c*y0, y1,   0,
  w*q3, y1,   c*y0, y3,   0,    0,
  w*q4, 0,    y1,   0,    y2,   0,
  Q,    w,    0,    0,    0,    0;
poly u2 = p0*y0 + p1*y1; poly u3 = r2*y2 + r3*y3; poly u4 = s2*y2 + s3*y3; poly u5 = t2*y2 + t3*y3;
matrix M[6][6]; int i; int j; for (i = 1; i <= 6; i++) { M[i,i] = 1; }
M[3,1] = w*u2; M[4,1] = w*u3; M[5,1] = w*u4; M[6,1] = y0*u5;
matrix A2 = transpose(M)*A*M;
int ok = 1; for (i = 2; i <= 6; i++) { for (j = 2; j <= 6; j++) { if (A2[i,j] != A[i,j]) { ok = 0; } } }
"rows/columns 1..5 unchanged (net, alpha', column 5, A_55):", ok, "; A_05 = Q unchanged:", A2[1,6] == A[1,6];
// delta q_k = sum_{j=2..4} u_j a_jk + delta_{k1} y0 u5
list U = u2, u3, u4; int okq = 1; poly dq;
for (j = 2; j <= 5; j++) { dq = 0; for (i = 1; i <= 3; i++) { dq = dq + U[i]*A[i+2, j]; } if (j == 2) { dq = dq + y0*u5; } if (A2[1,j] - A[1,j] != w*dq) { okq = 0; } }
"delta q_k = sum_j u_j a_jk + delta_{k1} y0 u5:", okq;
poly dG = (A2[1,1] - A[1,1]) / y0; "A'_00 - A_00 divisible by y0:", A2[1,1] - A[1,1] == y0*dG;
"delta G - (2 sum u_j q_j + sum u_a u_b a_ab + 2 u5 Q) =", dG - (2*(u2*q2 + u3*q3 + u4*q4) + 2*u5*Q + u2*u2*A[3,3] + u3*u3*A[4,4] + u4*u4*A[5,5] + 2*u2*u3*A[3,4] + 2*u2*u4*A[3,5] + 2*u3*u4*A[4,5]);
// killed coefficients for N2: q1 {y0y2, y0y3, y1y2, y1y3}, q4 {y0y1, y1^2, y2^2, y2y3}
poly D1 = (A2[1,2] - A[1,2]) / w; poly D4 = (A2[1,5] - A[1,5]) / w;
matrix C1 = coef(D1, w*y1*y2*y3); matrix C4 = coef(D4, w*y1*y2*y3);
"delta q1 =", D1; "delta q4 =", D4;
"delta q2 =", (A2[1,3] - A[1,3]) / w; "delta q3 =", (A2[1,4] - A[1,4]) / w;
list KM = list(1, w^2*y2), list(1, w^2*y3), list(1, y1*y2), list(1, y1*y3), list(4, w^2*y1), list(4, y1^2), list(4, y2^2), list(4, y2*y3);
proc cf(poly f, poly mon) { matrix C = coef(f, w*y1*y2*y3); int k; for (k = 1; k <= ncols(C); k++) { if (C[1,k] == mon) { return(C[2,k]); } } return(poly(0)); }
matrix J8[8][8]; ideal pv = p0, p1, r2, r3, s2, s3, t2, t3; poly ck;
for (i = 1; i <= 8; i++) { if (KM[i][1] == 1) { ck = cf(D1, KM[i][2]); } else { ck = cf(D4, KM[i][2]); } for (j = 1; j <= 8; j++) { J8[i,j] = diff(ck, pv[j]); } }
"8x8 matrix (rows: killed q1 y0y2, y0y3, y1y2, y1y3, q4 y0y1, y1^2, y2^2, y2y3; columns p0,p1,r2,r3,s2,s3,t2,t3):"; print(J8);
"determinant:", det(J8);
"ms:", rtimer-T0;
quit;
