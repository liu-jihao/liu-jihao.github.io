// tiny syntax test of the Singular features used in the n2 scripts (no mathematics)
ring R = 0, (l(1..3), g(1..2), w, y1), dp;
poly f = 3*l(2) + l(1)*g(1) + 5 + g(2);
ideal vv = variables(f - jet(f,1));
vv;
rvar(leadmonom(3*l(2)));
rvar(g(2));
ideal I = f, l(1)^2;
link L = "ssi:w t0.ssi"; write(L, I); close(L);
link L2 = "ssi:r t0.ssi"; def J = read(L2); close(L2);
J;
typeof(J);
intvec iv = 1,2,3; list LL = I, iv;
link L3 = "ssi:w t0b.ssi"; write(L3, LL); close(L3);
link L4 = "ssi:r t0b.ssi"; def LL2 = read(L4); close(L4);
LL2[2];
memory(2);
system("--ticks-per-sec", 1000); int T0 = rtimer; rtimer - T0;
matrix C = coef(w^2*y1 + 3*w*y1^2*l(1), w*y1); C; leadexp(C[1,1]);
quit;
