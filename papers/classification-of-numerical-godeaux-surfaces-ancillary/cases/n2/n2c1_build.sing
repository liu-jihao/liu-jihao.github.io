CF = coef(pol, w*y1*y2*y3); for (u=1; u<=ncols(CF); u++) { ev = leadexp(CF[1,u]); if (ev[394] + 2*(ev[395]+ev[396]+ev[397]) != 14 || (-1)^(ev[394]+ev[396]+ev[397]) != 1) { badw++; } ne++; EQ[ne] = CF[2,u]; EO[ne] = ev[394]; ET[ne] = "E13[" + string(CF[1,u]) + "]"; }
pol = B[2,5] - ((l(61)*y3^3 + l(62)*y2*y3^2 + l(63)*y2^2*y3 + l(64)*y2^3 + l(65)*y1^2*y3 + l(66)*y1^2*y2 + l(67)*w^2*y1*y3 + l(68)*w^2*y1*y2 + l(69)*w^4*y3 + l(70)*w^4*y2)*B[1,1] + (l(71)*w*y3 + l(72)*w*y2)*B[1,2] + (l(73)*w*y3 + l(74)*w*y2)*B[1,3] + (l(75)*w*y1 + l(76)*w^3)*B[1,4] + (l(77)*w*y1 + l(78)*w^3)*B[1,5] + (l(79)*y1 + l(80)*w^2)*B[1,6]);
