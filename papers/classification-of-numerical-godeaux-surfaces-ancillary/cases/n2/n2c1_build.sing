pol = B[5,6] - ((l(297)*w*y1*y3^2 + l(298)*w*y1*y2*y3 + l(299)*w*y1*y2^2 + l(300)*w*y1^3 + l(301)*w^3*y3^2 + l(302)*w^3*y2*y3 + l(303)*w^3*y2^2 + l(304)*w^3*y1^2 + l(305)*w^5*y1 + l(306)*w^7)*B[1,1] + (l(307)*y3^2 + l(308)*y2*y3 + l(309)*y2^2 + l(310)*y1^2 + l(311)*w^2*y1 + l(312)*w^4)*B[1,2] + (l(313)*y3^2 + l(314)*y2*y3 + l(315)*y2^2 + l(316)*y1^2 + l(317)*w^2*y1 + l(318)*w^4)*B[1,3] + (l(319)*y1*y3 + l(320)*y1*y2 + l(321)*w^2*y3 + l(322)*w^2*y2)*B[1,4] + (l(323)*y1*y3 + l(324)*y1*y2 + l(325)*w^2*y3 + l(326)*w^2*y2)*B[1,5] + (l(327)*w*y3 + l(328)*w*y2)*B[1,6]);
CF = coef(pol, w*y1*y2*y3); for (u=1; u<=ncols(CF); u++) { ev = leadexp(CF[1,u]); if (ev[394] + 2*(ev[395]+ev[396]+ev[397]) != 15 || (-1)^(ev[394]+ev[396]+ev[397]) != 1) { badw++; } ne++; EQ[ne] = CF[2,u]; EO[ne] = ev[394]; ET[ne] = "E45[" + string(CF[1,u]) + "]"; }
pol = B[6,6] - ((l(329)*y3^4 + l(330)*y2*y3^3 + l(331)*y2^2*y3^2 + l(332)*y2^3*y3 + l(333)*y2^4 + l(334)*y1^2*y3^2 + l(335)*y1^2*y2*y3 + l(336)*y1^2*y2^2 + l(337)*y1^4 + l(338)*w^2*y1*y3^2 + l(339)*w^2*y1*y2*y3 + l(340)*w^2*y1*y2^2 + l(341)*w^2*y1^3 + l(342)*w^4*y3^2 + l(343)*w^4*y2*y3 + l(344)*w^4*y2^2 + l(345)*w^4*y1^2 + l(346)*w^6*y1 + l(347)*w^8)*B[1,1] + (l(348)*w*y3^2 + l(349)*w*y2*y3 + l(350)*w*y2^2 + l(351)*w*y1^2 + l(352)*w^3*y1 + l(353)*w^5)*B[1,2] + (l(354)*w*y3^2 + l(355)*w*y2*y3 + l(356)*w*y2^2 + l(357)*w*y1^2 + l(358)*w^3*y1 + l(359)*w^5)*B[1,3] + (l(360)*w*y1*y3 + l(361)*w*y1*y2 + l(362)*w^3*y3 + l(363)*w^3*y2)*B[1,4] + (l(364)*w*y1*y3 + l(365)*w*y1*y2 + l(366)*w^3*y3 + l(367)*w^3*y2)*B[1,5] + (l(368)*y1*y3 + l(369)*y1*y2 + l(370)*w^2*y3 + l(371)*w^2*y2)*B[1,6]);
CF = coef(pol, w*y1*y2*y3); for (u=1; u<=ncols(CF); u++) { ev = leadexp(CF[1,u]); if (ev[394] + 2*(ev[395]+ev[396]+ev[397]) != 16 || (-1)^(ev[394]+ev[396]+ev[397]) != -1) { badw++; } ne++; EQ[ne] = CF[2,u]; EO[ne] = ev[394]; ET[ne] = "E55[" + string(CF[1,u]) + "]"; }
"coefficient equations (nonzero monomial coefficients of E_ij):", ne, "; monomials of wrong weight/sign:", badw, " ms:", rtimer-T0;
intvec cnt0 = 0:16; for (u=1; u<=ne; u++) { cnt0[EO[u]+1] = cnt0[EO[u]+1] + 1; }
"nonzero coefficient equations by w-order 0..15:", cnt0;
list KE; intvec KO; list KT; int nk = 0; int m; int dup; int vv; poly p;
for (m=0; m<=15; m++) { for (u=1; u<=ne; u++) { if (EO[u] == m) { if (EQ[u] != 0) { p = EQ[u] / leadcoef(EQ[u]); dup = 0; for (vv=1; vv<=nk; vv++) { if (size(KE[vv]) == size(p)) { if (KE[vv] == p) { dup = 1; break; } } } if (dup == 0) { nk++; KE[nk] = p; KO[nk] = m; KT[nk] = ET[u]; } } } } }
intvec cnt1 = 0:16; for (u=1; u<=nk; u++) { cnt1[KO[u]+1] = cnt1[KO[u]+1] + 1; }
"distinct equations up to scalar (lowest order kept):", nk;
"distinct equations by w-order 0..15:", cnt1;
int nconst = 0; for (u=1; u<=nk; u++) { if (deg(KE[u]) <= 0) { nconst++; } } "constant (inconsistent) equations:", nconst;
link LE = "ssi:w n2c1_eqs.ssi"; write(LE, list(KE, KO, KT)); close(LE);
"saved n2c1_eqs.ssi; memory MB:", memory(2) div 1048576, " ms:", rtimer-T0;
quit;
