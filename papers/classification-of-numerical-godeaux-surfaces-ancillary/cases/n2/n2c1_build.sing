// n2, c = 1: build the rank-condition coefficient equations (generated by gen_n2.py)
system("--ticks-per-sec", 1000); int T0 = rtimer;
ring R0 = 0, (g(1..10), b(1..12), w, y1, y2, y3), dp;
poly y0 = w^2;
poly G = g(1)*y3^3 + g(2)*y1^2*y3 + g(3)*y2*y3^2 + g(4)*y1^2*y2 + g(5)*y2^2*y3 + g(6)*y2^3 + g(7)*y0*y1*y3 + g(8)*y0*y1*y2 + g(9)*y0^2*y3 + g(10)*y0^2*y2;
poly q1 = 0;
poly q2 = b(1)*y0*y2 + b(2)*y0*y3 + b(3)*y1*y2 + b(4)*y1*y3;
poly q3 = b(5)*y0^2 + b(6)*y0*y1 + b(7)*y1^2 + b(8)*y2^2 + b(9)*y2*y3 + b(10)*y3^2;
poly q4 = b(11)*y0^2 + b(12)*y3^2;
poly Q = y2*y3 - y1^2;
poly cc = 1;
matrix A[6][6] =
  y0*G, w*q1, w*q2, w*q3, w*q4, Q,
  w*q1, y2,   0,    y1,   0,    w,
  w*q2, 0,    y3,   cc*y0, y1,  0,
  w*q3, y1,   cc*y0, y3,  0,    0,
  w*q4, 0,    y1,   0,    y2,   0,
  Q,    w,    0,    0,    0,    0;
"A symmetric:", A == transpose(A);
proc cofac(matrix M, int rr, int cc0) { matrix S5[5][5]; int a, bb, p, q; a = 0; for (p=1; p<=6; p++) { if (p != rr) { a++; bb = 0; for (q=1; q<=6; q++) { if (q != cc0) { bb++; S5[a,bb] = M[p,q]; } } } } return((-1)^(rr+cc0) * det(S5)); }
matrix B[6][6]; int i, j, k, u;
for (k=1; k<=6; k++) { B[1,k] = cofac(A,k,1); }       // B[1,k] = adj(A)_{0,k-1} (row 0 cofactors)
for (i=2; i<=6; i++) { for (j=i; j<=6; j++) { B[i,j] = cofac(A,j,i); } }
"cofactors done, ms:", rtimer-T0;
"symmetry check B[2,3] = cofactor(2,3):", B[2,3] == cofac(A,2,3), "; B[1,4] = cofactor(1,4):", B[1,4] == cofac(A,1,4);
matrix al[4][4]; matrix aa[4][4]; for (i=1;i<=4;i++) { for (j=1;j<=4;j++) { aa[i,j] = A[i+1,j+1]; al[i,j] = subst(A[i+1,j+1], w, 0); } }
"net alpha (w=0):"; print(al);
"det(alpha) - Q^2 =", det(al) - Q^2;
proc cof4(matrix M, int rr, int cc0) { matrix S3[3][3]; int a, bb, p, q; a = 0; for (p=1; p<=4; p++) { if (p != rr) { a++; bb = 0; for (q=1; q<=4; q++) { if (q != cc0) { bb++; S3[a,bb] = M[p,q]; } } } } return((-1)^(rr+cc0) * det(S3)); }
matrix adjal[4][4]; int okQ = 1; for (i=1;i<=4;i++) { for (j=1;j<=4;j++) { adjal[i,j] = cof4(al,j,i); if (reduce(adjal[i,j], std(ideal(Q))) != 0) { okQ = 0; } } }
"Q divides every entry of adj(alpha):", okQ;
"adj(alpha)/Q:"; matrix NQ[4][4]; for (i=1;i<=4;i++) { for (j=1;j<=4;j++) { NQ[i,j] = adjal[i,j] / Q; } } print(NQ);
"delay B_05: B_05(w=0) - Q^3 =", subst(B[1,6], w, 0) - Q^3, "; B_05(w=0) + Q^3 =", subst(B[1,6], w, 0) + Q^3;
for (k=1; k<=4; k++) { poly b0 = subst(B[1,k+1], w, 0); poly b1 = subst(diff(B[1,k+1], w), w, 0); "delay B_0" + string(k) + ": w^0 part =", b0, "; (w^1 coefficient) - Q*adj(alpha)_{k1} =", b1 - Q*adjal[k,1], "; (w^1 coefficient) + Q*adj(alpha)_{k1} =", b1 + Q*adjal[k,1]; kill b0, b1; }
"delay B_00: B_00 + y0*adj(a)_{11} =", B[1,1] + y0*cof4(aa,1,1), "  (a = alpha + c*y0*alpha', exact)";
"B_00 involves no unknown (g, b):", B[1,1] == subst(B[1,1], g(1),0,g(2),0,g(3),0,g(4),0,g(5),0,g(6),0,g(7),0,g(8),0,g(9),0,g(10),0,b(1),0,b(2),0,b(3),0,b(4),0,b(5),0,b(6),0,b(7),0,b(8),0,b(9),0,b(10),0,b(11),0,b(12),0);
poly detA = det(A);
"det A computed; terms:", size(detA), " ms:", rtimer-T0;
"det A at w=0 plus Q^2*det(alpha) =", subst(detA, w, 0) + Q^2*det(al);
link LA = "ssi:w n2c1_A.ssi"; write(LA, list(A, B, detA)); close(LA);
ring R = 0, (l(1..371), g(1..10), b(1..12), w, y1, y2, y3), dp;
matrix B = imap(R0, B); matrix A = imap(R0, A);
list EQ; intvec EO; list ET; int ne = 0; poly pol; matrix CF; intvec ev; int badw = 0;
pol = B[2,2] - ((l(1)*y1*y3^2 + l(2)*y1*y2*y3 + l(3)*y1*y2^2 + l(4)*y1^3 + l(5)*w^2*y3^2 + l(6)*w^2*y2*y3 + l(7)*w^2*y2^2 + l(8)*w^2*y1^2 + l(9)*w^4*y1 + l(10)*w^6)*B[1,1] + (l(11)*w*y1 + l(12)*w^3)*B[1,2] + (l(13)*w*y1 + l(14)*w^3)*B[1,3] + (l(15)*w*y3 + l(16)*w*y2)*B[1,4] + (l(17)*w*y3 + l(18)*w*y2)*B[1,5] + (l(19)*y3 + l(20)*y2)*B[1,6]);
