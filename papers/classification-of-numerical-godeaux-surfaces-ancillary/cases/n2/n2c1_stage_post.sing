"monomials of a translation outside the lambda ansatz:", bad;
"rank of the trivial-syzygy translation map (371 x 94), exact over Q:", rank(MS), "; ms:", rtimer-T0;
setring R;
"--- torus: diagonal changes preserving the normal form";
ring RW = 0, (W, Y1, Y2, Y3, P0, P1, P2, P3, P4, P5), dp;
ideal TW = P0 + P5 + Y2 + Y3, P0 + P5 + 2*Y1, P1 + P5 + W, 2*P1 + Y2, P1 + P3 + Y1, 2*P2 + Y3, P2 + P4 + Y1, 2*P3 + Y3, 2*P4 + Y2, P2 + P3 + 2*W;
"conditions (entry: monomial):", "(0,5) Q: y2*y3; (0,5) Q: y1^2; (1,5) w; (1,1) y2; (1,3) y1; (2,2) y3; (2,4) y1; (3,3) y3; (4,4) y2; (2,3) c*y0";
ideal STW = std(TW); "dimension of the solution space of the log-weight system:", 10 - size(STW) , " (= number of variables minus rank)";
"reduced basis of the linear conditions:"; STW;
"direction grading [1, 2, 2, 2, -4, -1, -1, -1, -1, 0] satisfies the conditions:", size(simplify(subst(TW, W, 1, Y1, 2, Y2, 2, Y3, 2, P0, -4, P1, -1, P2, -1, P3, -1, P4, -1, P5, 0), 2)) == 0;
"direction tau2 [0, 1, 2, 0, -3, -1, 0, 0, -1, 1] satisfies the conditions:", size(simplify(subst(TW, W, 0, Y1, 1, Y2, 2, Y3, 0, P0, -3, P1, -1, P2, 0, P3, 0, P4, -1, P5, 1), 2)) == 0;
