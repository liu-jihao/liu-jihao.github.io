system("--ticks-per-sec", 1000); int T0 = rtimer;
ring R = 0, (l(1..371), g(1..10), b(1..12), w, y1, y2, y3), dp;
< "n2_defs.sing";
link LE = "ssi:r n2c1_eqs.ssi"; def S = read(LE); close(LE); list EQS = S[1]; intvec EQO = S[2]; list EQT = S[3]; int NEQ = size(EQS); kill S;
