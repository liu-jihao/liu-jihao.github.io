int u; int v; int k; int nfa = 0; int nfl = 0; string sfa = "";
for (v = 1; v <= 393; v++) { if (ELIMAT[v] == 0) { if (TYP[v] == 1) { nfl++; } else { nfa++; sfa = sfa + string(var(v)) + " "; } } }
int nleft = size(simplify(LEFT, 2)); "equations left:", nleft, "; free lambda:", nfl, "; free A:", nfa, ":", sfa;
"--- graph check: eliminated g, b as polynomials in the free unknowns";
int okg = 1; ideal vv; string GR; write(":w n2c1_stage_graph.txt", "// n2, c = 1: eliminated A-coefficients in terms of the free ones (from n2c1_stage_state.ssi)");
