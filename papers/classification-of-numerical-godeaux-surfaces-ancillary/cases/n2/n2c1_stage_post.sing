"graph check (no lambda-coefficient in any eliminated g, b):", okg;
"--- substitution of the parametrization into all equations";
ideal EI; for (u = 1; u <= NEQ; u++) { EI[u] = EQS[u]; }
map ph = R, IMG; ideal EV = ph(EI); int nz = 0; for (u = 1; u <= NEQ; u++) { if (EV[u] != 0) { nz++; } }
"equations not identically zero after substitution:", nz, "of", NEQ, "; ms:", rtimer-T0;
"--- syzygy check at a random rational point (free A-coefficients random; eliminated ones from the graph)";
ideal PT = maxideal(1);
intvec RV = -5,-7,-1,-6,7,6,7,4,-3,-6,7,-9,4,5,-9,6,-1,-2,-6,2,-9,-9;
for (v = 372; v <= 393; v++) { if (ELIMAT[v] == 0) { PT[v] = RV[v-371]; } }
