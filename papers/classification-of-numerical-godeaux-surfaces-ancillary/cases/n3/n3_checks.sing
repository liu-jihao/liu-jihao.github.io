// n3_checks.sing (generated by gen_n3_checks.py). Needs n3_build.sing and n3_final.sing (from n3_elim.sing).
system("--ticks-per-sec", 1000); int T0 = rtimer;
LIB "matrix.lib";
< "n3_build.sing";
// distinct nonzero coefficient equations, as in n3_elim.sing
list DE; intvec DEO; intvec DSZ; int nd = 0; int found; poly fn; int m; int t2;
for (m=0; m<=15; m++) { for (u=1; u<=nEQ; u++) { if (EQO[u] == m) { fn = EQ[u] / leadcoef(EQ[u]); found = 0;
  for (t2=1; t2<=nd; t2++) { if (DSZ[t2] == size(fn)) { if (DE[t2] == fn) { found = 1; break; } } }
  if (found == 0) { nd++; DE[nd] = fn; DEO[nd] = m; DSZ[nd] = size(fn); } } } }
ideal IDR; for (u=1;u<=nd;u++){ IDR[u] = DE[u]; }
"distinct equations:", nd;
ring S = 0, (lam(1..371), g(1..10), b(1..12)), dp;
ideal ID = imap(R, IDR);
ideal FIN = maxideal(1);
< "n3_final.sing";
< "n3_free.txt";
"free unknowns:", size(FREEV);
proc mkpoint(int seed, intvec FREEV, ideal FIN)
{
  // random nonzero integers in [-20,20] for the free unknowns; the others from FIN (exact rationals)
  system("random", seed); ideal V = maxideal(1); int ii; int x;
  for (ii=1; ii<=size(FREEV); ii++) { x = 0; while (x == 0) { x = random(-20, 20); } V[FREEV[ii]] = x; }
  map ev = basering, V; ideal PT = ev(FIN);
  return(PT);
}
ideal PT1 = mkpoint(20261109, FREEV, FIN);
"point 1 (free unknowns):"; string sp = ""; for (u=1;u<=size(FREEV);u++){ sp = sp + string(var(FREEV[u])) + "=" + string(PT1[FREEV[u]]) + " "; } sp;
"point 1 (all g, b):"; sp = ""; for (u=372;u<=393;u++){ sp = sp + string(var(u)) + "=" + string(PT1[u]) + " "; } sp;
map ev1 = S, PT1; ideal Z1 = ev1(ID); "(a) exact: equations not vanishing at point 1:", size(simplify(Z1, 2)), "of", ncols(ID);
setring R;
ideal PT1R = imap(S, PT1);
ideal VR = maxideal(1); for (u=1;u<=393;u++){ VR[u] = PT1R[u]; }   // w, y1, y2, y3 fixed
map evR = R, VR; matrix AP = evR(A);
"A at point 1:"; print(AP);
// exact check of E_ij = 0 as polynomials in w, y at point 1
matrix BP0[1][6]; for (k=1;k<=6;k++){ BP0[1,k] = cofac(AP,1,k); } matrix LP = evR(LAMB); int nbadE = 0;
for (p=1;p<=15;p++){ pol = cofac(AP, PI[p]+1, PJ[p]+1); for (k=1;k<=6;k++){ pol = pol - LP[p,k]*BP0[1,k]; } if (pol != 0) { nbadE++; } }
"(a) exact: pairs (i,j) with E_ij != 0 at point 1:", nbadE;
poly dA = det(AP); "det A at point 1 is nonzero:", dA != 0, "; terms:", size(dA);
proc lamform(poly h, poly Lz)
{
  if (h == 0) { return(poly(0)); }
  matrix Ch = coef(h, w*y1*y2*y3); matrix CL = coef(Lz, w*y1*y2*y3); poly res = 0; int a, bb, fnd;
  for (a=1; a<=ncols(Ch); a++) { fnd = 0; for (bb=1; bb<=ncols(CL); bb++) { if (Ch[1,a] == CL[1,bb]) { res = res + Ch[2,a]*CL[2,bb]; fnd = 1; break; } }
    if (fnd == 0) { "ERROR: monomial outside the lambda ansatz:", Ch[1,a]; } }
  return(res);
}
ideal SYZF; poly hh; poly mu; int col = 0;
col++; mu = w; SYZF[col] = 0; for (k=1;k<=6;k++){ hh = mu*AP[4,k]; SYZF[col] = SYZF[col] + lamform(hh, LAMB[1,k]); }
col++; mu = w; SYZF[col] = 0; for (k=1;k<=6;k++){ hh = mu*AP[5,k]; SYZF[col] = SYZF[col] + lamform(hh, LAMB[1,k]); }
