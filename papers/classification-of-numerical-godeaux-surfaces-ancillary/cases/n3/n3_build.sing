poly Q = y2^2 - y1^2;
matrix A[6][6] = y0*G, w*q1, w*q2, w*q3, w*q4, Q,
                 w*q1, y3, y2, y1, 0, w,
                 w*q2, y2, 0, y0, y1, 0,
                 w*q3, y1, y0, 0, y2, 0,
                 w*q4, 0, y1, y2, -y3, 0,
                 Q, w, 0, 0, 0, 0;
proc cofac(matrix M, int rr, int cc) { matrix S5[5][5]; int a, bb, p, q; a = 0; for (p=1; p<=6; p++) { if (p != rr) { a++; bb = 0; for (q=1; q<=6; q++) { if (q != cc) { bb++; S5[a,bb] = M[p,q]; } } } } return((-1)^(rr+cc) * det(S5)); }
