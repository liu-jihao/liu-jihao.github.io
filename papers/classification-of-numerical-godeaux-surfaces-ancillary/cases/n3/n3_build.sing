// Ring R: unknowns lam(1..371), g(1..10), b(1..12) (indices 1..393), then w, y1, y2, y3 (394..397).
ring R = 0, (lam(1..371), g(1..10), b(1..12), w, y1, y2, y3), dp;
poly y0 = w^2;
poly G = g(1)*y3^3 + g(2)*y1^2*y3 + g(3)*y2*y3^2 + g(4)*y1^2*y2 + g(5)*y2^2*y3 + g(6)*y2^3 + g(7)*y0*y1*y3 + g(8)*y0*y1*y2 + g(9)*y0^2*y3 + g(10)*y0^2*y2;
