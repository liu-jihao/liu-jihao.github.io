proc wset(poly f, int K)
{
  // weights (s-exponent - K*z-exponent) of the terms of f, returned as intvec of distinct values
  intvec ws; int nw = 0; int ii, jj, wt, fnd; intvec ex;
  for (ii=1; ii<=size(f); ii++) { ex = leadexp(f[ii]); wt = ex[394] - K*ex[395]; fnd = 0; for (jj=1;jj<=nw;jj++){ if (ws[jj] == wt) { fnd = 1; } } if (fnd == 0) { nw++; ws[nw] = wt; } }
  return(ws);
}
