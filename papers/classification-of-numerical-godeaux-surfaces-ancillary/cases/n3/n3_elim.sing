// n3_elim.sing -- case n3: normal form N3 (orbit B1, distinguished generator special), c = 1.
// 1. build the rank-condition system E_ij = B_ij - sum_k lambda_{ij,k} B_0k (n3_build.sing, generated by gen_n3.py);
// 2. print the leading terms (delays) of the row-0 cofactors;
// 3. equation counts per w-order; removal of zero equations and duplicates up to a scalar;
// 4. order-by-order constant-pivot elimination (stages m = 0..15; pivots: lambda first, then highest w-order,
//    then smallest index; ties: shortest equation), with a log per stage and the obstructions;
// 5. global re-run (smallest index first = all lambda first) if equations remain;
// 6. back-substitution, graph check, exact substitution check, files n3_final.sing and n3_subs.txt.
system("--ticks-per-sec", 1000); int T0 = rtimer;
< "n3_build.sing";
"== system built; ms:", rtimer - T0;
"nonzero coefficient equations (monomial slots with nonzero coefficient):", nEQ, "; weight/sign violations:", badhom;

// ---------------- 2. leading terms of the row-0 cofactors ----------------
matrix al[4][4]; matrix aa[4][4]; int s, t2;
for (s=1;s<=4;s++){ for (t2=1;t2<=4;t2++){ aa[s,t2] = A[s+1,t2+1]; al[s,t2] = subst(A[s+1,t2+1], w, 0); } }
"net alpha (rows/columns v1..v4, w = 0):"; print(al);
"det(alpha) - Q^2 =", det(al) - Q^2;
proc minor3(matrix M, int rr, int cc) { matrix S3[3][3]; int a, bb, p, q; a = 0; for (p=1; p<=4; p++) { if (p != rr) { a++; bb = 0; for (q=1; q<=4; q++) { if (q != cc) { bb++; S3[a,bb] = M[p,q]; } } } } return(det(S3)); }
int okadj = 1; for (s=1;s<=4;s++){ for (t2=1;t2<=4;t2++){ if (reduce(minor3(al,s,t2), std(ideal(Q))) != 0) { okadj = 0; } } }
"Q divides every 3x3 minor of alpha:", okadj;
poly B05w0 = subst(B0[1,6], w, 0);
"B_05 mod w:", B05w0, " ; equals Q^3:", B05w0 == Q^3, " ; equals -Q^3:", B05w0 == -Q^3;
poly bk0; poly bk1; poly adjk1;
for (k=1;k<=4;k++) {
  bk0 = subst(B0[1,k+1], w, 0);
  bk1 = subst(diff(B0[1,k+1], w), w, 0);
  adjk1 = (-1)^(1+k) * minor3(al, 1, k);      // adj(alpha)_{k1} = cofactor (1,k) of alpha
  "B_0" + string(k) + ": mod w =", bk0, "; coefficient of w^1 =", bk1, "; Q*adj(alpha)_{" + string(k) + "1} =", Q*adjk1, "; equal:", bk1 == Q*adjk1, "; opposite:", bk1 == -Q*adjk1;
}
"B_00 + y0*adj(a)_11 =", B0[1,1] + y0*minor3(aa,1,1), "  (expected 0: B_00 = -y0*adj(a)_11 exactly)";

// ---------------- 3. counts, zeros and duplicates ----------------
intvec SLOTS = 204,72,156,56,120,42,84,30,58,20,34,12,18,6,6,2;   // from gen_n3.py (monomial slots per w-order)
intvec CNZ = 0:16; for (u=1;u<=nEQ;u++){ CNZ[EQO[u]+1] = CNZ[EQO[u]+1] + 1; }
list DE; intvec DEO; intvec DEP; list DEM; intvec DSZ; int nd = 0; int found; poly fn; int dup = 0; int m;
for (m=0; m<=15; m++) {
  for (u=1; u<=nEQ; u++) {
    if (EQO[u] == m) {
      fn = EQ[u] / leadcoef(EQ[u]);
      found = 0;
      for (t2=1; t2<=nd; t2++) { if (DSZ[t2] == size(fn)) { if (DE[t2] == fn) { found = 1; break; } } }
      if (found == 0) { nd++; DE[nd] = fn; DEO[nd] = m; DEP[nd] = EQP[u]; DEM[nd] = EQM[u]; DSZ[nd] = size(fn); }
      else { dup++; }
    }
  }
}
intvec CD = 0:16; for (u=1;u<=nd;u++){ CD[DEO[u]+1] = CD[DEO[u]+1] + 1; }
"w-order : slots / nonzero / distinct (up to scalar, kept at the lowest order)";
for (m=0;m<=15;m++){ "  " + string(m) + " : " + string(SLOTS[m+1]) + " / " + string(CNZ[m+1]) + " / " + string(CD[m+1]); }
int totslots = 0; for (m=1;m<=16;m++){ totslots = totslots + SLOTS[m]; }
"totals:", totslots, "/", nEQ, "/", nd, " (duplicates removed:", dup, ")";
"== counts done; ms:", rtimer - T0;
ideal IDR; for (u=1;u<=nd;u++){ IDR[u] = DE[u]; }

// ---------------- 4. order-by-order elimination in the ring of unknowns ----------------
ring S = 0, (lam(1..371), g(1..10), b(1..12)), dp;
ideal ID = imap(R, IDR);
int mdeg = 0; for (u=1;u<=ncols(ID);u++){ if (deg(ID[u]) > mdeg) { mdeg = deg(ID[u]); } }
"distinct equations in S:", ncols(ID), "; maximal total degree in the unknowns:", mdeg;
proc better(int v1, int v2, intvec ORD, int mode)
{
  // mode 0 (protocol): lambda before g/b, then higher w-order, then smaller index; mode 1: smaller index
  if (mode == 1) { return(v1 < v2); }
  int l1 = (v1 <= 371); int l2 = (v2 <= 371);
  if (l1 != l2) { return(l1); }
  if (ORD[v1] != ORD[v2]) { return(ORD[v1] > ORD[v2]); }
  return(v1 < v2);
}
proc bestpiv(poly f, intvec ORD, int mode)
{
  // best variable u (in the order of better) such that d f/d u is a nonzero rational constant; 0 if none
  int best = 0; int kk; int vi; poly tt; poly df;
  for (kk = 1; kk <= size(f); kk++) {
    tt = f[kk];
    if (deg(tt) == 1) {
      vi = rvar(leadmonom(tt));
      df = diff(f, var(vi));
      if (deg(df) == 0) {
        if (best == 0) { best = vi; } else { if (better(vi, best, ORD, mode)) { best = vi; } }
      }
    }
  }
  return(best);
}
proc maxord(poly f, intvec ORD)
{
  if (deg(f) <= 0) { return(-1); }
  ideal vv = variables(f); int mo = -1; int ii; int vi;
  for (ii=1; ii<=ncols(vv); ii++) { vi = rvar(vv[ii]); if (ORD[vi] > mo) { mo = ORD[vi]; } }
  return(mo);
}
proc tname(int v)
{
  if (v <= 371) { return("lam(" + string(v) + ")"); }
  if (v <= 381) { return("g(" + string(v-371) + ")"); }
  return("b(" + string(v-381) + ")");
}
list E; for (u=1;u<=nd;u++){ E[u] = ID[u]; }
intvec DEAD = 0:nd; intvec CAND = (-1):nd;
// first-occurrence stage of each unknown: the lowest w-order of an original equation containing it
intvec VIS = 99:393; ideal vvq; int iv; int vq;
for (u=1;u<=nd;u++){ vvq = variables(ID[u]); for (iv=1;iv<=ncols(vvq);iv++){ vq = rvar(vvq[iv]); if (DEO[u] < VIS[vq]) { VIS[vq] = DEO[u]; } } }
proc maxvis(poly f, intvec VIS)
{
  if (deg(f) <= 0) { return(-1); }
  ideal vv = variables(f); int mo = -1; int ii; int vi;
  for (ii=1; ii<=ncols(vv); ii++) { vi = rvar(vv[ii]); if (VIS[vi] > mo) { mo = VIS[vi]; } }
  return(mo);
}
int nnev = 0; for (u=1;u<=393;u++){ if (VIS[u] == 99) { nnev++; } } "unknowns occurring in no equation:", nnev;
intvec SMV; intvec SMO; intvec ZER = 0:17;
intvec SV; list SX; intvec SST; intvec SEQ; int nel = 0;
int cv; int vbest; int ebest; poly piv; poly expr; number cc; int ninc = 0;
int nlm; int nam; int nrem; int nobs; string sel; int mo;
int MODE = 0;
for (m=0; m<=15; m++) {
  while (1) {
    vbest = 0; ebest = 0;
    for (u=1; u<=nd; u++) {
      if (DEAD[u] == 0 && DEO[u] <= m) {
        if (CAND[u] < 0) { CAND[u] = bestpiv(E[u], ORD, MODE); }
        cv = CAND[u];
        if (cv > 0) {
          if (vbest == 0) { vbest = cv; ebest = u; }
          else {
            if (better(cv, vbest, ORD, MODE)) { vbest = cv; ebest = u; }
            else { if (cv == vbest && size(E[u]) < size(E[ebest])) { ebest = u; } }
          }
        }
      }
    }
    if (vbest == 0) { break; }
    piv = E[ebest];
    cc = leadcoef(diff(piv, var(vbest)));
    expr = var(vbest) - piv/cc;
    SMV[nel+1] = maxvis(piv, VIS); SMO[nel+1] = maxord(piv, ORD);
    "   step " + string(nel+1) + " | stage " + string(m) + " | " + tname(vbest) + " | w-order " + string(ORD[vbest]) + " | first occurrence " + string(VIS[vbest]) + " | pivot eq " + string(ebest) + " (w-order " + string(DEO[ebest]) + ", " + string(size(piv)) + " terms) | max w-order / max first occurrence of its unknowns " + string(SMO[nel+1]) + " / " + string(SMV[nel+1]);
    DEAD[ebest] = 1; E[ebest] = poly(0);
    for (u=1; u<=nd; u++) {
      if (DEAD[u] == 0) {
        if (diff(E[u], var(vbest)) != 0) {
          E[u] = subst(E[u], var(vbest), expr); CAND[u] = -1;
          if (E[u] == 0) { DEAD[u] = 1; ZER[m+1] = ZER[m+1] + 1; }
          else { if (deg(E[u]) == 0) { ninc++; "INCONSISTENT equation", u, ":", E[u]; } }
        }
      }
    }
    nel++; SV[nel] = vbest; SX[nel] = expr; SST[nel] = m; SEQ[nel] = ebest;
  }
  // ---- stage log ----
  nlm = 0; nam = 0; for (u=1;u<=393;u++){ if (ORD[u] == m) { if (u <= 371) { nlm++; } else { nam++; } } }
  "== stage", m, ": equations of w-order", m, "added:", CD[m+1], "; unknowns of w-order", m, ": lambda", nlm, ", g/b", nam;
  sel = ""; for (u=1;u<=nel;u++){ if (SST[u] == m) { sel = sel + tname(SV[u]) + "[" + string(ORD[SV[u]]) + "] "; } }
  "   eliminated at stage", m, "(name[w-order]):", sel;
  nlm = 0; nam = 0; for (u=1;u<=393;u++){ if (VIS[u] == m) { if (u <= 371) { nlm++; } else { nam++; } } }
  "   unknowns occurring for the first time in equations of w-order", m, ": lambda", nlm, ", g/b", nam;
  sel = ""; nobs = 0; for (u=1;u<=nel;u++){ if (SST[u] == m && SMV[u] < m) { nobs++; sel = sel + tname(SV[u]) + "[" + string(ORD[SV[u]]) + "] "; } }
  "   pivots at stage", m, "on equations all of whose unknowns occur already before w-order", m, "(conditions on lower-order data):", nobs, ":", sel;
  sel = ""; nobs = 0; for (u=1;u<=nel;u++){ if (SST[u] == m && SMO[u] < m) { nobs++; sel = sel + tname(SV[u]) + "[" + string(ORD[SV[u]]) + "] "; } }
  "   pivots at stage", m, "on equations involving only unknowns of w-order <", m, ":", nobs, ":", sel;
  "   equations that became identically zero during stage", m, ":", ZER[m+1];
  nrem = 0; nobs = 0;
  for (u=1;u<=nd;u++) {
    if (DEAD[u] == 0 && DEO[u] <= m) {
      nrem++; mo = maxord(E[u], ORD);
      if (mo < m) { nobs++; }
    }
  }
  "   equations remaining (w-order <= " + string(m) + "):", nrem, "; involving only unknowns of w-order <", m, "(obstructions):", nobs, "; ms:", rtimer - T0;
  if (nrem > 0 && nrem <= 12) {
    for (u=1;u<=nd;u++) { if (DEAD[u] == 0 && DEO[u] <= m) { "     eq", u, "(pair", DEP[u], ", monomial", DEM[u], ", w-order", DEO[u], ", max unknown order", maxord(E[u], ORD), ", terms", size(E[u]), ")"; if (size(E[u]) <= 40) { "      ", E[u]; } } }
  }
}
int nrem15 = 0; for (u=1;u<=nd;u++){ if (DEAD[u] == 0) { nrem15++; } }
"== order-by-order elimination finished: eliminated", nel, "unknowns; equations left:", nrem15, "; inconsistent equations met:", ninc, "; ms:", rtimer - T0;

// ---------------- 5. global re-run if needed ----------------
if (nrem15 > 0) {
  MODE = 1; "== global constant-pivot re-run (smallest index first) on the remaining equations";
  for (u=1;u<=nd;u++){ CAND[u] = -1; }
  while (1) {
    vbest = 0; ebest = 0;
    for (u=1; u<=nd; u++) {
      if (DEAD[u] == 0) {
        if (CAND[u] < 0) { CAND[u] = bestpiv(E[u], ORD, MODE); }
        cv = CAND[u];
        if (cv > 0) {
          if (vbest == 0) { vbest = cv; ebest = u; }
          else { if (better(cv, vbest, ORD, MODE)) { vbest = cv; ebest = u; } else { if (cv == vbest && size(E[u]) < size(E[ebest])) { ebest = u; } } }
        }
      }
    }
    if (vbest == 0) { break; }
    piv = E[ebest]; cc = leadcoef(diff(piv, var(vbest))); expr = var(vbest) - piv/cc;
    DEAD[ebest] = 1; E[ebest] = poly(0);
    for (u=1; u<=nd; u++) { if (DEAD[u] == 0) { if (diff(E[u], var(vbest)) != 0) { E[u] = subst(E[u], var(vbest), expr); CAND[u] = -1; if (E[u] == 0) { DEAD[u] = 1; } else { if (deg(E[u]) == 0) { ninc++; "INCONSISTENT equation", u, ":", E[u]; } } } } }
    nel++; SV[nel] = vbest; SX[nel] = expr; SST[nel] = 16; SEQ[nel] = ebest;
  }
  nrem15 = 0; for (u=1;u<=nd;u++){ if (DEAD[u] == 0) { nrem15++; } }
  "== after the global re-run: eliminated", nel, "unknowns in total; equations left:", nrem15, "; ms:", rtimer - T0;
  if (nrem15 > 0) {
    "leftover equations (factorized when small):";
    for (u=1;u<=nd;u++) { if (DEAD[u] == 0) { "  eq", u, "(pair", DEP[u], ", monomial", DEM[u], ", w-order", DEO[u], ", terms", size(E[u]), ")"; if (size(E[u]) <= 60) { factorize(E[u]); } } }
    ideal LEFT; for (u=1;u<=nd;u++) { if (DEAD[u] == 0) { LEFT = LEFT, E[u]; } } LEFT = simplify(LEFT, 2);
    write(":w n3_leftover.sing", "ideal LEFT = " + string(LEFT) + ";");
  }
}

// ---------------- 6. free unknowns, back-substitution, graph check ----------------
intvec ISEL = 0:393; for (u=1;u<=nel;u++){ ISEL[SV[u]] = u; }
int nfl = 0; int nfa = 0; string sfa = ""; string sfl = "";
for (u=1;u<=393;u++){ if (ISEL[u] == 0) { if (u <= 371) { nfl++; sfl = sfl + tname(u) + " "; } else { nfa++; sfa = sfa + tname(u) + "[" + string(ORD[u]) + "] "; } } }
"free (non-eliminated) unknowns:", nfl + nfa, "; free lambda:", nfl, "; free A-coefficients f =", nfa;
"free A-coefficients (name[w-order]):", sfa;
"free lambda:", sfl;
int nelA = 0; string sea = ""; for (u=1;u<=nel;u++){ if (SV[u] > 371) { nelA++; sea = sea + tname(SV[u]) + "[stage " + string(SST[u]) + "] "; } }
"eliminated A-coefficients:", nelA, ":", sea;
if (nrem15 == 0) {
  ideal FIN = maxideal(1);
  int st;
  poly tmpx; for (st = nel; st >= 1; st--) { map phi = S, FIN; tmpx = SX[st]; FIN[SV[st]] = phi(tmpx); kill phi; }
  "== back-substitution done; ms:", rtimer - T0;
  intvec WL = 1:371, 0:22;
  int graphok = 1;
  "eliminated g, b as polynomials in the free unknowns:";
  for (u=372;u<=393;u++) {
    if (ISEL[u] > 0) {
      if (deg(FIN[u], WL) > 0) { graphok = 0; }
      "  " + tname(u) + " = " + string(FIN[u]);
    }
  }
  "graph check (no free lambda occurs in the eliminated g, b):", graphok;
  // exact check: the parametrization FIN satisfies every original (distinct) equation
  map PHI = S, FIN; int nbad = 0;
  poly tmpe; for (u=1;u<=nd;u++) { tmpe = ID[u]; if (PHI(tmpe) != 0) { nbad++; } }
  "exact substitution check: original equations not vanishing identically on the parametrization:", nbad, "of", nd, "; ms:", rtimer - T0;
  // sizes of the expressions
  int maxsz = 0; for (u=1;u<=393;u++){ if (size(FIN[u]) > maxsz) { maxsz = size(FIN[u]); } } "largest final expression (terms):", maxsz;
  // files: final expressions (Singular code) and the raw elimination record
  write(":w n3_final.sing", "// generated by n3_elim.sing: FIN[v] = expression of unknown v in the free unknowns (ring S); free unknowns: FIN[v] = var(v)");
  for (u=1;u<=393;u++) { if (ISEL[u] > 0) { write(":a n3_final.sing", "FIN[" + string(u) + "] = " + string(FIN[u]) + ";"); } }
  write(":w n3_subs.txt", "// generated by n3_elim.sing: elimination record, one line per step: step | stage | unknown | pivot equation index | unknown = expression (at the time of the step)");
  for (u=1;u<=nel;u++) { write(":a n3_subs.txt", string(u) + " | " + string(SST[u]) + " | " + tname(SV[u]) + " | " + string(SEQ[u]) + " | " + tname(SV[u]) + " = " + string(SX[u])); }
  intvec FREEV; int nf2 = 0; for (u=1;u<=393;u++){ if (ISEL[u] == 0) { nf2++; FREEV[nf2] = u; } }
  write(":w n3_free.txt", "intvec FREEV = " + string(FREEV) + ";");
}
"== done; ms:", rtimer - T0, "; memory (KB, allocated):", memory(1) div 1024, "; max:", memory(2) div 1024;
quit;
