// n1c1, script C: back-substitution, graph check, verification of the parametrized family, syzygy rank
system("--ticks-per-sec", 1000); int T0 = rtimer;
< "common_n1c1.sing";
list SV; list SE; intvec SSTG; intvec SEO; list SPIV; int NS;
execute(read("subs_n1c1.txt"));
intvec FREEV; execute(read("free_n1c1.txt"));
"substitutions read:", NS, " free unknowns read:", size(FREEV);
int i, j, k, u, ok, n;
intvec isfree = 0:394; for (k=1;k<=size(FREEV);k++){ isfree[FREEV[k]] = 1; }
// back-substitution in reverse elimination order: IMG[u] = expression of u in the free unknowns
ideal IMG = maxideal(1);
for (k = NS; k >= 1; k--) { map phi = R0, IMG; poly e = SE[k]; IMG[SV[k]] = phi(e); kill phi, e; }
"back-substitution done, ms:", rtimer-T0;
// sanity: every image involves only free unknowns (and no w, y)
int bad = 0; int maxsz = 0; int totsz = 0;
for (k = 1; k <= NS; k++) { u = SV[k]; poly e = IMG[u]; if (deg(e) > 0) { ideal vv = variables(e); for (j=1;j<=ncols(vv);j++){ n = rvar(vv[j]); if (n > 394) { bad++; } else { if (isfree[n] == 0) { bad++; } } } kill vv; } if (size(e) > maxsz) { maxsz = size(e); } totsz = totsz + size(e); kill e; }
"images involving a non-free unknown or a coordinate:", bad, " ; image sizes: total", totsz, " max", maxsz;
// graph check: eliminated g, b as polynomials in the free unknowns; no free lambda may occur
int nlam = 0;
write(":w graph_expr_n1c1.txt", "// eliminated g, b of case n1c1 as polynomials in the free A-coefficients D, g(5), b(2), b(5), b(6), b(8), b(9), b(11), b(12) (written by n1c1_C_graph.sing)");
for (u = 372; u <= 393; u++) { if (isfree[u] == 0) { poly e = IMG[u]; int hasl = 0; if (deg(e) > 0) { ideal vv = variables(e); for (j=1;j<=ncols(vv);j++){ if (rvar(vv[j]) <= 371) { hasl = 1; } } kill vv; } nlam = nlam + hasl; string(var(u)), "=", e, "   [terms:", size(e), ", contains a lambda:", hasl, "]"; write(":a graph_expr_n1c1.txt", string(var(u)) + " = " + string(e) + ";"); kill e, hasl; } }
"graph check: eliminated g, b whose expression contains a lambda-coefficient:", nlam;
// verification: substitute the parametrization into A and the lambda_{ij,k} and recompute E_ij exactly
map PHI = R0, IMG;
matrix AP = PHI(A);
matrix BP[1][6]; for (k=1;k<=6;k++){ BP[1,k] = cofac(AP,k,1); }
poly pol; int nz = 0;
pol = cofac(AP,2,2) - (PHI(lam_1_1_0)*BP[1,1] + PHI(lam_1_1_1)*BP[1,2] + PHI(lam_1_1_2)*BP[1,3] + PHI(lam_1_1_3)*BP[1,4] + PHI(lam_1_1_4)*BP[1,5] + PHI(lam_1_1_5)*BP[1,6]); if (pol != 0) { nz++; "E_11 nonzero, terms:", size(pol); }
pol = cofac(AP,3,2) - (PHI(lam_1_2_0)*BP[1,1] + PHI(lam_1_2_1)*BP[1,2] + PHI(lam_1_2_2)*BP[1,3] + PHI(lam_1_2_3)*BP[1,4] + PHI(lam_1_2_4)*BP[1,5] + PHI(lam_1_2_5)*BP[1,6]); if (pol != 0) { nz++; "E_12 nonzero, terms:", size(pol); }
