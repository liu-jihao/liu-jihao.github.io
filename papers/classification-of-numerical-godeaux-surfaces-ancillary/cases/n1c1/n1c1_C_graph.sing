pol = cofac(AP,6,6) - (PHI(lam_5_5_0)*BP[1,1] + PHI(lam_5_5_1)*BP[1,2] + PHI(lam_5_5_2)*BP[1,3] + PHI(lam_5_5_3)*BP[1,4] + PHI(lam_5_5_4)*BP[1,5] + PHI(lam_5_5_5)*BP[1,6]); if (pol != 0) { nz++; "E_55 nonzero, terms:", size(pol); }
"verification of the rank conditions E_ij = 0 (15 pairs) for the parametrized family: nonzero E_ij:", nz, " ms:", rtimer-T0;
// exact syzygy-rank check at a random rational point of V (free A-coefficients below; lambda irrelevant)
"random point (free A-coefficients):", "g(5)=-4, b(2)=-8, b(5)=6, b(6)=-5, b(8)=4, b(9)=2, b(11)=-4, b(12)=-9, D=5";
matrix AQ[6][6]; for (i=1;i<=6;i++){ for (j=1;j<=6;j++){ AQ[i,j] = subst(AP[i,j], g(5), -4, b(2), -8, b(5), 6, b(6), -5, b(8), 4, b(9), 2, b(11), -4, b(12), -9, D, 5); } }
"A at the point:"; print(AQ);
ring RS = 0, (w, y1, y2, y3, e(1..6)), dp;
matrix AQ = imap(R0, AQ); int i, j, k, rk, rtot, okc; rtot = 0; okc = 1;
