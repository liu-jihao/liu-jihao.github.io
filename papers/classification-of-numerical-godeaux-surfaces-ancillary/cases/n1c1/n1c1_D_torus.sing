ideal WGR = mgr(WF); ideal WUU = muu(WF);
int ngr = 0; for (k=1;k<=394;k++){ if (WGR[k] != 0) { ngr++; } } "coefficients with nonzero weight under the grading direction:", ngr;
intvec WTU; for (k=1;k<=394;k++){ WTU[k] = int(leadcoef(WUU[k])); if (WUU[k] == 0) { WTU[k] = 0; } }
ring R1 = 0, (l(1..371), g(1..10), b(1..12), D), dp;
short = 0;
int k, j, n;
intvec FREEV; execute(read("free_n1c1.txt"));
string s = ""; for (k=372;k<=394;k++){ s = s + string(var(k)) + ":" + string(WTU[k]) + " "; } "u-weights (t-normalization, t^2 = u) of D, g, b:", s;
s = ""; for (k=1;k<=size(FREEV);k++){ if (FREEV[k] > 371) { s = s + string(var(FREEV[k])) + ":" + string(WTU[FREEV[k]]) + " "; } } "u-weights of the free A-coefficients:", s;
int nzl = 0; for (k=1;k<=size(FREEV);k++){ if (FREEV[k] <= 371 && WTU[FREEV[k]] != 0) { nzl++; } } "free lambda with nonzero u-weight:", nzl, "of 94";
s = ""; for (k=1;k<=371;k++){ s = s + string(WTU[k]) + " "; } "u-weights of l(1..371):", s;
// effective dimension e: rank of the weight matrix (rows gr, u) on the free A-coefficients, and on all free coordinates
int nfa = 0; for (k=1;k<=size(FREEV);k++){ if (FREEV[k] > 371) { nfa++; } }
matrix WMA[2][nfa]; n = 0; for (k=1;k<=size(FREEV);k++){ if (FREEV[k] > 371) { n++; WMA[1,n] = 0; WMA[2,n] = WTU[FREEV[k]]; } }
matrix WMF[2][size(FREEV)]; for (k=1;k<=size(FREEV);k++){ WMF[1,k] = 0; WMF[2,k] = WTU[FREEV[k]]; }
"e = rank of the weight matrix on the free A-coefficients:", rank(WMA), " ; on all 103 free coordinates:", rank(WMF);
// verification 1: the u-element maps the normal form to itself, with the predicted weights of D, g, b
ring RT = (0,t), (l(1..371), g(1..10), b(1..12), D, w, y1, y2, y3), dp;
short = 0; int k, j;
< "common_n1c1_A.sing";
matrix PP[6][6]; PP[1,1] = 1/t^2; PP[2,2] = 1/t; PP[3,3] = t; PP[4,4] = t; PP[5,5] = 1/t; PP[6,6] = t^2;
ideal SG = maxideal(1); SG[395] = w/t; SG[398] = y3/t^2; map sgm = RT, SG;
matrix AS = sgm(A); matrix AT = transpose(PP)*AS*PP;
ideal SC = maxideal(1); for (k=1;k<=394;k++){ if (WTU[k] >= 0) { SC[k] = t^WTU[k]*var(k); } else { SC[k] = var(k)/t^(-WTU[k]); } } map scl = RT, SC;
matrix AW = scl(A);
int okm = 1; for (k=1;k<=6;k++){ for (j=1;j<=6;j++){ if (AT[k,j] != AW[k,j]) { okm = 0; } } }
"P^t A(w/t, y1, y2, y3/t^2) P equals A with D, g, b scaled by t^weight:", okm;
"for comparison, the fixed entries after the change (row v1, row v4, A05):", AT[2,2], AT[5,5], AT[1,6];
// verification 2: every coefficient equation is homogeneous for these weights (so the scaling maps solutions to solutions)
ideal EQ; intvec EO; execute(read("eqs_n1c1.txt"));
int nh = 0; poly fs, f0;
for (k=1;k<=ncols(EQ);k++){ f0 = EQ[k]; fs = scl(f0); if (fs*leadcoef(f0) - leadcoef(fs)*f0 != 0) { nh++; } }
"coefficient equations (of", ncols(EQ), ") that are not weighted-homogeneous for the u-weights:", nh;
"total ms:", rtimer-T0, " memory KB:", memory(2) div 1024;
quit;
