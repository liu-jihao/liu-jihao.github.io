// n1c1, script D: residual torus of the normal form N1(D), c = 1
system("--ticks-per-sec", 1000); int T0 = rtimer;
ring RW = 0, (W, Y1, Y2, Y3, P0, P1, P2, P3, P4, P5, dD), dp;
ideal CND = P0 + P5 + 2*Y2, P0 + P5 + 2*Y1, P0 + P5 + 2*Y3 - dD, P1 + P5 + W, 2*P1 + Y3 - dD, P1 + P2 + Y2, P1 + P3 + Y1, 2*P2 + Y3, P2 + P3 + 2*W, P2 + P4 + Y1, 2*P3 + Y3, P3 + P4 + Y2, 2*P4 + Y3 - dD;
"conditions (fixed entries):", 13;
ideal SCND = std(CND); "dimension of the solution space (torus dimension, D allowed to move):", dim(SCND);
"reduced linear conditions:"; SCND;
// candidate basis: grading direction gr and the one-parameter group u (t^2 = u)
ideal GR = 1, 2, 2, 2, -4, -1, -1, -1, -1, 0, 0;   // W, Y1, Y2, Y3, P0..P5 = c_j - 4, dD
ideal UU = -1, 0, 0, -2, -2, -1, 1, 1, -1, 2, -4;  // w -> w/t, y3 -> y3/t^2, P = diag(t^-2, t^-1, t, t, t^-1, t^2), D -> D/t^4
map mgr = RW, GR; map muu = RW, UU;
"grading direction satisfies all conditions:", size(mgr(CND)) == 0, " ; u satisfies all conditions:", size(muu(CND)) == 0;
matrix BM[2][11]; int k; for (k=1;k<=11;k++){ BM[1,k] = GR[k]; BM[2,k] = UU[k]; } "rank of (gr, u):", rank(BM);
