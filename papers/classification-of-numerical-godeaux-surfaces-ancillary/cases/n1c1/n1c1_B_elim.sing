// n1c1, script B: order-by-order constant-pivot elimination (plan/case_common.md section 3(b)).
// Input: eqs_n1c1.txt (782 distinct coefficient equations with their w-orders, from n1c1_A_eqs.sing).
// Rule: at stage m the equations of w-order m are added; repeatedly an equation f and an unknown u
// with df/du a nonzero rational constant are chosen (priority: lambda before g,b; then higher w-order;
// then the shorter equation; then the smaller variable index); u := u - f/(df/du) is substituted in all
// current and all later equations.  D is never used as a pivot (it stays a free parameter).
system("--ticks-per-sec", 1000); int T0 = rtimer;
ring R1 = 0, (l(1..371), g(1..10), b(1..12), D), dp;
short = 0;
< "meta_n1c1.sing";
ideal EQ; intvec EO;
execute(read("eqs_n1c1.txt"));
int NE = ncols(EQ); int NV = 394;
"equations read:", NE, " size of EO:", size(EO);
list EL; int i; for (i = 1; i <= NE; i++) { EL[i] = EQ[i]; }
kill EQ;

proc candof(poly f)
{
  // best variable u (D excluded) such that df/du is a nonzero rational constant; key = 100*[u is lambda] + ord(u)
  int bv = 0; int bk = -1; int kk, vi, key;
  poly f1 = jet(f, 1);
  poly LL = f1 - jet(f, 0);
  if (LL == 0) { return(list(0, -1)); }
  intvec mask = 0:394;
  poly NN = f - f1;
  if (NN != 0) { ideal vv = variables(NN); for (kk = 1; kk <= ncols(vv); kk++) { mask[rvar(vv[kk])] = 1; } }
  for (kk = 1; kk <= size(LL); kk++) {
    vi = rvar(leadmonom(LL[kk]));
    if (TYP[vi] != 4 && mask[vi] == 0) {
      key = (TYP[vi] == 1) * 100 + ORD[vi];
      if (key > bk || (key == bk && vi < bv)) { bk = key; bv = vi; }
    }
  }
  return(list(bv, bk));
}
proc maxord(poly f)
{
  // largest w-order of an unknown occurring in f (-1 if f is constant)
  if (deg(f) <= 0) { return(-1); }
  ideal vv = variables(f); int mo = -1; int kk;
  for (kk = 1; kk <= ncols(vv); kk++) { if (ORD[rvar(vv[kk])] > mo) { mo = ORD[rvar(vv[kk])]; } }
  return(mo);
}
proc tname(int vi)
{
  if (TYP[vi] == 1) { return("lambda(k=" + string(LK[vi]) + ")"); }
  if (TYP[vi] == 2) { return("g"); }
  if (TYP[vi] == 3) { return("b"); }
  return("D");
}

write(":w stage_left_n1c1.txt", "// equations remaining at the end of each stage (n1c1_B_elim.sing), with factorizations");
intvec alive = 0:NE; intvec cv = 0:NE; intvec ck = 0:NE; intvec cs = 0:NE; intvec dirty = 0:NE;
intvec elimv = 0:NV;
list SV; list SE; intvec SSTG; intvec SEO; list SPIV;
int NS = 0;
int m, u, best, k, nadd, nadd0, nel, nrem, nobs, mo, tst, j;
poly f, expr, dfu;
list st;
intvec wu;
string sline;
for (m = 0; m <= 15; m++) {
  tst = rtimer;
  nadd = 0; nadd0 = 0;
  for (i = 1; i <= NE; i++) { if (EO[i] == m) { if (EL[i] != 0) { alive[i] = 1; dirty[i] = 1; nadd++; } else { nadd0++; } } }
  "";
  "=== stage", m, "===";
  "equations of w-order", m, "added:", nadd, " (already reduced to 0 by earlier substitutions:", nadd0, ")";
  // unknowns of order m by type
  int nl5 = 0; int nlk = 0; int nl0 = 0; int ng = 0; int nb = 0;
  for (k = 1; k <= NV; k++) { if (ORD[k] == m) { if (TYP[k] == 1) { if (LK[k] == 5) { nl5++; } else { if (LK[k] == 0) { nl0++; } else { nlk++; } } } if (TYP[k] == 2) { ng++; } if (TYP[k] == 3) { nb++; } } }
  "unknowns of w-order", m, ": lambda_{.,5}:", nl5, " lambda_{.,1..4}:", nlk, " lambda_{.,0}:", nl0, " g:", ng, " b:", nb; if (m == 0) { "  (and the parameter D, order 0, never a pivot)"; }
  kill nl5, nlk, nl0, ng, nb;
  nel = 0;
  list elimlog;
  while (1) {
    for (i = 1; i <= NE; i++) { if (alive[i] && dirty[i]) { st = candof(EL[i]); cv[i] = st[1]; ck[i] = st[2]; cs[i] = size(EL[i]); dirty[i] = 0; } }
    best = 0;
    for (i = 1; i <= NE; i++) {
      if (alive[i] && cv[i] > 0) {
        if (best == 0) { best = i; }
        else { if (ck[i] > ck[best] || (ck[i] == ck[best] && (cs[i] < cs[best] || (cs[i] == cs[best] && cv[i] < cv[best])))) { best = i; } }
      }
    }
    if (best == 0) { break; }
    u = cv[best]; f = EL[best];
    dfu = diff(f, var(u));
    if (deg(dfu) != 0) { "ERROR: non-constant pivot", u; quit; }
    expr = var(u) - f / dfu;
    NS++; SV[NS] = u; SE[NS] = expr; SSTG[NS] = m; SEO[NS] = EO[best]; SPIV[NS] = dfu; elimv[u] = NS;
    alive[best] = 0; EL[best] = 0; nel++;
    elimlog[nel] = string(var(u)) + "[" + tname(u) + ",o" + string(ORD[u]) + ",eq-o" + string(EO[best]) + ",t" + string(size(expr)) + "]";
    wu = 0:NV; wu[u] = 1;
    for (i = 1; i <= NE; i++) { if (EL[i] != 0) { if (deg(EL[i], wu) > 0) { EL[i] = subst(EL[i], var(u), expr); dirty[i] = 1; if (EL[i] == 0) { alive[i] = 0; } } } }
  }
  // stage summary
  "unknowns eliminated at stage", m, ":", nel;
  // counts by (type, order)
  intvec cnt = 0:(5*16);   // index (type-1)*16 + order + 1 ; type 1 = lambda_{.,5}, 2 = lambda_{.,1..4}, 3 = lambda_{.,0}, 4 = g, 5 = b
  for (k = NS - nel + 1; k <= NS; k++) {
    u = SV[k]; j = 0;
    if (TYP[u] == 1) { if (LK[u] == 5) { j = 1; } else { if (LK[u] == 0) { j = 3; } else { j = 2; } } }
    if (TYP[u] == 2) { j = 4; } if (TYP[u] == 3) { j = 5; }
    cnt[(j-1)*16 + ORD[u] + 1] = cnt[(j-1)*16 + ORD[u] + 1] + 1;
  }
  list tnm = "lambda_{.,5}", "lambda_{.,1..4}", "lambda_{.,0}", "g", "b";
  for (j = 1; j <= 5; j++) { sline = ""; for (k = 0; k <= 15; k++) { if (cnt[(j-1)*16 + k + 1] > 0) { sline = sline + " order " + string(k) + ": " + string(cnt[(j-1)*16 + k + 1]) + ";"; } } if (sline != "") { "  eliminated", tnm[j], ":", sline; } }
  sline = ""; for (k = 1; k <= nel; k++) { sline = sline + " " + elimlog[k]; }
  "  log:", sline;
  kill cnt, tnm, elimlog;
  nrem = 0; nobs = 0;
  for (i = 1; i <= NE; i++) { if (alive[i]) { nrem++; mo = maxord(EL[i]); if (mo < m) { nobs++; } } }
  "equations remaining at the end of stage", m, ":", nrem, " ; of these involving only unknowns of order <", m, ":", nobs;
  // dump the remaining equations of this stage with their factorizations
  int nfac1 = 0; string svl = "";
  intvec seen = 0:NV;
  for (i = 1; i <= NE; i++) { if (alive[i]) {
    list fl = factorize(EL[i]); int nfct = 0; for (j = 1; j <= ncols(fl[1]); j++) { if (deg(fl[1][j]) > 0) { nfct = nfct + fl[2][j]; } }
    if (nfct > 1) { nfac1++; }
    sline = "stage " + string(m) + " | eq " + string(i) + " | w-order " + string(EO[i]) + " | max unknown order " + string(maxord(EL[i])) + " | terms " + string(size(EL[i])) + " | factors:";
    for (j = 1; j <= ncols(fl[1]); j++) { if (deg(fl[1][j]) > 0) { sline = sline + " (" + string(fl[1][j]) + ")^" + string(fl[2][j]); } else { sline = sline + " [const " + string(fl[1][j]) + "]"; } }
    write(":a stage_left_n1c1.txt", sline);
    ideal vv = variables(EL[i]); for (j = 1; j <= ncols(vv); j++) { if (TYP[rvar(vv[j])] == 1 && seen[rvar(vv[j])] == 0) { seen[rvar(vv[j])] = 1; svl = svl + string(vv[j]) + "(k=" + string(LK[rvar(vv[j])]) + ",o" + string(ORD[rvar(vv[j])]) + ") "; } }
    kill fl, nfct, vv; } }
  if (nrem > 0) { "  remaining equations that factor nontrivially:", nfac1, "of", nrem, " ; lambda-coefficients occurring in them:", svl; }
  kill nfac1, svl, seen;
  if (nrem > 0 && nrem <= 12) { for (i = 1; i <= NE; i++) { if (alive[i]) { "   eq", i, "(w-order", EO[i], ", terms", size(EL[i]), ", max unknown order", maxord(EL[i]), ")"; if (size(EL[i]) <= 40) { "     ", EL[i]; } } } }
  "stage", m, "time ms:", rtimer - tst, " total ms:", rtimer - T0, " memory KB:", memory(2) div 1024;
}
"";
"=== result of the order-by-order elimination ===";
"substitutions:", NS;
int nfree = 0; int nfl = 0; string sfa = ""; string sfl = "";
for (k = 1; k <= NV; k++) { if (elimv[k] == 0) { nfree++; if (TYP[k] == 1) { nfl++; sfl = sfl + string(var(k)) + " "; } else { sfa = sfa + string(var(k)) + " "; } } }
"free unknowns:", nfree, " ; free lambda:", nfl, " ; free A-coefficients:", nfree - nfl;
"free A-coefficients (D, g, b):", sfa;
"free lambda:", sfl;
int nl = 0; int ngg = 0; int nbb = 0; string sea = "";
for (k = 1; k <= NS; k++) { u = SV[k]; if (TYP[u] == 1) { nl++; } if (TYP[u] == 2) { ngg++; sea = sea + string(var(u)) + " "; } if (TYP[u] == 3) { nbb++; sea = sea + string(var(u)) + " "; } }
"eliminated: lambda", nl, " g", ngg, " b", nbb, " ; eliminated g,b:", sea;
nrem = 0; for (i = 1; i <= NE; i++) { if (alive[i]) { nrem++; } }
int nnz = 0; for (i = 1; i <= NE; i++) { if (EL[i] != 0) { nnz++; } }
"leftover equations:", nrem, " (nonzero entries in the whole list:", nnz, ")";
if (nrem > 0) { for (i = 1; i <= NE; i++) { if (alive[i]) { "eq", i, "w-order", EO[i], "terms", size(EL[i]); if (size(EL[i]) <= 80) { factorize(EL[i]); } } } }
// save
write(":w subs_n1c1.txt", "NS=" + string(NS) + ";");
for (k = 1; k <= NS; k++) { write(":a subs_n1c1.txt", "SV[" + string(k) + "]=" + string(SV[k]) + "; SSTG[" + string(k) + "]=" + string(SSTG[k]) + "; SEO[" + string(k) + "]=" + string(SEO[k]) + "; SPIV[" + string(k) + "]=" + string(SPIV[k]) + "; SE[" + string(k) + "]=" + string(SE[k]) + ";"); }
write(":w free_n1c1.txt", "intvec FREEV = " + string(0) + ";");
int nf2 = 0; for (k = 1; k <= NV; k++) { if (elimv[k] == 0) { nf2++; write(":a free_n1c1.txt", "FREEV[" + string(nf2) + "]=" + string(k) + ";"); } }
write(":w left_n1c1.txt", "// leftover equations after stage 15");
for (i = 1; i <= NE; i++) { if (alive[i]) { write(":a left_n1c1.txt", "LEFT[" + string(i) + "]=" + string(EL[i]) + ";"); } }
"saved subs_n1c1.txt, free_n1c1.txt, left_n1c1.txt";
int maxt = 0; int sumt = 0; for (k = 1; k <= NS; k++) { sumt = sumt + size(SE[k]); if (size(SE[k]) > maxt) { maxt = size(SE[k]); } }
"expression sizes (terms): total", sumt, " max", maxt;
string spv = ""; int npc = 0; for (k = 1; k <= NS; k++) { if (deg(SPIV[k]) != 0) { npc++; } spv = spv + string(SPIV[k]) + " "; }
"pivot coefficients that are not nonzero rational constants:", npc;
"pivot coefficients (in elimination order):", spv;
"total ms:", rtimer - T0, " memory KB:", memory(2) div 1024;
quit;
